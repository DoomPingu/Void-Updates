
        version += 1

        speicher_daten[
            "version"
        ] = version

        speicher_daten[
            "spieler"
        ] = spieler_daten

    return speicher_daten

def spiel_speichern(spieler):
    speicher_daten = {
        "version": SAVE_VERSION,
        "spieler": spieler
    }

    erfolgreich, fehler = (
        speicherdatei_sicher_schreiben(
            speicher_daten
        )
    )

    if not erfolgreich:
        print()
        print(
            "Speichern fehlgeschlagen."
        )

        print(
            f"Fehler: {fehler}"
        )

        return False

    print()

    design_text(
        "SPIEL GESPEICHERT",
        design="positiv",
        art="menue"
    )

    return True

def speicherplatz_text(slot):
    speicher_datei = (
        speicherdatei_pfad(slot)
    )

    if not os.path.exists(
        speicher_datei
    ):
        return (
            f"{slot}. Leer"
        )

    try:
        with open(
            speicher_datei,
            "r",
            encoding="utf-8"
        ) as datei:
            speicher_daten = json.load(
                datei
            )

        if not isinstance(
            speicher_daten,
            dict
        ):
            raise ValueError

        spieler_daten = (
            speicher_daten.get(
                "spieler"
            )
        )

        if not isinstance(
            spieler_daten,
            dict
        ):
            raise ValueError

        name = (
            spieler_daten.get(
                "name"
            )
            or "Unbekannt"
        )

        ort = (
            spieler_daten.get(
                "ort"
            )
            or "Unbekannter Ort"
        )

        return (
            f"{slot}. "
            f"{name} - {ort}"
        )

    except (
        OSError,
        json.JSONDecodeError,
        ValueError
    ):
        return (
            f"{slot}. "
            "[Beschädigter Spielstand]"
        )

def spiel_laden(slot=None):
    global AKTIVER_SPEICHER_SLOT

    if slot is None:
        slot = AKTIVER_SPEICHER_SLOT

    if slot is None:
        print()
        print(
            "Kein Speicherplatz ausgewählt."
        )

        warte_auf_taste()
        return None

    if slot not in range(
        1,
        ANZAHL_SPEICHER_SLOTS + 1
    ):
        print()
        print(
            "Ungültiger Speicherplatz."
        )

        warte_auf_taste()
        return None

    speicher_datei = (
        speicherdatei_pfad(slot)
    )

    if not os.path.exists(
        speicher_datei
    ):
        print()
        print(
            "Es gibt noch keinen Spielstand."
        )

        warte_auf_taste()

        return None

    try:
        with open(
            speicher_datei,
            "r",
            encoding="utf-8"
        ) as datei:
            speicher_daten = json.load(
                datei
            )

        if not isinstance(
            speicher_daten,
            dict
        ):
            raise ValueError(
                "Ungültiger Spielstand"
            )

        if "spieler" not in speicher_daten:
            raise ValueError(
                "Spielerdaten fehlen"
            )

        geladener_spieler = (
            speicher_daten[
                "spieler"
            ]
        )

        if not isinstance(
            geladener_spieler,
            dict
        ):
            raise ValueError(
                "Ungültige Spielerdaten"
            )

        save_version = (
            speicher_daten.get(
                "version",
                1
            )
        )

        if (
            isinstance(
                save_version,
                bool
            )
            or not isinstance(
                save_version,
                int
            )
        ):
            raise ValueError(
                "Ungültige Spielstand-Version"
            )

    except (
        OSError,
        json.JSONDecodeError,
        ValueError
    ) as fehler:
        print()

        print(
            "Der Spielstand konnte "
            "nicht geladen werden."
        )

        print(
            f"Fehler: {fehler}"
        )

        warte_auf_taste()

        return None

    # -------------------------
    # SAVE AUS DER ZUKUNFT
    # -------------------------

    if save_version > SAVE_VERSION:
        print()

        design_text(
            "SPIELSTAND NICHT KOMPATIBEL",
            design="warnung",
            art="menue"
        )

        print()

        print(
            "Dieser Spielstand verwendet ein "
            "neueres Speicherformat."
        )

        print()

        print(
            f"Spielstand-Version: "
            f"{save_version}"
        )

        print(
            f"Unterstützte Version: "
            f"{SAVE_VERSION}"
        )

        print()

        print(
            "Der Spielstand wurde nicht verändert."
        )

        warte_auf_taste(
            "Zurück"
        )

        return None

    # -------------------------
    # SAVE ZU ALT
    # -------------------------

    if save_version < MIN_SAVE_VERSION:
        print()

        design_text(
            "ALTER SPIELSTAND",
            design="warnung",
            art="menue"
        )

        print()

        print(
            "Dieser Spielstand ist zu alt, "
            "um automatisch aktualisiert zu werden."
        )

        print()

        print(
            f"Spielstand-Version: "
            f"{save_version}"
        )

        print(
            f"Mindestens benötigt: "
            f"{MIN_SAVE_VERSION}"
        )

        print()

        print(
            "Der Spielstand wurde nicht verändert."
        )

        warte_auf_taste(
            "Zurück"
        )

        return None

    migration_von = None
    backup_datei = None

    # -------------------------
    # ALTER SAVE → MIGRATION
    # -------------------------

    if save_version < SAVE_VERSION:

        backup_datei, backup_fehler = (
        spielstand_backup_erstellen(
                        save_version,
                        slot=slot
                    )
        )

        if backup_datei is None:
            print()

            design_text(
                "SPIELSTAND NICHT AKTUALISIERT",
                design="warnung",
                art="menue"
            )

            print()

            print(
                "Vor der Aktualisierung konnte "
                "kein Backup erstellt werden."
            )

            print()

            print(
                f"Fehler: {backup_fehler}"
            )

            print()

            print(
                "Der ursprüngliche Spielstand "
                "wurde nicht verändert."
            )

            warte_auf_taste(
                "Zurück"
            )

            return None

        migration_von = save_version

        try:
            speicher_daten = (
                spielstand_migrieren(
                    speicher_daten
                )
            )

        except ValueError as fehler:
            print()

            design_text(
                "MIGRATION FEHLGESCHLAGEN",
                design="warnung",
                art="menue"
            )

            print()

            print(
                f"Fehler: {fehler}"
            )

            print()

            print(
                "Das Backup des alten "
                "Spielstands bleibt erhalten."
            )

            warte_auf_taste(
                "Zurück"
            )

            return None

        erfolgreich, fehler = (
        speicherdatei_sicher_schreiben(
                        speicher_daten,
                        slot=slot
                    )
        )

        if not erfolgreich:
            print()

            design_text(
                "MIGRATION NICHT GESPEICHERT",
                design="warnung",
                art="menue"
            )

            print()

            print(
                f"Fehler: {fehler}"
            )

            print()

            print(
                "Das Backup des alten "
                "Spielstands bleibt erhalten."
            )

            warte_auf_taste(
                "Zurück"
            )

            return None

        geladener_spieler = (
            speicher_daten[
                "spieler"
            ]
        )

    geladener_spieler["spiel_laeuft"] = True
    attribut_system_sicherstellen(
        geladener_spieler
    )
    geladener_spieler.setdefault("textgeschwindigkeit", "normal")
    geladener_spieler.setdefault("menue_eingabe", "enter")
    geladener_spieler.setdefault("bildschirm_leeren", True)
    geladener_spieler.setdefault("ort_nachricht", None)
    geladener_spieler.setdefault("reise", None)
    if geladener_spieler.get(
        "ort"
    ) == "reise":
        alte_reise = geladener_spieler.get(
            "reise"
        )

        if isinstance(
            alte_reise,
            dict
        ):
            geladener_spieler["ort"] = (
                alte_reise.get(
                    "gebiet",
                    "Eichenruh"
                )
            )

        else:
            geladener_spieler[
                "ort"
            ] = "Eichenruh"
    geladener_spieler.setdefault("besuchte_orte",[])
    geladener_spieler.setdefault("dialog_themen", {})
    geladener_spieler.setdefault(
        "quest_ein_name_fehlt",
        "nicht_entdeckt"
    )

    geladener_spieler.setdefault(
        "quest_wiegenlied",
        "nicht_entdeckt"
    )

    if "koehler_nachricht_bjorn" not in geladener_spieler:
        if geladener_spieler.get(
            "prolog_status"
        ) == "prolog_abgeschlossen":
            geladener_spieler[
                "koehler_nachricht_bjorn"
            ] = "offen"
        else:
            geladener_spieler[
                "koehler_nachricht_bjorn"
            ] = "nicht_erhalten"

    geladener_spieler.setdefault("inventar_items", {})
    geladener_spieler.setdefault(
        "rezepte_gelernt",
        []
    )   
    geladener_spieler.setdefault(
        "ressourcen_vorkommen",
        {}
    )
    geladener_spieler.setdefault(
        "erfolge_freigeschaltet",
        []
    )

    geladener_spieler.setdefault(
        "rueckkehr_hinweise",
        {}
    )
    
    geladener_spieler.setdefault(
        "reisender_status",
        "nicht_getroffen"
    )
    geladener_spieler.setdefault(
        "wege_status",
        {}
    )

    geladener_spieler.setdefault(
        "neue_wege",
        []
    )

    geladener_spieler[
        "wege_status"
    ].pop(
        "ueberwucherter_weg",
        None
    )

    while (
        "ueberwucherter_weg"
        in geladener_spieler["neue_wege"]
    ):
        geladener_spieler[
            "neue_wege"
        ].remove(
            "ueberwucherter_weg"
        )

    geladener_spieler.setdefault(
        "routenkenntnis",
        []
    )

    geladener_spieler.setdefault(
        "status_effekte",
        {}
    )

    geladener_spieler.setdefault(
        "wald_wegstein_untersucht",
        False
    )

    geladener_spieler.setdefault(
        "wald_fragment_gefunden",
        False
    )

    geladener_spieler.setdefault(
        "textverlauf",
        []
    )

    wald_erforschung = geladener_spieler.setdefault(
        "wald_erforschung",
        {}
    )

    wald_erforschung.setdefault(
        "aktueller_knoten",
        None
    )

    wald_erforschung.setdefault(
        "besuchte_knoten",
        []
    )

    wald_erforschung.setdefault(
        "abkuerzungen",
        []
    )

    wald_funde = wald_erforschung.setdefault(
        "funde",
        {}
    )

    besondere_funde = geladener_spieler.setdefault(
        "besondere_funde",
        {}
    )

    # Alte Spielstände in das neue Fundjournal übernehmen
    if geladener_spieler.get(
        "wald_fragment_gefunden",
        False
    ):
        besondere_funde.setdefault(
            "unbekanntes_fragment",
            "gefunden"
        )

    if wald_funde.get(
        "alte_wegmarke_gefunden",
        False
    ):
        if wald_funde.get(
            "alte_wegmarke_tomas_gezeigt",
            False
        ):
            besondere_funde[
                "alte_wegmarke"
            ] = "erkannt"

        else:
            besondere_funde.setdefault(
                "alte_wegmarke",
                "gefunden"
            )

    if wald_funde.get(
        "altes_kartenstueck_erhalten",
        False
    ):
        besondere_funde.setdefault(
            "altes_kartenstueck",
            "erhalten"
        )

    geladener_spieler.setdefault(
        "prolog_status",
        "prolog_abgeschlossen"
    )

    geladener_spieler.setdefault(
        "prolog_besuchte_orte",
        {
            "gasthaus": False,
            "schmiede": False,
            "marktplatz": False
        }
    )

    geladener_spieler.setdefault(
        "prolog_joris_hinweise",
        {
            "mara": False,
            "tomas": False
        }
    )

    if migration_von is not None:
        print()

        design_text(
            "SPIELSTAND AKTUALISIERT",
            design="positiv",
            art="menue"
        )

        print()

        print(
            f"Speicherformat: "
            f"{migration_von} → "
            f"{SAVE_VERSION}"
        )

        if backup_datei:
            print()

            print(
                "Sicherheitskopie:"
            )

            print(
                os.path.basename(
                    backup_datei
                )
            )

    print()

    design_text(
        "SPIELSTAND GELADEN",
        design="positiv",
        art="menue"
    )

    print(
        f"Willkommen zurück, "
        f"{geladener_spieler['name']}!"
    )

    warte_auf_taste("Weiter")

    AKTIVER_SPEICHER_SLOT = slot

    return geladener_spieler

def warte_auf_taste(text="Zurück"):
    global TEXT_SKIP_AKTIV

    if os.name == "nt":
        import msvcrt

        # Alte Tastendrücke entfernen.
        # Eine Taste, die bereits VOR dieser Bestätigung
        # gedrückt wurde, darf nicht als Weiter zählen.
        while msvcrt.kbhit():
            taste = msvcrt.getwch()

            if taste == "\x03":
                raise KeyboardInterrupt

            if taste in ("\x00", "\xe0"):
                if msvcrt.kbhit():
                    msvcrt.getwch()

    print()
    print(f"[Beliebige Taste] {text}")

    if os.name == "nt":
        import msvcrt

        while True:
            taste = msvcrt.getwch()

            if taste == "\x03":
                raise KeyboardInterrupt

            # Pfeiltasten / Sondertasten überspringen
            if taste in ("\x00", "\xe0"):
                if msvcrt.kbhit():
                    msvcrt.getwch()
                continue

            TEXT_SKIP_AKTIV = False
            return

    else:
        input()
        TEXT_SKIP_AKTIV = False

def eingabe_zahl(minimum, maximum, trenner=True):
    fehler = False

    while True:
        if fehler and ANSI_STILE_AKTIV:
            print(
                "\033[F\033[2K",
                end="",
                flush=True
            )

        if fehler:
            prompt = (
                f"Ungültig – wähle "
                f"{minimum}-{maximum} > "
            )
        else:
            prompt = "Auswahl: "

        eingabe = input(
            prompt
        ).strip()

        try:
            zahl = int(
                eingabe
            )
        except ValueError:
            zahl = None

        if (
            zahl is not None
            and minimum <= zahl <= maximum
        ):
            if fehler and ANSI_STILE_AKTIV:
                print(
                    "\033[F\033[2K",
                    end="",
                    flush=True
                )

                print(
                    f"Auswahl: {zahl}"
                )

            if trenner:
                auswahl_trenner()

            return zahl

        fehler = True

def eingabe_menu(
    minimum,
    maximum,
    sonder_tasten=("s", "i"),
    trenner=True
):
    sonder_tasten = tuple(
        taste.lower()
        for taste in sonder_tasten
    )

    if isinstance(
        spieler,
        dict
    ):
        eingabe_modus = spieler.get(
            "menue_eingabe",
            STANDARD_EINSTELLUNGEN[
                "menue_eingabe"
            ]
        )

    else:
        eingabe_modus = (
            STANDARD_EINSTELLUNGEN[
                "menue_eingabe"
            ]
        )

    # -------------------------
    # DIREKTE TASTENEINGABE
    # -------------------------

    if (
        eingabe_modus == "direkt"
        and os.name == "nt"
        and maximum <= 9
    ):
        import msvcrt

        print(
            "Auswahl: ",
            end="",
            flush=True
        )

        while True:
            taste = (
                msvcrt.getwch()
                .lower()
            )

            if taste == "\x03":
                raise KeyboardInterrupt

            # Pfeiltasten / Sondertasten
            if taste in (
                "\x00",
                "\xe0"
            ):
                msvcrt.getwch()
                continue

            # S, I, J, Q usw.
            if taste in sonder_tasten:
                print(
                    taste.upper()
                )

                if trenner:
                    auswahl_trenner()

                return taste

            # Zahlen
            if taste.isdigit():
                zahl = int(
                    taste
                )

                if (
                    minimum
                    <= zahl
                    <= maximum
                ):
                    print(
                        taste
                    )

                    if trenner:
                        auswahl_trenner()

                    return zahl

    # -------------------------
    # MIT ENTER BESTÄTIGEN
    # -------------------------

    fehler = False

    while True:
        if (
            fehler
            and ANSI_STILE_AKTIV
        ):
            print(
                "\033[F\033[2K",
                end="",
                flush=True
            )

        if fehler:
            prompt = (
                f"Ungültig – wähle "
                f"{minimum}-{maximum} > "
            )

        else:
            prompt = "Auswahl: "

        eingabe = input(
            prompt
        ).strip().lower()

        # -------------------------
        # SONdertasten
        # -------------------------

        if eingabe in sonder_tasten:
            if (
                fehler
                and ANSI_STILE_AKTIV
            ):
                print(
                    "\033[F\033[2K",
                    end="",
                    flush=True
                )

                print(
                    f"Auswahl: "
                    f"{eingabe.upper()}"
                )

            if trenner:
                auswahl_trenner()

            return eingabe

        # -------------------------
        # ZAHL
        # -------------------------

        try:
            zahl = int(
                eingabe
            )

        except ValueError:
            zahl = None

        if (
            zahl is not None
            and minimum <= zahl <= maximum
        ):
            if (
                fehler
                and ANSI_STILE_AKTIV
            ):
                print(
                    "\033[F\033[2K",
                    end="",
                    flush=True
                )

                print(
                    f"Auswahl: {zahl}"
                )

            if trenner:
                auswahl_trenner()
