
        spieler[
            "verfassungs_praegung"
        ][
            verfassung_id
        ] += praegung_menge

        verfassung_neuberechnen(
            verfassung_id,
            meldung=meldung
        )

    # -------------------------
    # HAUPTATTRIBUT
    # -------------------------

    spieler[
        "attribut_fortschritt"
    ][
        attribut_id
    ] += menge

    entwickelt = False

    while True:
        schwelle = attribut_schwelle(
            attribut_id
        )

        if schwelle is None:
            break

        fortschritt = spieler[
            "attribut_fortschritt"
        ][
            attribut_id
        ]

        if fortschritt < schwelle:
            break

        spieler[
            "attribut_fortschritt"
        ][
            attribut_id
        ] -= schwelle

        alter_wert = spieler[
            "attribute"
        ][
            attribut_id
        ]

        spieler[
            "attribute"
        ][
            attribut_id
        ] += 1

        neuer_wert = spieler[
            "attribute"
        ][
            attribut_id
        ]

        entwickelt = True

        if meldung:
            print()

            design_text(
                "ATTRIBUT ENTWICKELT",
                design="positiv",
                art="menue"
            )

            print()

            print(
                f"{ATTRIBUT_DEFINITIONEN[attribut_id]['name']}: "
                f"{alter_wert} → {neuer_wert}"
            )

    return entwickelt

def lernerfahrung_hinzufuegen(
    quelle_id,
    attribut_id,
    menge=1,
    praegungen=None,
    max_nutzungen=1,
    meldung=True
):
    attribut_system_sicherstellen()

    if (
        not isinstance(
            quelle_id,
            str
        )
        or not quelle_id
    ):
        return False

    if attribut_id not in ATTRIBUT_DEFINITIONEN:
        return False

    if (
        isinstance(
            menge,
            bool
        )
        or not isinstance(
            menge,
            (int, float)
        )
        or menge <= 0
    ):
        return False

    if praegungen is None:
        praegungen = {}

    if not isinstance(
        praegungen,
        dict
    ):
        return False

    if (
        isinstance(
            max_nutzungen,
            bool
        )
        or not isinstance(
            max_nutzungen,
            int
        )
        or max_nutzungen <= 0
    ):
        return False

    bisher = spieler[
        "lernquellen"
    ].get(
        quelle_id,
        0
    )

    if bisher >= max_nutzungen:
        return False

    spieler[
        "lernquellen"
    ][
        quelle_id
    ] = bisher + 1

    attribut_fortschritt_hinzufuegen(
        attribut_id,
        menge=menge,
        praegungen=praegungen,
        meldung=meldung
    )

    return True

