                )

                text_ausgeben(
                    "[Bjorn] Mara bewirtet die Leute, "
                    "Tomas verkauft sein Zeug und ich hämmere."
                )

                print()

                text_ausgeben(
                    "[Bjorn] Für Eichenruh ist das fast "
                    "schon ein guter Tag."
                )

            dialog_thema_markieren(
                "bjorn",
                "dorf_neuigkeiten"
            )

            warte_auf_taste("Weiter")

        elif aktion == "schmied_nachfragen":
            text_ausgeben(
                f'[{spieler["name"]}] '
                "Wegen des alten Schmieds ..."
            )

            print()

            quest_status = spieler.get(
                "quest_schmied"
            )

            if quest_status == "suche_verlassenes_dorf":
                text_ausgeben(
                    "[Bjorn] Wenn an der Geschichte etwas dran ist, "
                    "würde ich hinter den alten Waldwegen suchen."
                )

                print()

                text_ausgeben(
                    "[Bjorn] Das Dorf müsste dort irgendwo "
                    "zwischen den Bäumen liegen."
                )

            elif quest_status == "dorf_entdeckt":
                text_ausgeben(
                    "[Bjorn] Du hast das Dorf gefunden?"
                )

                print()

                text_ausgeben(
                    "[Bjorn] Dann sieh dir die alte Schmiede an."
                )

                text_ausgeben(
                    "[Bjorn] Wenn der Hammer wirklich existiert hat, "
                    "ist das der beste Ort für eine Spur."
                )

            elif quest_status == "hinweis_gefunden":
                text_ausgeben(
                    "[Bjorn] Eine fest sitzende Schublade mit "
                    "auffälligen Spuren?"
                )

                print()

                text_ausgeben(
                    "[Bjorn] Klingt nicht so, als hätte jemand "
                    "nur Werkzeug darin vergessen."
                )

            elif quest_status == "neuer_hinweis":
                text_ausgeben(
                    "[Bjorn] 'Wo selbst das Feuer stirbt' ..."
                )

                print()

                text_ausgeben(
                    "Bjorn blickt kurz zu seinem eigenen Abschreckbecken."
                )

                text_ausgeben(
                    "[Bjorn] Denk nicht nur daran, wo das Feuer brennt. "
                    "Denk daran, wo die Hitze endet."
                )

            elif quest_status == "versteck_gefunden":
                text_ausgeben(
                    "[Bjorn] Ein lockerer Stein?"
                )

                print()

                text_ausgeben(
                    "[Bjorn] Dann würde ich nicht lange überlegen."
                )

                text_ausgeben(
                    "[Bjorn] Heb ihn an."
                )

