                )

            elif hilda_status == "abgeschlossen":
                text_ausgeben(
                    "Bjorn zuckt mit den Schultern."
                )

                print()

                text_ausgeben(
                    "[Bjorn] Hilda hat ihre Antwort bekommen."
                )

                text_ausgeben(
                    "[Bjorn] Zufriedener ist sie deswegen "
                    "wahrscheinlich trotzdem nicht."
                )

            else:
