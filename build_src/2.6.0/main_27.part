                (
                    "schmied_geschichte",
                    "Über eine alte Schmiedegeschichte sprechen."
                )
            )

        elif spieler["quest_schmied"] == "abgeschlossen":
            optionen.append(
                (
                    "hammer_zeichen",
                    "Wegen des Zeichens auf dem Hammer ..."
                )
            )

        optionen.append(
            (
                "ende",
                "Bis später."
            )
        )

        for nummer, (aktion_id, text) in enumerate(
            optionen,
            start=1
        ):
            if aktion_id in (
                "genug_arbeit",
                "muedigkeit",
                "viele_fragen",
                "dorf_neuigkeiten",
                "hammer_zeichen",
                "schmiedetechnik"
            ):
                text = dialog_option(
                    "bjorn",
                    aktion_id,
                    text
                )

            print(
                f"{nummer}. {text}"
            )

        bjorn_auswahl = eingabe_menu(
            1,
            len(optionen),
            sonder_tasten=()
        )

        aktion = optionen[
            bjorn_auswahl - 1
        ][0]

        erste_runde = False

        if aktion not in (
