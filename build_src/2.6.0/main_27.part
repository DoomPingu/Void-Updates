                )

                print()

                text_ausgeben(
                    "[Bjorn] Wenn Kraft alles wäre, "
                    "könnte ich einen Ochsen an die Esse stellen."
                )

                print()

                text_ausgeben(
                    "[Bjorn] Der Schlag muss sitzen."
                )

                text_ausgeben(
                    "[Bjorn] Winkel, Rhythmus, der richtige Moment."
                )

                print()

                text_ausgeben(
                    "[Bjorn] Wer nur stärker zuschlägt, "
                    "macht irgendwann das Werkstück kaputt."
                )

