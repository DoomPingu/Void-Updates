        dialog_titel("Bjorn")

        text_ausgeben(
            "Bjorn legt den Hammer beiseite, als du an die Werkbank trittst."
        )

        text_ausgeben(
            "Sein Blick fällt zuerst auf den leeren Platz, an dem zuvor "
            "der Ledersack mit der Lieferung stand."
        )

        print()
        text_ausgeben(
            "[Bjorn] Na? Ist bei den Köhlern alles angekommen?"
        )

        print()
        text_ausgeben(
            f'[{spieler["name"]}] Ja. Die nächste Ladung Kohle '
            "steht morgen für dich bereit."
        )

        print()
        text_ausgeben(
            "Bjorn wirft einen Blick zu den verbliebenen Kohlesäcken "
