                    "Was sollte Joris heute eigentlich erledigen?"
                )
            )

            print("3. Gespräch beenden")

            bjorn_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            print()

            if bjorn_auswahl == 1:
                text_ausgeben(
                    "[Bjorn] Frag vielleicht bei Mara oder auf dem "
                    "Marktplatz nach."
                )

                print()
                text_ausgeben(
                    "[Bjorn] Irgendjemand muss den Jungen heute Morgen "
                    "gesehen haben."
                )
                dialog_thema_markieren(
                    "bjorn",
                    "joris_suchen"
                )
                warte_auf_taste("Weiter")

            elif bjorn_auswahl == 2:
                text_ausgeben(
                    "[Bjorn] Er sollte die neuen Kohlesäcke zählen "
                    "und mir danach bei ein paar Kleinigkeiten helfen."
                )

                print()
                text_ausgeben(
                    "[Bjorn] Nichts, wofür er einfach "
                    "stundenlang verschwinden müsste."
                )
                dialog_thema_markieren(
                    "bjorn",
                    "joris_arbeit"
                )
                warte_auf_taste("Weiter")

            elif bjorn_auswahl == 3:
                return

    # -------------------------
    # HINWEISE ZU JORIS GEFUNDEN
    # -------------------------

    elif prolog_status == "joris_hinweise_komplett":
        text_ausgeben(
            "Bjorn legt eine Zange beiseite, als du zu ihm trittst."
        )

        text_ausgeben(
            "[Bjorn] Du hast etwas herausgefunden."
        )

        print()
        text_ausgeben(
            "Du erzählst ihm von Mara, dem abgeholten Brot "
            "und Tomas' Hanfseil."
        )

        text_ausgeben(
            "Als du erwähnst, dass Joris hinter der Schmiede "
            "verschwunden ist, wird Bjorn still."
        )

        print()
        text_ausgeben(
            "Sein Blick wandert zur hinteren Tür der Werkstatt."
        )

        text_ausgeben(
            "[Bjorn] Der alte Lagerkeller."
        )

        print()
        text_ausgeben(
            "[Bjorn] Dort unten stehen noch schwere Regale und Kisten. "
            "Ich habe ihm gestern gesagt, dass wir irgendwann "
            "Ordnung schaffen müssen."
        )

        text_ausgeben(
            "Bjorn flucht leise und sieht zur glühenden Esse."
        )

        print()
        text_ausgeben(
            "[Bjorn] Geh schon vor. Die Falltür ist direkt hinter "
            "der Schmiede."
        )

        text_ausgeben(
            "[Bjorn] Ich sichere die Esse und komme nach."
        )

        spieler["prolog_status"] = "joris_keller"

        quest_meldung(
            "update",
            "Der verlorene Lehrling",
            "Untersuche den alten Lagerkeller hinter Bjorns Schmiede."
        )

        warte_auf_taste()
        return

    # -------------------------
    # JORIS IST ZURÜCK
    # -------------------------

    elif prolog_status == "joris_gefunden":
        text_ausgeben(
            "Bjorn ist mit zwei Schritten bei Joris."
        )

        text_ausgeben(
            "Er mustert ihn von Kopf bis Fuß und greift ihm kurz "
            "an beide Schultern."
        )

        print()
        text_ausgeben(
            "[Bjorn] Verletzt?"
        )

        text_ausgeben(
            "Joris schüttelt den Kopf."
        )

        print()
        text_ausgeben(
            "[Joris] Das Regal ist umgekippt. "
            "Ich bin hinter der Tür festgesessen."
        )

        text_ausgeben(
            "Bjorn lässt hörbar die Luft aus den Lungen."
        )

        print()
        text_ausgeben(
            "[Bjorn] Und dafür verschwindest du einen halben Morgen."
        )

        print()
        text_ausgeben(
            "Joris' Stirn legt sich in Falten."
        )

        text_ausgeben(
            "[Joris] Einen halben Morgen..."
        )

        text_ausgeben(
            "Er schaut kurz zu dir."
        )

        print()
        text_ausgeben(
            "[Joris] Für mich war ich viel länger dort unten."
        )

        print()
        text_ausgeben(
            "Bjorn legt ihm wieder eine Hand auf die Schulter."
        )

        text_ausgeben(
            "[Bjorn] Keine Fenster. Kein Tageslicht. "
            "Nur dieser verdammte Keller."
        )

        text_ausgeben(
            "[Bjorn] Da verliert man schneller das Gefühl für die Zeit, "
            "als man denkt."
        )

        print()
        text_ausgeben(
            "Joris öffnet den Mund, sagt aber nichts."
        )

        text_ausgeben(
            "Nach einem Moment nickt er nur."
        )

        print()

        quest_meldung(
            "abgeschlossen",
            "Der verlorene Lehrling"
        )

        spieler["prolog_status"] = "joris_gerettet"

        text_ausgeben(
            "[Bjorn] Geh rüber zu Mara und hol dir etwas Warmes."
        )

        text_ausgeben(
            "[Bjorn] Für heute fasst du keinen Keller und kein Regal mehr an."
        )

        print()
        text_ausgeben(
            "Joris murmelt etwas, das wie Zustimmung klingt, "
            "und verlässt die Schmiede."
        )

        print()
        text_ausgeben(
            "Bjorn sieht ihm nach, bis die Tür hinter ihm zufällt."
        )

        print()
        text_ausgeben(
            f'[Bjorn] Und du, {spieler["name"]}... '
            "geh noch nicht zu weit."
        )

        text_ausgeben(
            "[Bjorn] Jetzt, wo Joris ausfällt, "
            "könnte ich noch einen Gefallen gebrauchen."
        )

        warte_auf_taste()
        return

    elif prolog_status == "joris_gerettet":
        text_ausgeben(
            "[Bjorn] Joris sitzt erstmal bei Mara."
        )

        text_ausgeben(
            "Bjorn dreht sich zur Werkbank und zieht einen "
            "schweren Ledersack näher heran."
        )

        print()
        text_ausgeben(
            "[Bjorn] Eigentlich wäre das sein nächster Gang gewesen."
        )

        text_ausgeben(
            "[Bjorn] Frisch geschmiedete Keile und Achsnägel "
            "für die Köhler."
        )

        print()
        text_ausgeben(
            "Bjorn klopft mit zwei Fingern gegen den Sack. "
            "Metall schlägt dumpf gegeneinander."
        )

        text_ausgeben(
            "[Bjorn] Sie liefern mir Kohle für die Esse, "
            "ich halte ihre Werkzeuge in Schuss."
        )

        text_ausgeben(
            "[Bjorn] Heute fehlt nur jemand, der den Sack hinbringt."
        )

        print()
        while True:
            print("1. Ich bringe die Lieferung hin.")
            print("2. Welchen Weg nehme ich?")

            bjorn_auswahl = eingabe_menu(
