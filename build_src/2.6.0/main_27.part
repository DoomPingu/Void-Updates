                2,
                sonder_tasten=()
            )

            print()

            if bjorn_auswahl == 1:
                break

            elif bjorn_auswahl == 2:
                text_ausgeben(
                    "[Bjorn] Nimm den breiten Weg aus Eichenruh."
                )

                text_ausgeben(
                    "[Bjorn] Sobald du den Wald erreichst, bleib auf "
                    "den alten Fahrspuren."
                )

                text_ausgeben(
                    "[Bjorn] Die führen dich direkt zu den Erdmeilern."
                )

