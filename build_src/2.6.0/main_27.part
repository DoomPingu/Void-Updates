            )

        print()
        text_ausgeben(
            "Bjorns Blick fällt auf deinen leeren Gürtel."
        )

        text_ausgeben(
            "Er hält inne."
        )

        print()
        text_ausgeben(
            "[Bjorn] Moment. So schicke ich dich nicht auf einen Waldweg."
        )

        text_ausgeben(
            "[Bjorn] Die Strecke ist ruhig, aber Wildschweine "
            "fragen selten nach Reiseplänen."
        )

        print()
        text_ausgeben(
            "[Bjorn] Such dir etwas aus der alten Kiste aus."
