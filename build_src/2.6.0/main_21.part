            warte_auf_taste(
                "Weiter"
            )

            return
        
def dialog_hilda():
    npc_besuch_starten(
        "hilda"
    )

    erste_runde = True
    themen_dieses_gespraech = set()

    def hilda_abschied():
        direkte_besuche = npc_status(
            "hilda"
        ).get(
            "direkte_besuche",
            0
        )

        if spieler["lebenspunkte"] <= 50:
            abschied = npc_variante_waehlen(
                "hilda",
                "letzter_abschied_verletzt",
                [
                    (
                        "[Hilda] Und jetzt gehst du dich ausruhen."
                    ),
                    (
                        "[Hilda] Pass auf dich auf.\n"
                        "[Hilda] Ich brauche keine weitere "
                        "verschwundene Person."
                    ),
                    (
                        "[Hilda] Geh langsam.\n"
                        "[Hilda] Du siehst aus, als würdest du "
                        "beim nächsten Windstoß umfallen."
                    )
                ]
            )

        elif direkte_besuche >= 5:
            abschied = npc_variante_waehlen(
                "hilda",
                "letzter_abschied_dauerbesuch",
                [
                    "[Hilda] Bis in fünf Minuten.",
                    (
                        "[Hilda] Ich sage nicht Auf Wiedersehen.\n"
                        "[Hilda] Das lohnt sich bei dir kaum noch."
                    ),
                    "[Hilda] Du weißt ja inzwischen, wo ich stehe."
                ]
            )

        else:
            abschied = npc_variante_waehlen(
                "hilda",
                "letzter_abschied_normal",
                [
                    "[Hilda] Bis später.",
                    "[Hilda] Pass auf dich auf.",
                    "[Hilda] Gute Wege.",
                    "[Hilda] Und bring dich nicht wieder in Schwierigkeiten."
                ]
            )

        for zeile in abschied.split("\n"):
            if zeile:
                text_ausgeben(
                    zeile
                )
            else:
                print()

        warte_auf_taste(
            "Weiter"
        )

    # -------------------------
    # PROLOG
    # -------------------------

    if prolog_laeuft():
        ort_titel("Marktplatz von Eichenruh")
        dialog_titel("Hilda")

        text_ausgeben(
            "Hilda steht hinter ihrem Marktstand "
            "und sortiert mehrere Säcke und Kisten."
        )

        print()
        text_ausgeben(
            "Als sie dich bemerkt, hebt sie kurz den Blick."
        )

        print()
        text_ausgeben(
            f'[Hilda] Morgen, {spieler["name"]}. '
            "Wenn du etwas kaufen willst, musst du dich noch gedulden."
        )

        print()
        text_ausgeben(
            "[Hilda] Ich bin selbst noch nicht fertig "
            "mit dem Auspacken."
        )

        warte_auf_taste()
        return



    # -------------------------
    # NACH DEM PROLOG
    # -------------------------

    while True:
        ort_titel("Marktplatz von Eichenruh")
        dialog_titel("Hilda")

        text_ausgeben(
            "Hilda steht hinter ihrem Marktstand "
            "und sortiert mehrere Säcke und Kisten."
        )

        # -------------------------
        # QUEST NOCH NICHT ENTDECKT
        # -------------------------

        if spieler["quest_hilda"] == "nicht_entdeckt":
            print()

            if npc_reaktion_gezeigt(
                "hilda",
                "lieferung_abgelehnt"
            ):
                text_ausgeben(
                    "Hilda sieht von ihren Waren auf."
                )

                print()

                text_ausgeben(
                    "[Hilda] Falls du deine Meinung geändert hast: "
                    "Meine Lieferung fehlt noch immer."
                )

            else:
                text_ausgeben(
                    "Als sie dich bemerkt, wirft Hilda noch einmal "
                    "einen Blick zur Straße."
                )

                print()

                if spieler.get(
                    "prolog_uebersprungen",
                    False
                ):
                    text_ausgeben(
                        "[Hilda] Du bist doch inzwischen draußen unterwegs, oder?"
                    )

                else:
                    text_ausgeben(
                        "[Hilda] Du warst doch gerade erst draußen "
                        "Richtung Köhlerei."
                    )

                text_ausgeben(
                    "[Hilda] Dann kannst du mir vielleicht einen Gefallen tun."
                )

            print()

            print()
            print("1. Was ist passiert?")
            print("2. Klingt nach Arbeit. Nein danke.")
            print("3. Gespräch beenden")

            hilda_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            print()

            if hilda_auswahl == 1:
                text_ausgeben(
                    f'[{spieler["name"]}] Was ist passiert?'
                )

                print()

                text_ausgeben(
                    "Hilda deutet auf eine auffällige Lücke zwischen "
                    "den Kisten hinter ihrem Stand."
                )

                print()
                text_ausgeben(
                    "[Hilda] Heute Morgen hätte dort eine Lieferung "
                    "stehen sollen."
                )

                text_ausgeben(
                    "[Hilda] Mehl, Kräuter, Stoffe... nichts Besonderes."
                )

                print()
                text_ausgeben(
                    "[Hilda] Der Händler kommt normalerweise über denselben "
                    "Waldweg, der zur Köhlerei führt."
                )

                text_ausgeben(
                    "[Hilda] Aber weder er noch sein Wagen sind angekommen."
                )

                print()
                text_ausgeben(
                    "Hilda blickt wieder zur Straße, nur für einen Moment."
                )

                text_ausgeben(
                    "[Hilda] Wenn du den Weg ohnehin noch einmal gehst, "
                    "halt die Augen offen."
                )

                print()

                quest_meldung(
                    "neu",
                    "Die verschwundene Lieferung",
                    "Untersuche den Waldweg zur Köhlerei nach Hildas "
                    "Händler und seinem Karren."
                )

                spieler["quest_hilda"] = "aktiv"

                warte_auf_taste("Weiter")

                erste_runde = False

            elif hilda_auswahl == 2:
                text_ausgeben(
                    f'[{spieler["name"]}] '
                    "Klingt nach Arbeit. Nein danke."
                )

                print()

                text_ausgeben(
                    "Hilda verdreht die Augen."
                )

                print()

                text_ausgeben(
                    "[Hilda] Natürlich. Tiere jagen klingt wohl "
                    "wichtiger als ehrliche Arbeit."
                )

                npc_reaktion_markieren(
                    "hilda",
                    "lieferung_abgelehnt"
                )

                warte_auf_taste("Weiter")

                return

            elif hilda_auswahl == 3:
                hilda_abschied()
                return

            continue

        # -------------------------
        # QUEST AKTIV
        # -------------------------

        elif spieler["quest_hilda"] == "aktiv":
            print()

            if erste_runde:
                direkte_besuche = npc_status(
                    "hilda"
                ).get(
                    "direkte_besuche",
                    0
                )

                if spieler["lebenspunkte"] <= 50:
                    text_ausgeben(
                        "[Hilda] Bei allen Wegen, du siehst fürchterlich aus."
                    )

                    text_ausgeben(
                        "[Hilda] Die Lieferung kann warten. "
                        "Du solltest dich erstmal ausruhen."
                    )

                elif direkte_besuche >= 5:
                    begruessung = npc_variante_waehlen(
                        "hilda",
                        "letzte_aktive_begruessung",
                        [
                            (
                                "[Hilda] Bevor du fragst: "
                                "Nein. Der Wagen ist noch nicht aufgetaucht."
                            ),
                            (
                                "[Hilda] Meine Lieferung fehlt noch immer.\n"
                                "[Hilda] Auch seit deinem letzten Besuch."
                            ),
                            (
                                "[Hilda] Du hoffst wohl, dass der Händler "
                                "irgendwann einfach hinter dir auftaucht."
                            )
                        ]
                    )

                    for zeile in begruessung.split("\n"):
                        if zeile:
                            text_ausgeben(
                                zeile
                            )
                        else:
                            print()

                else:
                    text_ausgeben(
                        "[Hilda] Meine Lieferung fehlt noch immer."
                    )

                    text_ausgeben(
                        "[Hilda] Wenn du sowieso in den Wald gehst, "
                        "halt die Augen offen."
                    )

            else:
                text_ausgeben(
                    "[Hilda] Noch etwas?"
                )

            print()

            optionen = []

            if "lieferung_inhalt" not in themen_dieses_gespraech:
                optionen.append(
                    (
                        "lieferung_inhalt",
                        "Was genau sollte geliefert werden?"
                    )
                )

            if "haendler" not in themen_dieses_gespraech:
                optionen.append(
                    (
                        "haendler",
                        "Weißt du etwas über den Händler?"
                    )
                )

            hilda_sorge_bekannt = dialog_thema_bekannt(
                "hilda",
                "haendler_sorge"
            )

            if (
                "haendler_sorge"
                not in themen_dieses_gespraech
                and (
                    hilda_sorge_bekannt
                    or spieler_pruefung(
                        "empathie",
                        2
                    )
                )
            ):
                optionen.append(
                    (
                        "haendler_sorge",
                        "[Empathie] Es geht dir nicht nur "
                        "um die Lieferung, oder?"
                    )
                )

            optionen.append(
                (
                    "ende",
                    "Gespräch beenden"
                )
            )

            for nummer, (aktion_id, text) in enumerate(
                optionen,
                start=1
            ):
                if aktion_id in (
