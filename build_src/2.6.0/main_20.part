            )

            if not spieler.get(
                "dorf_haeuser_eindruck_gezeigt",
                False
            ):
                text_ausgeben(
                    "Zwischen den Häusern ist der alte Dorfplatz noch zu erkennen. "
                    "Gras wächst durch die Fugen der flachen Steine."
                )

                text_ausgeben(
                    "Vor einem Wohnhaus liegt ein umgestürzter Schemel. "
                    "Der Brunnen steht etwas weiter zwischen zwei verwilderten Gärten."
                )

                spieler[
                    "dorf_haeuser_eindruck_gezeigt"
                ] = True

            else:
                text_ausgeben(
                    "Du gehst wieder zwischen den verlassenen Häusern hindurch.",
                    art="menue"
                )

            menue_trenner()

            print(
                "1. Ein altes Wohnhaus durchsuchen"
            )

            print(
                "2. Den Dorfbrunnen untersuchen"
            )

            print(
                "3. Zurück"
            )

            dorf_menu_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            # -------------------------
            # WOHNHAUS
            # -------------------------

            if dorf_menu_auswahl == 1:
                ort_titel(
                    "Verlassenes Dorf - Wohnhaus"
                )

                if not spieler[
                    "dorf_haus_gepluendert"
                ]:
                    text_ausgeben(
                        "Die Tür hängt offen in den Angeln. Im Inneren riecht es "
                        "nach feuchtem Holz und alter Erde."
                    )

                    text_ausgeben(
                        "Ein leerer Schrank steht an der Wand. Auf einem Regal liegen "
                        "noch zwei gesprungene Tonschalen und ein verrosteter Löffel."
                    )

                    print()

                    text_ausgeben(
                        "Neben dem Bettgestell sitzt eine Bodendiele etwas höher als die anderen."
                    )

                    text_ausgeben(
                        "Darunter findest du einen kleinen Stoffbeutel mit zwölf alten Münzen."
                    )

                    spieler[
                        "gold"
                    ] += 12

                    spieler[
                        "dorf_haus_gepluendert"
                    ] = True

                    print()

                    design_text(
                        "Du erhältst 12 Gold.",
                        design="positiv",
                        art="menue"
                    )

                else:
                    text_ausgeben(
                        "Du hast dieses Haus bereits "
                        "durchsucht.",
                        art="menue"
                    )

                    print()

                    print(
                        "Hier gibt es nichts mehr zu finden."
                    )

                warte_auf_taste(
                    "Zurück zu den Häusern"
                )

            # -------------------------
            # DORFBRUNNEN
            # -------------------------

            elif dorf_menu_auswahl == 2:
                ort_titel(
                    "Verlassenes Dorf - Dorfbrunnen"
                )

                spieler["easteregg_brunnen"] = (
                    spieler.get(
                        "easteregg_brunnen",
                        0
                    ) + 1
                )

                brunnen_besuche = spieler[
                    "easteregg_brunnen"
                ]



                text_ausgeben(
                    "Du trittst an den alten Dorfbrunnen."
                )

                text_ausgeben(
                    "Das Dach darüber ist an einer Seite eingesackt. "
                    "Der Eimer hängt schief an einem ausgefransten Seil."
                )

                print()

                text_ausgeben(
                    "An der Innenseite des steinernen Randes sind mehrere Namen eingeritzt."
                )

                text_ausgeben(
                    "Moos füllt einige der Buchstaben. Andere sind noch überraschend deutlich."
                )

                print()

                text_ausgeben(
                    "Unter den Namen steht ein längerer Satz:"
                )

                print()

                design_text(
                    "„Wir gingen nach Eichenruh. "
                    "Hier blieb nichts mehr für uns.“",
                    design="wissen",
                    art="menue"
                )

                print()

                text_ausgeben(
                    "Du blickst zurück zu den Häusern. Viele Räume wirken ausgeräumt, "
                    "nicht verwüstet."
                )

                text_ausgeben(
                    "Selbst an den alten Gartenzäunen fehlen Bretter, als hätte man "
                    "brauchbares Holz beim Fortgehen mitgenommen."
                )

                if brunnen_besuche >= 5 and DEV_MODUS:
                    print()

                    if brunnen_besuche == 5:
                        design_text(
                            "[Entwickler] Du hast den Brunnen "
                            "jetzt fünfmal untersucht.",
                            design="wissen",
                            art="menue"
                        )

                        print()

                        design_text(
                            "[Entwickler] Wir haben hier wirklich "
                            "nichts mehr versteckt.",
                            design="wissen",
                            art="menue"
                        )

                    elif brunnen_besuche == 6:
                        design_text(
                            "[Entwickler] Nein.",
                            design="wissen",
                            art="menue"
                        )

                    elif brunnen_besuche == 7:
                        design_text(
                            "[Entwickler] Wirklich nicht.",
                            design="wissen",
                            art="menue"
                        )

                    else:
                        design_text(
                            "[Entwickler] Hör auf, den Brunnen "
                            "zu untersuchen.",
                            design="wissen",
                            art="menue"
                        )

                warte_auf_taste(
                    "Zurück zu den Häusern"
                )

            # -------------------------
            # ZURÜCK
            # -------------------------

            elif dorf_menu_auswahl == 3:
                break


def dialog_mara():
    mara_besuch = npc_besuch_starten(
        "mara"
    )

    erste_runde = True

    themen_dieses_gespraech = set()
    nach_prolog_besuch = None

    while True:
        ort_titel("Gasthaus")
        dialog_titel("Mara")

        prolog_status = spieler.get("prolog_status")

        # -------------------------
        # JORIS WIRD GESUCHT
        # -------------------------

        if prolog_status in [
            "joris_suche",
            "joris_hinweise_komplett"
        ]:
            hinweise = spieler.get(
                "prolog_joris_hinweise",
                {}
            )

            if not npc_reaktion_gezeigt(
                "mara",
                "joris_suche_ambiente"
            ):
                text_ausgeben(
                    "Mara stellt mehrere Brote hinter dem Tresen beiseite, "
                    "während sie mit einem Gast abrechnet."
                )

                print()
                text_ausgeben(
                    "[Gast] Nur falls du meinen leeren Becher "
                    "übersehen hast."
                )

                text_ausgeben(
                    "[Mara] Habe ich nicht. Du überlebst noch einen Moment."
                )

                text_ausgeben(
                    "Der Mann grinst und zieht den Becher wieder zu sich."
                )

                npc_reaktion_markieren(
                    "mara",
                    "joris_suche_ambiente"
                )

            print()
            print(
                "1. " + dialog_option(
                    "mara",
                    "joris_gesehen",
                    "Hast du Joris heute gesehen?"
                )
            )

            print(
                "2. " + dialog_option(
                    "mara",
                    "joris_kurz_vorbeischauen",
                    "Ich wollte nur kurz vorbeischauen."
                )
            )

            print("3. Gespräch beenden")

            mara_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            print()

            if mara_auswahl == 1:
                dialog_thema_markieren(
                    "mara",
                    "joris_gesehen"
                )

                if not hinweise.get("mara", False):
                    text_ausgeben(
                        "[Mara] Joris? Ja. Der war heute Morgen hier."
                    )

                    print()
                    text_ausgeben(
                        "[Mara] Er hat Bjorns Brot abgeholt und kaum "
                        "mehr gesagt als nötig."
                    )

                    text_ausgeben(
                        "Mara hält kurz inne und legt ein Tuch "
                        "über die restlichen Laibe."
                    )

                    print()
                    text_ausgeben(
                        "[Mara] Danach hat er gefragt, ob Tomas schon "
                        "auf seiner Bank am Marktplatz sitzt."
                    )

                    text_ausgeben(
                        "[Mara] Ihm fehlte wohl noch etwas für Bjorns Arbeit."
                    )

                    prolog_joris_hinweis("mara")

                else:
                    text_ausgeben(
                        "[Mara] Wie gesagt: Erst Bjorns Brot, "
                        "danach wollte er zu Tomas."
                    )

                warte_auf_taste("Weiter")

            elif mara_auswahl == 2:
                dialog_thema_markieren(
                    "mara",
                    "joris_kurz_vorbeischauen"
                )

                text_ausgeben(
                    "[Mara] Dann such dir einen Platz. "
                    "Noch ist es hier einigermaßen ruhig."
                )

                warte_auf_taste("Weiter")

            elif mara_auswahl == 3:
                return

            continue

        # -------------------------
        # NORMALER PROLOG-DIALOG
        # -------------------------

        if prolog_laeuft():
            text_ausgeben(
                f"[Mara] Guten Morgen, {spieler['name']}. "
                "Schon auf den Beinen?"
            )

            print()
            text_ausgeben(
                "Mara stellt einen Krug unter den Tresen "
                "und wischt sich die Hände an ihrer Schürze ab."
            )

            print()
            print(
                "1. " + dialog_option(
                    "mara",
                    "prolog_reinschauen",
                    "Ich wollte nur kurz reinschauen."
                )
            )

            print(
                "2. " + dialog_option(
                    "mara",
                    "prolog_viel_los",
                    "Ist heute schon viel los?"
                )
            )

            print("3. Gespräch beenden")

            mara_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            print()

            if mara_auswahl == 1:

                dialog_thema_markieren(
                    "mara",
                    "prolog_reinschauen"
                )

                text_ausgeben(
                    "[Mara] Dann bist du hier genau richtig. "
                    "Für ein paar Minuten ist immer Platz."
                )

                warte_auf_taste("Weiter")

            elif mara_auswahl == 2:

                dialog_thema_markieren(
                    "mara",
                    "prolog_viel_los"
                )

                text_ausgeben(
                    "[Mara] Noch nicht. "
                    "Aber gib ihnen Zeit."
                )

                text_ausgeben(
                    "[Mara] Spätestens zur Mittagszeit "
                    "sitzt wieder das halbe Dorf hier."
                )

                warte_auf_taste("Weiter")

            elif mara_auswahl == 3:
                return

            continue

        # -------------------------
        # NACH DEM PROLOG
        # -------------------------

        if nach_prolog_besuch is None:
            mara_daten = npc_status(
                "mara"
            )

            mara_daten["nach_prolog_besuche"] = (
                mara_daten.get(
                    "nach_prolog_besuche",
                    0
                ) + 1
            )

            nach_prolog_besuch = mara_daten[
                "nach_prolog_besuche"
            ]

        ereignis_begruessung = False

        if (
            erste_runde
            and not spieler.get(
                "prolog_uebersprungen",
                False
            )
            and not npc_reaktion_gezeigt(
                "mara",
                "joris_wieder_da"
            )
        ):
            text_ausgeben(
                "Mara hält mitten in der Bewegung inne, "
                "als sie dich erkennt."
            )

            print()

            text_ausgeben(
                "[Mara] Bjorn hat mir erzählt, "
                "dass du Joris gefunden hast."
            )

            print()

            text_ausgeben(
                "[Mara] Gut."
            )

            text_ausgeben(
                "[Mara] Wirklich gut."
            )

            print()

            text_ausgeben(
                "Sie greift wieder nach dem Krug vor ihr."
            )

            print()

            text_ausgeben(
                "[Mara] Der Junge soll sich trotzdem "
                "morgen hier blicken lassen."
            )

            text_ausgeben(
                "[Mara] Ich habe ein paar deutliche Worte für ihn."
            )

            npc_reaktion_markieren(
                "mara",
                "joris_wieder_da"
            )

            warte_auf_taste(
                "Weiter"
            )

            ereignis_begruessung = True

        if erste_runde and not ereignis_begruessung:

            direkte_besuche = npc_status(
                "mara"
            ).get(
                "direkte_besuche",
                0
            )

            if spieler["lebenspunkte"] <= 50:
                begruessung = npc_variante_waehlen(
                    "mara",
                    "letzte_begruessung_verletzt",
                    [
                        (
                            "Mara hält mitten in der Bewegung inne "
                            "und mustert dich.\n\n"
                            "[Mara] Setz dich erstmal. "
                            "Du siehst nicht besonders gut aus."
                        ),
                        (
                            "Mara zieht die Stirn kraus, "
                            "als sie dich näher ansieht.\n\n"
                            "[Mara] Was immer da draußen passiert ist: "
                            "Heute machst du langsam."
                        ),
                        (
                            "Mara stellt wortlos einen Becher "
                            "vor dir auf den Tresen.\n\n"
                            "[Mara] Erst trinken. Dann reden."
                        )
                    ]
                )

                for zeile in begruessung.split("\n"):
                    if zeile:
                        text_ausgeben(
                            zeile
                        )
                    else:
                        print()


            elif direkte_besuche >= 5:
                begruessung = npc_variante_waehlen(
                    "mara",
                    "letzte_dauerbesuch_begruessung",
                    [
                        (
                            "Mara sieht dich an. Dann kurz zur Tür. "
                            "Dann wieder zu dir.\n\n"
                            "[Mara] Nur damit ich sicher bin: "
                            "Du warst gerade eben schon hier, oder?"
                        ),
                        (
                            "Mara stützt beide Hände auf den Tresen.\n\n"
                            "[Mara] Gut. Diesmal bleibst du einfach hier, "
                            "bis dir alles eingefallen ist."
                        ),
                        (
                            "Mara schiebt einen Stuhl näher an den Tresen.\n\n"
                            "[Mara] Ich stelle dir den jetzt gleich hier hin.\n"
                            "[Mara] Spart uns beiden den Weg zur Tür."
                        ),
                        (
                            "Mara hebt eine Augenbraue.\n\n"
                            "[Mara] Langsam überlege ich, Eintritt zu verlangen.\n"
                            "[Mara] Nicht fürs Gasthaus. "
                            "Nur fürs ständige Wiederkommen."
                        )
                    ]
                )

                for zeile in begruessung.split("\n"):
                    if zeile:
                        text_ausgeben(
                            zeile
                        )
                    else:
                        print()

            elif nach_prolog_besuch == 1:
                text_ausgeben(
                    "Mara stellt einen Krug beiseite, "
                    "als du an den Tresen trittst."
                )

                print()

                text_ausgeben(
                    f"[Mara] Da bist du ja, {spieler['name']}."
                )

                text_ausgeben(
                    "[Mara] Du siehst aus, als wärst du "
                    "heute schon genug herumgelaufen."
                )

                print()

                text_ausgeben(
                    "[Mara] Was ist los?"
                )

            elif nach_prolog_besuch == 2:
                text_ausgeben(
                    "Mara blickt vom Tresen auf "
                    "und zieht eine Augenbraue hoch."
                )

                print()

                text_ausgeben(
                    "[Mara] Schon wieder?"
                )

                print()

                text_ausgeben(
                    "[Mara] Na gut. Was brauchst du?"
                )

            else:
                begruessung = npc_begruessung_waehlen(
                    "mara",
                    [
                        "[Mara] Na?",
                        "[Mara] Wieder da? Was brauchst du?",
                        "[Mara] Ich höre.",
                        "[Mara] Was führt dich diesmal zu mir?",
                        "[Mara] Du kennst den Weg zum Tresen ja inzwischen.",
                        "[Mara] Na schön. Was gibt es?"
                    ]
                )

                text_ausgeben(
                    begruessung
                )

        elif not erste_runde:
            text_ausgeben(
                "[Mara] Noch etwas?"
            )

        print()

        optionen = []

        if "neues_im_dorf" not in themen_dieses_gespraech:
            optionen.append(
                (
                    "neues_im_dorf",
                    "Was gibt es Neues im Dorf?"
                )
            )

        if "essen_pause" not in themen_dieses_gespraech:
            optionen.append(
                (
                    "essen_pause",
                    "Ich könnte etwas zu essen und eine Pause gebrauchen."
                )
            )

        if "grund_gasthaus" not in themen_dieses_gespraech:
            optionen.append(
                (
                    "grund_gasthaus",
                    "Seit wann muss ich einen Grund haben, "
                    "um ins Gasthaus zu kommen?"
                )
            )

        hilda_status = spieler.get(
            "quest_hilda",
            "nicht_entdeckt"
        )

        hilda_sorge_bekannt = (
            dialog_thema_bekannt(
                "mara",
                "hilda_sorge"
            )
        )

        if (
            "hilda_sorge"
            not in themen_dieses_gespraech
            and hilda_status in (
                "aktiv",
                "karren_gefunden"
            )
            and (
                hilda_sorge_bekannt
                or spieler_pruefung(
                    "empathie",
                    3
                )
            )
        ):
            optionen.append(
                (
                    "hilda_sorge",
                    dialog_option(
                        "mara",
                        "hilda_sorge",
                        "[Empathie] Bei Hilda geht es nicht "
                        "nur um die Ware, oder?"
                    )
                )
            )

        optionen.append(
            (
                "ende",
                "Bis später."
            )
        )

        for nummer, (_, text) in enumerate(
            optionen,
            start=1
        ):
            print(
                f"{nummer}. {text}"
            )

        mara_auswahl = eingabe_menu(
            1,
            len(optionen),
            sonder_tasten=()
        )

        aktion = optionen[
            mara_auswahl - 1
        ][0]

        erste_runde = False

        if aktion != "ende":
            themen_dieses_gespraech.add(
                aktion
            )

        print()

        if aktion == "neues_im_dorf":
            mara_daten = npc_status(
                "mara"
            )

            hilda_status = spieler.get(
                "quest_hilda",
                "nicht_entdeckt"
            )

            marek_status = spieler.get(
                "quest_ein_name_fehlt",
                "nicht_entdeckt"
            )

            # Welche Neuigkeit kennt Mara gerade?
            if marek_status == "abgeschlossen":
                neuigkeit_id = (
                    "marek_gefunden"
                )

            elif hilda_status in (
                "aktiv",
                "karren_gefunden"
            ):
                neuigkeit_id = (
                    "hilda_lieferung_fehlend"
                )

            elif hilda_status == "abgeschlossen":
                neuigkeit_id = (
                    "hilda_lieferung_abgeschlossen"
                )

            else:
                neuigkeit_id = (
                    "ruhiger_alltag"
                )

            letzte_neuigkeit = mara_daten.get(
                "letzte_dorf_neuigkeit"
            )

            # -------------------------
            # ES GIBT WIRKLICH ETWAS NEUES
            # -------------------------

            if letzte_neuigkeit != neuigkeit_id:

                if neuigkeit_id == "marek_gefunden":
                    text_ausgeben(
                        "Mara stellt einen Becher ins Regal und sieht "
                        "einen Moment zum Fenster hinaus."
                    )

                    print()

                    text_ausgeben(
                        "[Mara] Hilda hat heute einen Namen in ihr "
                        "Auftragsbuch geschrieben."
                    )

                    text_ausgeben(
                        "[Mara] Marek Voss."
                    )

                    print()

                    text_ausgeben(
                        "[Mara] Sie sagt, sie erinnert sich noch immer nicht "
                        "an ihn. Aber sie hat die Seite seitdem dreimal geprüft."
                    )

                    text_ausgeben(
                        "[Mara] Tomas hat den Namen auch notiert."
                    )

                elif neuigkeit_id == "hilda_lieferung_fehlend":
                    text_ausgeben(
                        "Mara trocknet einen Becher ab. "
                        "Ihr Blick wandert kurz zum Fenster."
                    )

                    print()

                    text_ausgeben(
                        "[Mara] Hilda wartet noch immer "
                        "auf ihre Lieferung."
                    )

                    text_ausgeben(
                        "[Mara] Sie behauptet natürlich, "
                        "sie sei nur wegen der Ware so unruhig."
                    )

                    print()

                    text_ausgeben(
                        "Mara stellt den Becher ins Regal."
                    )

                    print()

                    text_ausgeben(
                        "[Mara] Hilda schaut nicht zweimal nach einem Wagen, "
                        "wenn es ihr nur um ein paar Kisten geht."
                    )

                elif neuigkeit_id == "hilda_lieferung_abgeschlossen":
                    text_ausgeben(
                        "Mara hält kurz inne."
                    )

                    print()

                    text_ausgeben(
                        "[Mara] Hilda schaut nicht mehr "
                        "bei jedem Wagengeräusch zur Straße."
                    )

                    text_ausgeben(
                        "[Mara] Dafür ist sie seit deiner Rückkehr "
                        "ungewöhnlich still."
                    )

                    print()

                    text_ausgeben(
                        "Mara zieht leicht die Stirn kraus."
                    )

                    print()

                    text_ausgeben(
                        "[Mara] Und bevor du fragst: "
                        "Ja. Bei Hilda fällt so etwas auf."
                    )

                else:
                    text_ausgeben(
                        "Mara lässt den Blick durch "
                        "die Gaststube wandern."
                    )

                    print()

                    text_ausgeben(
                        "[Mara] Tomas hat sich heute Morgen "
                        "über das Brot beschwert."
                    )

                    text_ausgeben(
                        "[Mara] Danach hat er zwei Stück davon gegessen."
                    )

                    print()

                    text_ausgeben(
                        "Mara zuckt mit einer Schulter."
                    )

                    print()

                    text_ausgeben(
                        "[Mara] Bjorn arbeitet. Hilda handelt. "
                        "Tomas meckert."
                    )

                    text_ausgeben(
                        "[Mara] Also nein. "
                        "Heute ist alles ziemlich normal."
                    )

                mara_daten[
                    "letzte_dorf_neuigkeit"
                ] = neuigkeit_id

            # -------------------------
            # SEIT DEM LETZTEN MAL NICHTS NEUES
            # -------------------------

            else:
                antwort = npc_variante_waehlen(
                    "mara",
                    "letzte_keine_neuigkeit",
                    [
                        (
                            "Mara schaut dich einen Moment lang an.\n\n"
                            "[Mara] Seit du das letzte Mal gefragt hast?\n"
                            "[Mara] Nein. Ich hätte es bemerkt."
                        ),
                        (
                            "Mara wirft einen prüfenden Blick "
                            "durch die Gaststube.\n\n"
                            "[Mara] Bjorn hämmert noch. "
                            "Tomas redet noch.\n"
                            "[Mara] Sieht aus, als wäre die Welt "
                            "noch in Ordnung."
                        ),
                        (
                            "Mara überlegt demonstrativ lange.\n\n"
                            "[Mara] Nein.\n"
                            "[Mara] Aber wenn du mich in fünf Minuten "
                            "noch einmal fragst, denke ich mir etwas aus."
                        ),
                        (
                            "Mara lehnt sich kurz auf den Tresen.\n\n"
                            "[Mara] Nichts Neues.\n"
                            "[Mara] Genieß es. "
                            "Solche Tage weiß man meistens erst "
                            "hinterher zu schätzen."
                        )
                    ]