            if not npc_reaktion_gezeigt(
                "tomas",
                "joris_suche_ambiente"
            ):
                text_ausgeben(
                    "Tomas sitzt auf seiner Bank und verfolgt das "
                    "Treiben auf dem Platz."
                )

                print()
                text_ausgeben(
                    "Hilda kommt mit einer leeren Holzkiste an ihm vorbei."
                )

                text_ausgeben(
                    "[Hilda] Wenn du schon alles beobachtest: "
                    "Der Bäckerjunge schuldet mir noch einen Sack."
                )

                text_ausgeben(
                    "[Tomas] Er steht seit fünf Minuten hinter seinem Stand "
                    "und hofft, dass du ihn nicht siehst."
                )

                text_ausgeben(
                    "Hilda bleibt stehen und dreht langsam den Kopf."
                )

                text_ausgeben(
                    "[Hilda] Dann hat er jetzt Pech."
                )

                npc_reaktion_markieren(
                    "tomas",
                    "joris_suche_ambiente"
                )

            else:
                text_ausgeben(
                    "Tomas sitzt auf seiner Bank und betrachtet "
                    "das Treiben auf dem Marktplatz."
                )

            print()
            print(
                "1. " + dialog_option(
                    "tomas",
                    "joris_gesehen",
                    "Hast du Joris heute gesehen?"
                )
            )

            print(
                "2. " + dialog_option(
                    "tomas",
                    "kurz_reden",
                    "Ich wollte nur kurz mit dir reden."
                )
            )

            print("3. Gespräch beenden")

            tomas_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            print()

            if tomas_auswahl == 1:
                if not hinweise.get("tomas", False):
                    text_ausgeben(
                        "[Tomas] Joris? Ja. Der war heute Morgen hier."
                    )

                    print()
                    text_ausgeben(
                        "Tomas tippt einmal mit dem Spazierstock auf "
                        "das Pflaster vor seiner Bank."
                    )

                    text_ausgeben(
                        "[Tomas] Er hat sich ein langes Hanfseil "
                        "von mir geliehen."
                    )

                    text_ausgeben(
                        "[Tomas] Wofür, wollte er mir nicht sagen."
                    )

                    print()
                    text_ausgeben(
                        "Tomas deutet mit dem Stock über den Platz "
                        "in Richtung der Schmiede."
                    )

                    text_ausgeben(
                        "[Tomas] Danach ist er nicht zurück auf den Markt."
                    )

                    text_ausgeben(
                        "[Tomas] Ich habe ihn hinter Bjorns Schmiede "
                        "verschwinden sehen."
                    )

                    prolog_joris_hinweis("tomas")

                else:
                    text_ausgeben(
                        "[Tomas] Ein Hanfseil. Danach ist er hinter "
                        "Bjorns Schmiede verschwunden."
                    )

                dialog_thema_markieren(
                    "tomas",
                    "joris_gesehen"
                )

                warte_auf_taste("Weiter")

            elif tomas_auswahl == 2:
                text_ausgeben(
                    "Tomas rückt auf der Bank ein Stück zur Seite."
                )

                text_ausgeben(
                    "[Tomas] Dann setz dich. Beobachten lässt sich "
                    "das Dorf auch zu zweit."
                )

                dialog_thema_markieren(
                    "tomas",
                    "kurz_reden"
                )

                warte_auf_taste("Weiter")

            elif tomas_auswahl == 3:
                return

            continue

        # -------------------------
        # NORMALER PROLOG-DIALOG
        # -------------------------

        if prolog_laeuft():
            text_ausgeben(
                "Tomas sitzt auf seiner üblichen Bank "
                "am Rand des Marktplatzes."
            )

            text_ausgeben(
                "Neben ihm lehnt sein knorriger Spazierstock."
            )

            print()
            text_ausgeben("[Tomas] Morgen.")

            print()
            print(
                "1. " + dialog_option(
                    "tomas",
                    "frueh_hier",
                    "Du sitzt aber früh hier."
                )
            )

            print(
                "2. " + dialog_option(
                    "tomas",
                    "dorf_beobachten",
                    "Beobachtest du wieder das ganze Dorf?"
                )
            )

            print("3. Gespräch beenden")

            tomas_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            print()

            if tomas_auswahl == 1:
                text_ausgeben(
                    "[Tomas] In meinem Alter wacht man früh auf, "
                    "ob man will oder nicht."
                )
                dialog_thema_markieren(
                    "tomas",
                    "frueh_hier"
                )

                warte_auf_taste("Weiter")

            elif tomas_auswahl == 2:
                text_ausgeben("Tomas lächelt.")

                print()
                text_ausgeben(
                    "[Tomas] Irgendjemand muss schließlich wissen, "
                    "was hier vor sich geht."
                )

                text_ausgeben(
                    "[Tomas] Und die Leute erzählen erstaunlich viel, "
                    "wenn sie glauben das niemand zuhört."
                )
                dialog_thema_markieren(
                    "tomas",
                    "dorf_beobachten"
                )
                warte_auf_taste("Weiter")

            elif tomas_auswahl == 3:
                return

            continue

        # -------------------------
        # HAUPTQUEST: EIN NAME FEHLT
        # -------------------------

        if spieler.get(
            "quest_ein_name_fehlt"
        ) == "tomas_befragen":
            if not npc_reaktion_gezeigt(
                "tomas",
                "hilda_erinnerung_gehoert"
            ):
                text_ausgeben(
                    "Tomas sitzt auf seiner Bank, doch sein Blick liegt "
                    "nicht wie sonst auf dem ganzen Marktplatz."
                )

                text_ausgeben(
                    "Er schaut zu Hildas Stand."
                )

                print()
                text_ausgeben(
                    "[Tomas] Ich habe gehört, was sie gefragt hat."
                )

                text_ausgeben(
                    "[Tomas] Erzähl es mir trotzdem von Anfang an."
                )

                npc_reaktion_markieren(
                    "tomas",
                    "hilda_erinnerung_gehoert"
                )

            else:
                text_ausgeben(
                    "Tomas sitzt auf seiner Bank und wartet, "
                    "bis du zu ihm trittst."
                )

            print()
            print(
                "1. Vom verlassenen Karren erzählen"
            )
            print(
                "2. Gespräch beenden"
            )

            tomas_auswahl = eingabe_menu(
                1,
                2,
                sonder_tasten=()
            )

            if tomas_auswahl == 2:
                return

            print()
            text_ausgeben(
                "Du erzählst Tomas vom verlassenen Karren, "
                "dem Fahrtenbuch und davon, dass Hilda den Menschen "
                "hinter ihrer eigenen Lieferung nicht mehr benennen kann."
            )

            print()
            text_ausgeben(
                "Tomas schaut einen Moment lang schweigend auf seinen Stock."
            )

            print()
            text_ausgeben(
                "[Tomas] Hildas Händler. Natürlich."
            )

            text_ausgeben(
                "[Tomas] Er war..."
            )

            print()
            text_ausgeben(
                "Tomas bricht ab."
            )

            text_ausgeben(
                "Seine Stirn legt sich in Falten."
            )

            print()
            text_ausgeben(
                "[Tomas] Nein. Ich bekomme ihn nicht zu fassen."
            )

            print()
            text_ausgeben(
                "Er öffnet die kleine Ledertasche neben der Bank "
                "und zieht mehrere gefaltete Blätter hervor."
            )

            text_ausgeben(
                "[Tomas] Ich habe Hildas Liefervereinbarung selbst aufgesetzt."
            )

            print()
            text_ausgeben(
                "Auf dem Blatt stehen Waren, Mengen, Preise und mehrere "
                "kurze Notizen in Tomas' sauberer Handschrift."
            )

            text_ausgeben(
                "Am unteren Rand befindet sich eine hastige Unterschrift, "
                "kaum mehr als ein enger Schriftzug."
            )

            print()
            text_ausgeben(
                "[Tomas] Die Notizen sind von mir."
            )

            text_ausgeben(
                "[Tomas] Und ich weiß, dass ich mit diesem Mann "
                "hier gesessen und gesprochen habe."
            )

            print()
            text_ausgeben(
                "Du deutest auf die Unterschrift."
            )

            text_ausgeben(
                "Tomas beugt sich näher über das Blatt."
            )

            print()
            text_ausgeben(
                "[Tomas] Ich erkenne darin keinen Namen, den ich dir "
                "mit gutem Gewissen nennen könnte."
            )

            text_ausgeben(
                "[Tomas] Und das gefällt mir überhaupt nicht."
            )

            if item_besitzt(
                "fahrtenbuch_haendler"
            ):                print()
            text_ausgeben(
                "Du zeigst ihm das Fahrtenbuch aus dem Karren."
            )

            print()
            text_ausgeben(
                "Tomas überfliegt die letzten Einträge."
            )

            print()
            text_ausgeben(
                "[Tomas] Klippen. Ein Hafen."
            )

            text_ausgeben(
                "[Tomas] Vielleicht reicht das zusammen mit einem "
                "alten Wegverzeichnis."
            )

            print()
            text_ausgeben(
                "[Tomas] Bei dir zuhause stehen doch alte "
                "Wegverzeichnisse und Karten."
            )

            text_ausgeben(
                "[Tomas] Nimm das Fahrtenbuch mit und vergleich die "
                "letzten Einträge mit den alten Straßen."
            )

            print()
            text_ausgeben(
                "[Tomas] Und schreib auf, was du herausfindest."
            )

            text_ausgeben(
                "[Tomas] Im Moment traue ich meinem eigenen "
                "Gedächtnis nicht besonders."
            )
            spieler[
                "quest_ein_name_fehlt"
            ] = "fahrtenbuch_untersuchen"

            quest_meldung(
                "update",
                "Ein Name fehlt",
                "Untersuche das Fahrtenbuch an deinem Bücherregal."
            )

            warte_auf_taste(
                "Weiter"
            )

            return

        # -------------------------
        # NACH DEM PROLOG
        # -------------------------

        if nach_prolog_besuch is None:
            tomas_daten = npc_status(
                "tomas"
            )

            tomas_daten["nach_prolog_besuche"] = (
                tomas_daten.get(
                    "nach_prolog_besuche",
                    0
                ) + 1
            )

            nach_prolog_besuch = tomas_daten[
                "nach_prolog_besuche"
            ]

        ereignis_begruessung = False

        if (
            erste_runde
            and spieler.get(
                "quest_ein_name_fehlt"
            ) == "abgeschlossen"
            and not npc_reaktion_gezeigt(
                "tomas",
                "marek_abschluss"
            )
        ):
            text_ausgeben(
                "Tomas merkt sofort, dass du etwas zu erzählen hast."
            )

            print()

            text_ausgeben(
                f'[{spieler["name"]}] '
                "Ich habe Hildas Händler gefunden."
            )

            print()

            text_ausgeben(
                "Du erzählst Tomas von Marek Voss, "
                "Letzthafen und den Aufzeichnungen."
            )

            print()

            text_ausgeben(
                "Tomas hört ungewöhnlich still zu."
            )

            print()

            text_ausgeben(
                "[Tomas] Marek Voss."
            )

            text_ausgeben(
                "[Tomas] Also hatte der Mann einen Namen."
            )

            print()

            text_ausgeben(
                "[Tomas] Und ein Leben, selbst wenn sein eigener "
                "Kopf ihm kaum noch etwas davon sagt."
            )

            print()

            text_ausgeben(
                "Tomas legt beide Hände auf den Spazierstock."
            )

            print()

            text_ausgeben(
                "[Tomas] Gut, dass jemand es aufgeschrieben hat."
            )

            print()

            text_ausgeben(
                "Tomas zieht seine Abschrift der alten Liefervereinbarung "
                "aus der Tasche."
            )

            text_ausgeben(
                "Neben die schwer lesbare Unterschrift schreibt er in kleiner, "
                "sauberer Schrift: Marek Voss."
            )

            text_ausgeben(
                "[Tomas] Diesmal soll wenigstens der Name lesbar bleiben."
            )

            npc_reaktion_markieren(
                "tomas",
                "marek_abschluss"
            )

            warte_auf_taste(
                "Weiter"
            )

            ereignis_begruessung = True

        if (
            erste_runde
            and not ereignis_begruessung
            and besonderer_fund_status(
                "altes_kartenstueck"
            ) == "zugeordnet"
            and spieler.get(
                "wegstation_status",
                {}
            ).get(
                "entdeckt",
                False
            )
            and not npc_reaktion_gezeigt(
                "tomas",
                "wegstation_gefunden"
            )
        ):
            text_ausgeben(
                f'[{spieler["name"]}] '
                "Das Kartenstück hat tatsächlich zu einer "
                "alten Wegstation am Königsring geführt."
            )

            print()

            text_ausgeben(
                "Tomas richtet sich etwas auf."
            )

            print()

            text_ausgeben(
                "[Tomas] Die Wegstation steht also noch."
            )

            print()

            text_ausgeben(
                "[Tomas] Dann ist von den alten Straßen "
                "mehr übrig, als ich gedacht habe."
            )

            print()

            text_ausgeben(
                "Für einen Moment schaut Tomas nachdenklich "
                "über den Marktplatz."
            )

            print()

            text_ausgeben(
                "[Tomas] Vielleicht sollten wir vorsichtiger damit sein, "
                "was wir für längst verschwunden halten."
            )

            npc_reaktion_markieren(
                "tomas",
                "wegstation_gefunden"
            )

            warte_auf_taste(
                "Weiter"
            )

            ereignis_begruessung = True

        if erste_runde and not ereignis_begruessung:
            direkte_besuche = npc_status(
                "tomas"
            ).get(
                "direkte_besuche",
                0
            )

            if spieler["lebenspunkte"] <= 50:
                begruessung = npc_variante_waehlen(
                    "tomas",
                    "letzte_begruessung_verletzt",
                    [
                        (
                            "Tomas' Lächeln verschwindet, "
                            "als er dich genauer ansieht.\n\n"
                            "[Tomas] Du siehst aus, als könntest du "
                            "eine Pause gebrauchen."
                        ),
                        (
                            "Tomas mustert dich über den Griff "
                            "seines Spazierstocks hinweg.\n\n"
                            "[Tomas] Der Wald war wohl weniger "
                            "freundlich als sonst."
                        ),
                        (
                            "Tomas rückt ein Stück auf der Bank zur Seite.\n\n"
                            "[Tomas] Setz dich erstmal. "
                            "Reden kannst du danach immer noch."
                        )
                    ]
                )

                for zeile in begruessung.split("\n"):
                    if zeile:
                        text_ausgeben(
                            zeile
                        )
                    else:
                        print()

            elif direkte_besuche >= 5:
                begruessung = npc_variante_waehlen(
                    "tomas",
                    "letzte_dauerbesuch_begruessung",
                    [
                        (
                            "Tomas schaut dich an und dann auf "
                            "den freien Platz neben sich.\n\n"
                            "[Tomas] Setz dich doch einfach. "
                            "Dann musst du nicht dauernd wiederkommen."
                        ),
                        (
                            "Tomas stützt beide Hände auf seinen Stock.\n\n"
                            "[Tomas] Wenn du noch einmal zurückkommst, "
                            "fange ich an, deine Besuche zu zählen."
                        ),
                        (
                            "Tomas lächelt, noch bevor du etwas sagst.\n\n"
                            "[Tomas] Wieder etwas vergessen?"
                        )
                    ]
                )

                for zeile in begruessung.split("\n"):
                    if zeile:
                        text_ausgeben(
                            zeile
                        )
                    else:
                        print()

            elif nach_prolog_besuch == 1:
                text_ausgeben(
                    "Tomas sitzt auf seiner üblichen Bank "
                    "am Rand des Marktplatzes."
                )

                text_ausgeben(
                    "Neben ihm lehnt sein knorriger Spazierstock."
                )

                print()

                text_ausgeben(
                    "[Tomas] Du bist doch derjenige, "
                    "der ständig durch den Wald streift?"
                )

            elif nach_prolog_besuch == 2:
                text_ausgeben(
                    "Tomas hebt kurz die Hand, als er dich sieht."
                )

                print()

                text_ausgeben(
                    "[Tomas] Wieder da?"
                )

                text_ausgeben(
                    "[Tomas] Setz dich. Was beschäftigt dich?"
                )

            else:
                begruessung = npc_begruessung_waehlen(
                    "tomas",
                    [
                        "[Tomas] Na, was gibt es?",
                        "[Tomas] Setz dich.",
                        "[Tomas] Was möchtest du wissen?",
                        "[Tomas] Wieder unterwegs gewesen?",
                        (
                            "[Tomas] Das Dorf läuft nicht weg. "
                            "Zumindest meistens nicht."
                        )
                    ]
                )

                text_ausgeben(
                    begruessung
                )

        else:
            text_ausgeben(
                "[Tomas] Noch etwas?"
            )

        print()
        optionen = []

        kartenstueck_status = besonderer_fund_status(
            "altes_kartenstueck"
        )

        if "wald_ungewoehnlich" not in themen_dieses_gespraech:
            if spieler.get(
                "waldwaechter_schwelle_erlebt",
                False
            ):
                wald_text = (
                    "Von der stillen Lichtung erzählen."
                )

                if not dialog_thema_bekannt(
                    "tomas",
                    "wald_ungewoehnlich"
                ):
                    wald_text += " [!]"

            else:
                wald_text = (
                    "Was ist daran so ungewöhnlich?"
                )

            optionen.append(
                (
                    "wald_ungewoehnlich",
                    wald_text
                )
            )

        if "wald_kennen" not in themen_dieses_gespraech:
            optionen.append(
                (
                    "wald_kennen",
                    "Kennst du den Wald gut?"
                )
            )

        if "eichenruh_geschichte" not in themen_dieses_gespraech:
            optionen.append(
                (
                    "eichenruh_geschichte",
                    "Gibt es etwas Interessantes über Eichenruh zu erzählen?"
                )
            )

        if (
            "alte_wege_wissen"
            not in themen_dieses_gespraech
            and spieler_pruefung(
                "wissen",
                2
            )
        ):
            optionen.append(
                (
                    "alte_wege_wissen",
                    "[Wissen] Die alten Wege gehörten früher "
                    "zu einem größeren Netz, oder?"
                )
            )

        if (
            "kartenstueck"
            and kartenstueck_status in (
                "erhalten",
                "zugeordnet"
            )
        ):
            if kartenstueck_status == "zugeordnet":
                kartenstueck_text = (
                    "Das Kartenstück gehört zum Königsring."
                )
            else:
                kartenstueck_text = (
                    "Wegen des alten Kartenstücks ..."
                )

            optionen.append(
                (
                    "kartenstueck",
                    kartenstueck_text
                )
            )

        wegmarke_zeigen = (
            item_besitzt(
                "alte_wegmarke"
            )
            and not wald_fund_bekannt(
                "alte_wegmarke_tomas_gezeigt"
            )
        )

        if wegmarke_zeigen:
            optionen.append(
                (
                    "wegmarke",
                    "Ich habe im Wald etwas gefunden."
                )
            )

        optionen.append(
            (
                "ende",
                "Gespräch beenden"
            )
        )

        for nummer, (aktion_id, text) in enumerate(
            optionen,
            start=1
        ):
            if aktion_id in (
                "wald_ungewoehnlich",
                "wald_kennen",
                "eichenruh_geschichte",
                "kartenstueck",
                "alte_wege_wissen"
            ):
                text = dialog_option(
                    "tomas",
                    aktion_id,
                    text
                )

            print(
                f"{nummer}. {text}"
            )

        tomas_auswahl = eingabe_menu(
            1,
            len(optionen),
            sonder_tasten=()
        )

        aktion = optionen[
            tomas_auswahl - 1
        ][0]

        erste_runde = False

        if aktion not in (
            "ende",
            "wegmarke"
        ):
            themen_dieses_gespraech.add(
                aktion
            )

        print()

        if aktion == "wald_ungewoehnlich":
            schon_besprochen = dialog_thema_bekannt(
                "tomas",
                "wald_ungewoehnlich"
            )

            if spieler.get(
                "waldwaechter_schwelle_erlebt",
                False
            ):
                if not schon_besprochen:
                    text_ausgeben(
                        f'[{spieler["name"]}] '
                        "Auf dem Königsring gibt es eine Lichtung."
                    )

                    text_ausgeben(
                        "Du erzählst Tomas von der Stille, dem Waldwächter "
                        "und den verwitterten Steinen am Rand der Lichtung."
                    )

                    print()

                    text_ausgeben(
                        "Als du beschreibst, dass du danach den Verlauf des "
                        "Königsrings spüren konntest, verschwindet sein Lächeln."
                    )

                    print()

                    text_ausgeben(
                        "[Tomas] Einen Wächter kenne ich aus keiner Geschichte."
                    )

                    text_ausgeben(
                        "[Tomas] Und Straßen spürt man gewöhnlich mit den Füßen, "
                        "nicht durch Bäume hindurch."
                    )

                    print()

                    text_ausgeben(
                        "Tomas tippt einmal mit dem Stock auf das Pflaster."
                    )

                    text_ausgeben(
                        "[Tomas] Schreib dir auf, was genau passiert ist."
                    )

                    text_ausgeben(
                        "[Tomas] Noch müssen wir nicht entscheiden, was es bedeutet."
                    )

                else:
                    text_ausgeben(
                        "[Tomas] Die Lichtung, der Wächter und dieses Gefühl für den Weg."
                    )

                    print()

                    text_ausgeben(
                        "[Tomas] Nein. Mir ist dazu noch immer keine alte Geschichte eingefallen."
                    )

            else:
                text_ausgeben(
                    f'[{spieler["name"]}] '
                    "Was ist daran so ungewöhnlich?"
                )

                print()

                text_ausgeben(
                    "Tomas schmunzelt."
                )

                print()
                text_ausgeben(
                    "[Tomas] Ungewöhnlich? Nein."
                )

                text_ausgeben(
                    "[Tomas] Die meisten meiden den Wald nur, "
                    "wenn sie keinen Grund haben hineinzugehen."
                )

                print()
                text_ausgeben(
                    "[Tomas] Ob es klug ist, so oft dort herumzustreifen, "
                    "ist eine andere Frage."
                )

            dialog_thema_markieren(
                "tomas",
                "wald_ungewoehnlich"
            )

            warte_auf_taste("Weiter")

        elif aktion == "alte_wege_wissen":
            schon_besprochen = (
                dialog_thema_bekannt(
                    "tomas",
                    "alte_wege_wissen"
                )
            )

            dialog_thema_markieren(
                "tomas",
                "alte_wege_wissen"
            )

            text_ausgeben(