                f'[{spieler["name"]}] '
                "Die alten Wege gehörten früher "
                "zu einem größeren Netz, oder?"
            )

            print()

            if not schon_besprochen:
                text_ausgeben(
                    "Tomas sieht dich einen Moment prüfend an."
                )

                print()

                text_ausgeben(
                    "[Tomas] Du fängst an, die richtigen Fragen zu stellen."
                )

                print()

                text_ausgeben(
                    "[Tomas] Die Straßen verbanden früher "
                    "nicht nur Dörfer miteinander."
                )

                text_ausgeben(
                    "[Tomas] Es gab Wegstationen, Übergänge, "
                    "Arbeitsplätze und kleine Rastorte."
                )

                print()

                text_ausgeben(
                    "[Tomas] Manche davon hatten nie einen Namen, "
                    "den heute noch jemand kennt."
                )

                print()

                text_ausgeben(
                    "[Tomas] Wenn du alte Wege findest, "
                    "schau also nicht nur darauf, wohin sie führen."
                )

                text_ausgeben(
                    "[Tomas] Frag dich auch, "
                    "warum dort überhaupt einmal ein Weg war."
                )

                akt1_lernerfahrung(
                    "tomas_alte_wege"
                )

            else:
                text_ausgeben(
                    "[Tomas] Genau."
                )

                print()

                text_ausgeben(
                    "[Tomas] Ein alter Weg erzählt oft mehr "
                    "über seinen Zweck als über sein Ziel."
                )

            warte_auf_taste(
                "Weiter"
            )

        elif aktion == "wald_kennen":

            text_ausgeben(
                f'[{spieler["name"]}] '
                "Kennst du den Wald gut?"
            )

            print()

            text_ausgeben(
                "Tomas schaut über die Dächer hinweg "
                "in Richtung der Bäume."
            )

            print()
            text_ausgeben(
                "[Tomas] Gut genug, um zu wissen, "
                "dass sich dort etwas verändert."
            )

            print()
            text_ausgeben(
                "[Tomas] Manche Wege verschwinden."
            )

            text_ausgeben(
                "[Tomas] Andere tauchen plötzlich auf, "
                "wo gestern noch keiner war."
            )

            print()
            text_ausgeben(
                "Er schweigt einen Moment."
            )

            print()
            text_ausgeben(
                "[Tomas] Aber vielleicht werde ich auch einfach alt."
            )
            dialog_thema_markieren(
                "tomas",
                "wald_kennen"
            )
            warte_auf_taste("Weiter")

        elif aktion == "eichenruh_geschichte":
            text_ausgeben(
                f'[{spieler["name"]}] '
                "Gibt es etwas Interessantes über Eichenruh zu erzählen?"
            )

            print()
            text_ausgeben(
                "Tomas lehnt sich auf seinem Stock zurück."
            )

            print()
            text_ausgeben(
                "[Tomas] Eichenruh war nicht immer so groß wie heute."
            )

            text_ausgeben(
                "[Tomas] Früher standen hier kaum mehr als ein Gasthaus, "
                "ein paar Häuser und die Schmiede."
            )

            print()
            text_ausgeben(
                "[Tomas] Die alten Wege im Wald stammen noch aus dieser Zeit."
            )

            text_ausgeben(
                "[Tomas] Die meisten Leute haben längst vergessen, "
                "wohin sie einmal führten."
            )
            dialog_thema_markieren(
                "tomas",
                "eichenruh_geschichte"
            )
            warte_auf_taste("Weiter")

        elif aktion == "kartenstueck":
            if kartenstueck_status == "zugeordnet":
                text_ausgeben(
                    f'[{spieler["name"]}] '
                    "Das Kartenstück gehört zum Königsring."
                )

                print()

                text_ausgeben(
                    "Tomas nickt langsam."
                )

                print()

                text_ausgeben(
                    "[Tomas] Dann stammt es tatsächlich "
                    "von den alten Straßen."
                )

                text_ausgeben(
                    "[Tomas] Gut zu wissen, dass die Linien "
                    "darauf nicht völlig bedeutungslos geworden sind."
                )

            else:
                text_ausgeben(
                    f'[{spieler["name"]}] '
                    "Wegen des alten Kartenstücks ..."
                )

                print()

                text_ausgeben(
                    "Tomas betrachtet dich einen Moment."
                )

                print()

                text_ausgeben(
                    "[Tomas] Mehr als das, was ich dir gesagt habe, "
                    "weiß ich darüber leider auch nicht."
                )

                text_ausgeben(
                    "[Tomas] Vergleich es mit alten Karten "
                    "oder Wegverzeichnissen."
                )

                print()

                text_ausgeben(
                    "[Tomas] Irgendwo muss dieses Stück "
                    "einmal dazugehört haben."
                )

            dialog_thema_markieren(
                "tomas",
                "kartenstueck"
            )

            warte_auf_taste(
                "Weiter"
            )

        elif aktion == "wegmarke":
            text_ausgeben(
                f'[{spieler["name"]}] '
                "Ich habe im Wald etwas gefunden."
            )

            print()

            text_ausgeben(
                "Du legst die kleine Metallscheibe "
                "in Tomas' Hand."
            )

            print()
            text_ausgeben(
                "Tomas reibt mit dem Daumen über "
                "das verwitterte Zeichen."
            )

            print()
            text_ausgeben(
                "[Tomas] Wo hast du das gefunden?"
            )

            print()
            text_ausgeben(
                "Du erzählst ihm von dem stillen "
                "Seitenarm des Bachs."
            )

            print()
            text_ausgeben(
                "[Tomas] Das habe ich lange nicht mehr gesehen."
            )

            text_ausgeben(
                "[Tomas] Solche Marken hingen früher "
                "an den alten Wegen."
            )

            text_ausgeben(
                "[Tomas] Noch bevor die heutigen Pfade "
                "regelmäßig benutzt wurden."
            )

            print()
            text_ausgeben(
                "Tomas steht langsam auf und durchsucht "
                "eine kleine Ledertasche neben der Bank."
            )

            print()
            text_ausgeben(
                "[Tomas] Behalten muss ich sie nicht."
            )

            text_ausgeben(
                "[Tomas] Aber wenn du schon dort draußen "
                "herumstöberst, kannst du hiermit vielleicht "
                "mehr anfangen."
            )

            if item_besitzt(
                "alte_wegmarke"
            ):
                item_entfernen(
                    "alte_wegmarke"
                )

            if not item_besitzt(
                "altes_kartenstueck"
            ):
                item_hinzufuegen(
                    "altes_kartenstueck"
                )

            wald_fund_setzen(
                "alte_wegmarke_tomas_gezeigt"
            )

            wald_fund_setzen(
                "altes_kartenstueck_erhalten"
            )

            besonderen_fund_dokumentieren(
                "alte_wegmarke",
                "erkannt"
            )

            besonderen_fund_dokumentieren(
                "altes_kartenstueck",
                "erhalten"
            )

            print()

            design_text(
                "Alte Wegmarke abgegeben",
                design="wissen",
                art="menue"
            )

            design_text(
                "Altes Kartenstück erhalten",
                design="positiv",
                art="menue"
            )

            print()
            text_ausgeben(
                "Auf dem vergilbten Stück erkennst du "
                "einige alte Linien und Markierungen."
            )

            text_ausgeben(
                "Ohne den Rest der Karte kannst du "
                "sie noch nicht einordnen."
            )

            besonderen_fund_hinweis_anzeigen(
                "altes_kartenstueck"
            )


            warte_auf_taste(
                "Weiter"
            )

        elif aktion == "ende":
            direkte_besuche = npc_status(
                "tomas"
            ).get(
                "direkte_besuche",
                0
            )

            if spieler["lebenspunkte"] <= 50:
                abschied = npc_variante_waehlen(
                    "tomas",
                    "letzter_abschied_verletzt",
                    [
                        (
                            "[Tomas] Und jetzt suchst du dir "
                            "einen ruhigen Platz."
                        ),
                        (
                            "[Tomas] Der Wald läuft dir nicht weg.\n"
                            "[Tomas] Hoffentlich."
                        ),
                        (
                            "[Tomas] Pass auf dich auf.\n"
                            "[Tomas] Alte Geschichten brauche ich genug. "
                            "Du musst nicht gleich eine werden."
                        )
                    ]
                )

            elif direkte_besuche >= 5:
                abschied = npc_variante_waehlen(
                    "tomas",
                    "letzter_abschied_dauerbesuch",
                    [
                        "[Tomas] Bis gleich, nehme ich an.",
                        (
                            "[Tomas] Ich bleibe einfach sitzen.\n"
                            "[Tomas] Spart Zeit, wenn du wiederkommst."
                        ),
                        "[Tomas] Du kennst den Weg zur Bank."
                    ]
                )

            else:
                abschied = npc_variante_waehlen(
                    "tomas",
                    "letzter_abschied_normal",
                    [
                        "[Tomas] Bis später.",
                        "[Tomas] Gute Wege.",
                        "[Tomas] Pass auf dich auf.",
                        "[Tomas] Komm wieder vorbei."
                    ]
                )

            for zeile in abschied.split("\n"):
                if zeile:
                    text_ausgeben(
                        zeile
                    )
                else:
                    print()

            warte_auf_taste(
                "Weiter"
            )

            return

def wegstation_status():
    status = spieler.setdefault(
        "wegstation_status",
        {}
    )

    status.setdefault(
        "entdeckt",
        False
    )

    status.setdefault(
        "aktueller_raum",
        "vorhof"
    )

    status.setdefault(
        "besuchte_raeume",
        []
    )

    status.setdefault(
        "abkuerzungen",
        []
    )

    status.setdefault(
        "funde",
        {}
    )

    status.setdefault(
        "varianten",
        {}
    )

    return status

def wegstation_varianten_initialisieren():
    status = wegstation_status()

    varianten = status[
        "varianten"
    ]

    if "wachraum" not in varianten:
        varianten[
            "wachraum"
        ] = random.choice(
            [
                "muenzen",
                "heiltrank",
                "frische_spuren",
                "leer"
            ]
        )

    if "schreibstube" not in varianten:
        varianten[
            "schreibstube"
        ] = random.choice(
            [
                "eingestuerztes_regal",
                "vogelnest",
                "persoenliche_notiz",
                "ratten"
            ]
        )

    if "keller" not in varianten:
        varianten[
            "keller"
        ] = random.choice(
            [
                "bandit",
                "wolf",
                "morsche_treppe",
                "frische_spuren"
            ]
        )

    return varianten

def wegstation_raum_betreten(raum_id):
    if raum_id not in WEGSTATION_RAEUME:
        return False

    status = wegstation_status()

    status[
        "aktueller_raum"
    ] = raum_id

    besuchte_raeume = status[
        "besuchte_raeume"
    ]

    erstmals = (
        raum_id not in besuchte_raeume
    )

    if erstmals:
        besuchte_raeume.append(
            raum_id
        )

    return erstmals

def wegstation_wachraum_untersuchen():
    status = wegstation_status()
    funde = status[
        "funde"
    ]

    if funde.get(
        "wachraum_untersucht",
        False
    ):
        return

    funde[
        "wachraum_untersucht"
    ] = True

    variante = status[
        "varianten"
    ].get(
        "wachraum"
    )

    ort_titel(
        "Alte Wegstation - Wachraum"
    )

    text_ausgeben(
        "Du untersuchst die alten Bänke, "
        "das zerbrochene Waffengestell und "
        "die Reste eines schmalen Schranks."
    )

    print()

    if variante == "muenzen":
        gold = random.randint(
            4,
            9
        )

        text_ausgeben(
            "Unter einer losen Bodenplatte "
            "entdeckst du einige alte Münzen."
        )

        spieler[
            "gold"
        ] += gold

        print()

        design_text(
            f"{gold} Gold gefunden",
            design="positiv",
            art="menue"
        )

    elif variante == "heiltrank":
        text_ausgeben(
            "Ganz hinten im Schrank steht noch "
            "eine kleine, versiegelte Glasflasche."
        )

        print()

        text_ausgeben(
            "Der Inhalt sieht erstaunlich "
            "brauchbar aus."
        )

        spieler[
            "heiltränke"
        ] += 1

        print()

        design_text(
            "1 Heiltrank gefunden",
            design="positiv",
            art="menue"
        )

    elif variante == "frische_spuren":
        text_ausgeben(
            "Zwischen dem alten Staub fallen dir "
            "mehrere deutlich frischere Spuren auf."
        )

        print()

        text_ausgeben(
            "Getrockneter Schlamm haftet an einer Bank."
        )

        text_ausgeben(
            "Daneben liegt ein Stück grobes Seil, "
            "das noch nicht lange hier liegen kann."
        )

        print()

        design_text(
            "Jemand war vor nicht allzu langer Zeit hier.",
            design="warnung",
            art="menue"
        )

        funde[
            "frische_spuren_wachraum"
        ] = True

    elif variante == "leer":
        text_ausgeben(
            "Du durchsuchst den Raum gründlich."
        )

        print()

        text_ausgeben(
            "Außer einem verrosteten Gürtelhaken "
            "und zerbrochenem Holz findest du nichts, "
            "das noch von Nutzen wäre."
        )

    warte_auf_taste(
        "Weiter"
    )

def wegstation_schreibstube_untersuchen():
    status = wegstation_status()
    funde = status[
        "funde"
    ]

    if funde.get(
        "stationsregister_gelesen",
        False
    ):
        return

    ort_titel(
        "Alte Wegstation - Schreibstube"
    )

    variante = status[
        "varianten"
    ].get(
        "schreibstube"
    )

    # -------------------------
    # ZUFÄLLIGES RAUMDETAIL
    # -------------------------

    if variante == "eingestuerztes_regal":
        text_ausgeben(
            "Ein schweres Regal ist irgendwann "
            "gegen einen der Schreibtische gestürzt."
        )

        text_ausgeben(
            "Zwischen zerbrochenen Brettern liegen "
            "vergilbte Papierfetzen."
        )

    elif variante == "vogelnest":
        text_ausgeben(
            "Im Rahmen eines zerbrochenen Fensters "
            "hat ein Vogel sein Nest gebaut."
        )

        text_ausgeben(
            "Zwischen Zweigen und trockenem Gras "
            "stecken kleine Fetzen alten Papiers."
        )

    elif variante == "persoenliche_notiz":
        text_ausgeben(
            "Unter einem der Tische findest du "
            "einen gefalteten Zettel."
        )

        print()

        print(
            '"Heute wieder zwei Reisende, '
            'die behaupteten, schon gestern hier gewesen zu sein."'
        )

        print(
            '"Ich erinnere mich an keinen von beiden."'
        )

        print()

        text_ausgeben(
            "Eine Unterschrift fehlt."
        )

        funde[
            "persoenliche_notiz"
        ] = True

    elif variante == "ratten":
        text_ausgeben(
            "Ein Rascheln kommt aus einem Stapel "
            "halb zerfressener Unterlagen."
        )

        print()

        text_ausgeben(
            "Mehrere kleine Tiere verschwinden "
            "durch einen Riss in der Wand."
        )

        text_ausgeben(
            "Ein großer Teil der Papiere ist "
            "nicht mehr lesbar."
        )

    print()

    # -------------------------
    # FESTER STORYFUND
    # -------------------------

    text_ausgeben(
        "In einer flachen Schublade findest du "
        "schließlich ein schweres, ledergebundenes Buch."
    )

    seite_wechseln(
        "Alte Wegstation - Schreibstube"
    )

    design_text(
        "REGISTER DER WEGSTATION",
        design="wissen",
        art="ereignis"
    )

    print()

    text_ausgeben(
        "Die Seiten enthalten Namen von Reisenden, "
        "Herkunftsorte, Ladungen und Reiseziele."
    )

    print()

    print("-" * 34)
    print()
    print("12. Tag")
    print()
    print("Ankunft:")
    print("Marek Voss - Letzthafen")
    print("2 Ballen Leinen")
    print("1 Kiste Werkzeug")
    print()
    print("Abreise:")
    print("Eichenruh")
    print()

    print("-" * 34)
    print()
    print("17. Tag")
    print()
    print("Ankunft:")
    print("________ - Letzthafen")
    print("4 Säcke Getreide")
    print()

    print("-" * 34)
    print()
    print("21. Tag")
    print()
    print("Ankunft:")
    print("...")
    print()
    print("Ziel:")
    print("...")
    print()

    text_ausgeben(
        "Unter dem letzten Eintrag wurde mit "
        "anderer Tinte ein Satz ergänzt."
    )

    print()

    design_text(
        '"Die Listen stimmen nicht mehr."',
        design="warnung",
        art="ereignis"
    )

    seite_wechseln(
        "Alte Wegstation - Schreibstube"
    )

    text_ausgeben(
        "Du blätterst noch einmal zurück."
    )

    text_ausgeben(
        "Die älteren Seiten sind sauber, ordentlich "
        "und beinahe lückenlos geführt."
    )

    print()

    text_ausgeben(
        "Erst gegen Ende beginnen Namen und Ziele "
        "aus den Aufzeichnungen zu verschwinden."
    )

    funde[
        "stationsregister_gelesen"
    ] = True

    akt1_lernerfahrung(
        "wegstation_register"
    )

    besonderen_fund_dokumentieren(
        "stationsregister",
        "gelesen"
    )

    print()

    print("-" * 34)

    design_text(
        "BESONDERER FUND",
        design="wissen",
        art="ereignis"
    )

    print()
    print(
        "Register der Wegstation"
    )

    print("-" * 34)

    warte_auf_taste(
        "Weiter"
    )

def wegstation_keller_untersuchen():
    status = wegstation_status()
    funde = status[
        "funde"
    ]

    if funde.get(
        "keller_untersucht",
        False
    ):
        return

    variante = status[
        "varianten"
    ].get(
        "keller"
    )

    ort_titel(
        "Alte Wegstation - Keller"
    )

    text_ausgeben(
        "Du gehst zwischen den schiefen Regalen weiter "
        "in den hinteren Teil des Kellers."
    )

    print()

    # -------------------------
    # VARIANTE: BANDIT
    # -------------------------

    if variante == "bandit":
        text_ausgeben(
            "Hinter einem der Regale bewegt sich plötzlich etwas."
        )

        print()

        text_ausgeben(
            "Ein Mann richtet sich aus einem notdürftigen Lager auf. "
            "Als er deine Waffe bemerkt, greift auch er nach seiner."
        )

        print()
        print("1. Dich dem Banditen stellen")
        print("2. Langsam zur Treppe zurückweichen")

        auswahl = eingabe_menu(
            1,
            2,
            sonder_tasten=()
        )

        if auswahl == 2:
            return

        print()

        kampf_ergebnis = kampf_starten(
            lebenspunkte=spieler["lebenspunkte"],
            heiltraenke=spieler["heiltränke"],
            waffe=spieler["waffe"],
            gegner_typ="Bandit"
        )

        spieler["lebenspunkte"] = (
            kampf_ergebnis["lebenspunkte"]
        )

        spieler["heiltränke"] = (
            kampf_ergebnis["heiltraenke"]
        )

        if kampf_ergebnis["gewonnen"]:
            spieler[
                "besiegte_gegner"
            ] += 1

            gefundenes_gold = random.randint(
                6,
                14
            )

            spieler[
                "gold"
            ] += gefundenes_gold

            print()

            design_text(
                f"{gefundenes_gold} Gold gefunden",
                design="positiv",
                art="menue"
            )

            funde[
                "keller_gefahr_aufgeloest"
            ] = True

        elif kampf_ergebnis["besiegt"]:
            print()
            print("Game Over")

            spieler[
                "spiel_laeuft"
            ] = False

            return

        else:
            return

    # -------------------------
    # VARIANTE: WOLF
    # -------------------------

    elif variante == "wolf":
        text_ausgeben(
            "Ein tiefes Knurren lässt dich stehen bleiben."
        )

        print()

        text_ausgeben(
            "Zwischen zwei umgestürzten Regalen steht ein Wolf. "
            "Durch einen Mauerriss hinter ihm fällt fahles Licht."
        )