    )
        
def joris_im_gasthaus():
    if spieler.get(
        "prolog_uebersprungen",
        False
    ):
        return False

    prolog_status = spieler.get(
        "prolog_status"
    )

    if prolog_status not in (
        "joris_gerettet",
        "koehlerei_lieferung",
        "prolog_abgeschlossen"
    ):
        return False

    daten = npc_status(
        "joris"
    )

    daten.setdefault(
        "ort",
        "gasthaus"
    )

    return daten.get(
        "ort"
    ) == "gasthaus"


def dialog_joris():
    joris_besuch = npc_besuch_starten(
        "joris"
    )

    erste_runde = True
    themen_dieses_gespraech = set()

    while True:
        ort_titel(
            "Gasthaus"
        )

        dialog_titel(
            "Joris"
        )

        if erste_runde:
            if not npc_reaktion_gezeigt(
                "joris",
                "erstes_gespraech_nach_rettung"
            ):
                text_ausgeben(
                    "Joris sitzt an einem der hinteren Tische. "
                    "Als er dich sieht, richtet er sich etwas auf."
                )

                print()

                text_ausgeben(
                    "[Joris] Ich schulde dir was."
                )

                text_ausgeben(
                    "[Joris] Ohne dich würde ich vermutlich noch immer "
                    "gegen diese verdammte Tür drücken."
                )

                npc_reaktion_markieren(
                    "joris",
                    "erstes_gespraech_nach_rettung"
                )

            else:
                begruessung = npc_begruessung_waehlen(
                    "joris",
                    [
                        "[Joris] Na? Wieder da?",
                        "[Joris] Noch eine Frage?",
                        "[Joris] Ich höre.",
                        (
                            "[Joris] Wenn du wieder wegen des Kellers fragst: "
                            "Ich habe leider immer noch keine bessere Erklärung."
                        ),
                        (
                            "[Joris] Mara meint, ich soll mich ausruhen. "
                            "Reden zählt hoffentlich nicht als Arbeit."
                        )
                    ]
                )

                text_ausgeben(
                    begruessung
                )

        else:
            text_ausgeben(
                "[Joris] Noch etwas?"
            )

        print()

        optionen = []

        if "keller" not in themen_dieses_gespraech:
            optionen.append(
                (
                    "keller",
                    dialog_option(
                        "joris",
                        "keller",
                        "Wie war es dort unten?"
                    )
                )
            )

        zeitgefuehl_bekannt = dialog_thema_bekannt(
            "joris",
            "zeitgefuehl"
        )

        if (
            "zeitgefuehl"
            not in themen_dieses_gespraech
            and (
                zeitgefuehl_bekannt
                or spieler_pruefung(
                    "ausdauer",
                    2
                )
            )
        ):
            optionen.append(
                (
                    "zeitgefuehl",
                    dialog_option(
                        "joris",
                        "zeitgefuehl",
                        "[Ausdauer] Dein Körper wirkt nicht, "
                        "als wärst du die ganze Nacht dort unten gewesen."
                    )
                )
            )

        if "bjorn" not in themen_dieses_gespraech:
            optionen.append(
                (
                    "bjorn",
                    dialog_option(
                        "joris",
                        "bjorn",
                        "Was sagt Bjorn zu der Sache?"
                    )
                )
            )

        optionen.append(
            (
                "ende",
                "Gespräch beenden"
            )
        )

        for nummer, (aktion, text) in enumerate(
            optionen,
            start=1
        ):
            print(
                f"{nummer}. {text}"
            )

        auswahl = eingabe_menu(
            1,
            len(optionen),
            sonder_tasten=()
        )

        aktion = optionen[
            auswahl - 1
        ][0]

        erste_runde = False

        if aktion != "ende":
            themen_dieses_gespraech.add(
                aktion
            )

        print()

        if aktion == "keller":
            schon_besprochen = dialog_thema_bekannt(
                "joris",
                "keller"
            )

            dialog_thema_markieren(
                "joris",
                "keller"
            )

            if not schon_besprochen:
                text_ausgeben(
                    "[Joris] Am Anfang war es nur dunkel."
                )

                text_ausgeben(
                    "[Joris] Dann wurde es irgendwann so still, "
                    "dass ich jeden Atemzug gezählt habe."
                )

                print()

                text_ausgeben(
                    "[Joris] Irgendwann war ich überzeugt, "
                    "dass draußen längst Nacht sein müsste."
                )

                text_ausgeben(
                    "[Joris] Dabei war kaum ein halber Vormittag vorbei."
                )

            else:
                text_ausgeben(
                    "[Joris] Ich kann dir nur sagen, "
                    "wie es sich angefühlt hat."
                )

                text_ausgeben(
                    "[Joris] Viel länger, als es gewesen sein kann."
                )

            warte_auf_taste(
                "Weiter"
            )

        elif aktion == "zeitgefuehl":
            schon_besprochen = dialog_thema_bekannt(
                "joris",
                "zeitgefuehl"
            )

            dialog_thema_markieren(
                "joris",
                "zeitgefuehl"
            )

            text_ausgeben(
                f'[{spieler["name"]}] '
                "Wenn du wirklich die ganze Nacht dort unten gewesen wärst, "
                "müsstest du viel erschöpfter sein."
            )

            print()

            if not schon_besprochen:
                text_ausgeben(
                    "Joris schaut an sich hinunter und bewegt langsam "
                    "die Finger seiner rechten Hand."
                )

                print()

                text_ausgeben(
                    "[Joris] Genau das verstehe ich nicht."
                )

                text_ausgeben(
                    "[Joris] Ich war hungrig. Durstig auch."
                )

                text_ausgeben(
                    "[Joris] Aber nicht so, wie nach einem ganzen Tag Arbeit."
                )

                print()

                text_ausgeben(
                    "[Joris] Mein Kopf sagt mir, ich war ewig dort unten."
                )

                text_ausgeben(
                    "[Joris] Mein Körper offenbar nicht."
                )

                print()

                design_text(
                    "Beobachtung: Joris' empfundenes Zeitgefühl passt "
                    "nicht zu seinem körperlichen Zustand.",
                    design="wissen",
                    art="menue"
                )

                akt1_lernerfahrung(
                    "joris_zeitgefuehl"
                )

            else:
                text_ausgeben(
                    "Joris nickt langsam."
                )

                print()

                text_ausgeben(