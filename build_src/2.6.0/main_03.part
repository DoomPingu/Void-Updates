def rueckkehr_hinweis_status(hinweis_id):
    if not isinstance(
        globals().get("spieler"),
        dict
    ):
        return None

    return spieler.get(
        "rueckkehr_hinweise",
        {}
    ).get(
        hinweis_id
    )


def rueckkehr_hinweis_offen(hinweis_id):
    return rueckkehr_hinweis_status(
        hinweis_id
    ) in (
        "neu",
        "offen"
    )


def rueckkehr_hinweis_aktivieren(hinweis_id):
    if hinweis_id not in RUECKKEHR_HINWEISE:
        return False

    hinweise = spieler.setdefault(
        "rueckkehr_hinweise",
        {}
    )

    if hinweise.get(
        hinweis_id
    ) in (
        "neu",
        "offen",
        "erledigt"
    ):
        return False

    hinweise[
        hinweis_id
    ] = "neu"

    return True


def rueckkehr_hinweis_erledigen(hinweis_id):
    hinweise = spieler.setdefault(
        "rueckkehr_hinweise",
        {}
    )

    if hinweis_id not in hinweise:
        return False

    hinweise[
        hinweis_id
    ] = "erledigt"

    return True


def rueckkehr_hinweise_offen_vorhanden():
    if not isinstance(
        globals().get("spieler"),
        dict
    ):
        return False

    return any(
        status in (
            "neu",
            "offen"
        )
        for status in spieler.get(
            "rueckkehr_hinweise",
            {}
        ).values()
    )


def rueckkehr_hinweise_pruefen():
    if not isinstance(
        globals().get("spieler"),
        dict
    ):
        return

    wegstation = spieler.get(
        "wegstation_status",
        {}
    )

    funde = wegstation.get(
        "funde",
        {}
    )

    karten_status = spieler.get(
        "besondere_funde",
        {}
    ).get(
        "altes_kartenstueck"
    )

    kartenstueck_bekannt = (
        item_besitzt(
            "altes_kartenstueck"
        )
        or karten_status in (
            "erhalten",
            "zugeordnet"
        )
    )

    if (
        funde.get(
            "archiv_untersucht",
            False
        )
        and kartenstueck_bekannt
        and not funde.get(
            "geheimraum_hinweis",
            False
        )
        and not wegstation.get(
            "geheimgang_offen",
            False
        )
    ):
        rueckkehr_hinweis_aktivieren(
            "wegstation_archiv_kartenstueck"
        )

    if (
        spieler.get(
            "waldwaechter_schwelle_erlebt",
            False
        )
        and spieler.get(
            "wald_fragment_gefunden",
            False
        )
        and not wald_fund_bekannt(
            "wegstein_nachhall"
        )
    ):
        rueckkehr_hinweis_aktivieren(
            "wegstein_nach_erwachen"
        )


def rueckkehr_hinweis_meldung_anzeigen():
    if not isinstance(
        globals().get("spieler"),
        dict
    ):
        return

    hinweise = spieler.get(
        "rueckkehr_hinweise",
        {}
    )

    for hinweis_id, status in hinweise.items():

        if status != "neu":
            continue

        daten = RUECKKEHR_HINWEISE.get(
            hinweis_id
        )

        if not daten:
            continue

        print("-" * 34)

        design_text(
            "NEUER GEDANKE",
            design="wissen",
            art="menue"
        )

        print()
        print(
            daten["text"]
        )

        print("-" * 34)
        print()

        hinweise[
            hinweis_id
        ] = "offen"

        return

def ort_titel(name):
    global TEXT_SKIP_AKTIV
    TEXT_SKIP_AKTIV = False

    if "spieler" in globals() and isinstance(spieler, dict):
        bildschirm_leeren = spieler.get(
            "bildschirm_leeren",
            STANDARD_EINSTELLUNGEN["bildschirm_leeren"]
        )
    else:
        bildschirm_leeren = STANDARD_EINSTELLUNGEN["bildschirm_leeren"]

    if bildschirm_leeren:
        os.system("cls" if os.name == "nt" else "clear")



    print("=" * 34)

    design_text(
        name.upper(),
        design="ort",
        art="menue"
    )

    print("=" * 34)
    print()

    rueckkehr_hinweis_meldung_anzeigen()

def spieler_name_formatieren(text):
    if not isinstance(
        globals().get("spieler"),
        dict
    ):
        return text

    name = spieler.get("name")

    if not name:
        return text

    name_text = f"[{name}]"

    if not text.startswith(name_text):
        return text

    farbe = spieler.get(
        "spieler_name_farbe",
        STANDARD_EINSTELLUNGEN[
            "spieler_name_farbe"
        ]
    )

    if (
        farbe == "standard"
        or not ANSI_STILE_AKTIV
        or farbe not in ANSI_STILE
    ):
        return text

    return (
        f"{ANSI_STILE[farbe]}"
        f"{name_text}"
        f"{ANSI_STILE['reset']}"
        f"{text[len(name_text):]}"
    )

