def seite_wechseln(
    ort=None,
    dialog=None
):
    global TEXT_SKIP_AKTIV

    warte_auf_taste(
        "Weiterlesen"
    )

    TEXT_SKIP_AKTIV = False

    if (
        isinstance(
            globals().get("spieler"),
            dict
        )
    ):
        bildschirm_leeren = spieler.get(
            "bildschirm_leeren",
            STANDARD_EINSTELLUNGEN[
                "bildschirm_leeren"
            ]
        )

    else:
        bildschirm_leeren = (
            STANDARD_EINSTELLUNGEN[
                "bildschirm_leeren"
            ]
        )

    if bildschirm_leeren:
        os.system(
            "cls" if os.name == "nt"
            else "clear"
        )

    else:
        print()
        print("=" * 34)
        print()

    if ort:
        print("=" * 34)

        design_text(
            ort.upper(),
            design="ort",
            art="menue"
        )

        print("=" * 34)
        print()

    if dialog:
        dialog_titel(
            dialog
        )

def ort_nachricht_setzen(*zeilen):
    spieler["ort_nachricht"] = list(zeilen)


def ort_nachricht_anzeigen():
    nachricht = spieler.get("ort_nachricht")

    if not nachricht:
        return

    aktueller_ort = spieler.get("ort")

    schon_besucht = (
        aktueller_ort in spieler.get("besuchte_orte", [])
    )

    if schon_besucht:
        text_art = "menue"
    else:
        text_art = "atmosphaere"

    for zeile in nachricht:
        text_ausgeben(
            zeile,
            art=text_art
        )

    if (
        aktueller_ort
        and aktueller_ort not in spieler["besuchte_orte"]
    ):
        spieler["besuchte_orte"].append(aktueller_ort)

    spieler["ort_nachricht"] = None
    print()


def reise(
    ziel,
    *ankunft_zeilen,
    gebiet_modus=False
):
    start = spieler["ort"]
    strecke = frozenset((start, ziel))

    if strecke not in REISE_STRECKEN:
        print(
            "Für diese Strecke ist noch keine Verbindung festgelegt."
        )
        warte_auf_taste()
        return

    reise_daten = REISE_STRECKEN[
        strecke
    ]

    weg_id = reise_daten.get(
        "weg_id"
    )

    # -------------------------
    # VERTRAUTE ROUTE
    # -------------------------

    if (
        weg_id
        and reise_daten.get(
            "schnellreise",
            False
        )
        and routenkenntnis_bekannt(
            weg_id
        )
    ):
        reise_name = reise_daten.get(
            "name",
            reise_daten["gebiet"]
        )

        ort_titel(
            f"Reise - {reise_name}"
        )

        print(
            f"{start} → {ziel}"
        )

        print()

        design_text(
            "Vertraute Route",
            design="wissen",
            art="menue"
        )

        print()

        print(
            "Du kennst diese Strecke inzwischen gut genug, "
            "um sie ohne längere Erkundung zurückzulegen."
        )

        menue_trenner()

        print(
            "1. Normal reisen"
        )

        print(
            "2. Strecke zügig zurücklegen"
        )

        print(
            "3. Zurück"
        )

        reise_auswahl = eingabe_menu(
            1,
            3,
            sonder_tasten=()
        )

        if reise_auswahl == 3:
            return

        # -------------------------
        # ZÜGIG REISEN
        # -------------------------

        if reise_auswahl == 2:

            # Zeit vergeht trotzdem.
            if reise_daten[
                "gebiet"
            ] in (
                "Wald",
                "Waldweg"
            ):
                ressourcen_vorkommen_regenerieren(
                    "wald_holz",
                    reise_daten[
                        "schritte"
                    ]
                )

            if not status_schritte_abschliessen(
                reise_daten[
                    "schritte"
                ]
            ):
                return

            spieler[
                "reise"
            ] = None

            spieler[
                "ort"
            ] = ziel

            ort_nachricht_setzen(
                (
                    f"Du folgst den vertrauten Markierungen auf dem "
                    f"{reise_name} und vermeidest unnötige Umwege."
                ),
                *ankunft_zeilen
            )

            return

    # -------------------------
    # NORMALE REISE
    # -------------------------

    spieler["reise"] = {
        "start": start,
        "ziel": ziel,
        "gebiet": reise_daten[
            "gebiet"
        ],

        "name": reise_daten.get(
            "name",
            reise_daten["gebiet"]
        ),

        "weg_id": reise_daten.get(
            "weg_id"
        ),

        "gesamt_schritte": reise_daten[
            "schritte"
        ],

        "aktueller_schritt": 0,

        "ausgeloeste_ereignisse": [],

        "angebotene_abzweigungen": [],

        "zufallsereignisse": reise_daten.get(
            "zufallsereignisse",
            True
        ),

        "ankunft_zeilen": list(
            ankunft_zeilen
        )
    }

    if gebiet_modus:
        spieler[
            "ort"
        ] = reise_daten[
            "gebiet"
        ]

        if (
            start == "Eichenruh"
            and ziel == "Köhlerei"
            and spieler.get(
                "quest_hilda"
            ) == "aktiv"
        ):
            ort_nachricht_setzen(
                "Du lässt Eichenruh hinter dir und folgst erneut "
                "dem Waldweg zur Köhlerei.",
                "Diesmal achtest du weniger auf das Ziel als auf "
                "Spuren am Wegesrand.",
                "Irgendwo auf dieser Strecke hätte Hildas Händler "
                "vorbeikommen müssen."
            )

        elif (
            start == "Eichenruh"
            and ziel == "Letzthafen"
            and spieler.get(
                "quest_ein_name_fehlt"
            ) == "letzthafen_suchen"
        ):
            ort_nachricht_setzen(
                "Du verlässt den Marktplatz über die breite Straße "
                "nach Osten.",
                "Unter Gras und Erde tauchen die alten Pflastersteine "
                "des Königsrings auf.",
                "Im Fahrtenbuch stehen nur wenige brauchbare Worte: "
                "Klippen. Hafen. Mehr hast du im Moment nicht."
            )

        elif (
            start == "Eichenruh"
            and ziel == "verlassenes_dorf"
            and spieler.get(
                "quest_schmied"
            ) == "suche_verlassenes_dorf"
        ):
            ort_nachricht_setzen(
                "Du verlässt Eichenruh nach Süden und folgst dem Weg "
                "zwischen den Feldern.",
                "Bjorns Beschreibung ist knapp: ein alter Waldweg, "
                "ein vergessenes Dorf und irgendwo darin eine Schmiede.",
                "Vor dir liegt der Pfad des Vergessens."
            )

        elif (
            start == "verlassenes_dorf"
            and ziel == "Eichenruh"
            and spieler.get(
                "quest_schmied"
            ) == "hammer_gefunden"
        ):
            ort_nachricht_setzen(
                "Du lässt die stillen Häuser des verlassenen Dorfes hinter dir.",
                "Der alte Schmiedehammer liegt sorgfältig eingewickelt "
                "in deinem Gepäck.",
                "Bjorn war derjenige, der die Geschichte kannte. "
                "Jetzt kannst du ihm zeigen, dass sie wahr war."
            )

        else:
            ort_nachricht_setzen(
                f"Du lässt {reise_ort_name(start)} hinter dir "
                "und machst dich auf den Weg.",
                f"Vor dir liegt die Strecke in Richtung "
                f"{reise_ort_name(ziel)}."
            )

        return

    reise_fortsetzen()

def reise_strecken_daten(reise_daten):
    if not isinstance(
        reise_daten,
        dict
    ):
        return {}

    start = reise_daten.get(
        "start"
    )

    ziel = reise_daten.get(
        "ziel"
    )

    if not start or not ziel:
        return {}

    strecke = frozenset(
        (start, ziel)
    )

    return REISE_STRECKEN.get(
        strecke,
        {}
    )


def status_effekte_aktiv():
    return spieler.setdefault(
        "status_effekte",
        {}
    )


def status_aktiv(status_id):
    return status_id in status_effekte_aktiv()


def status_hinzufuegen(
    status_id,
    dauer=None,
    einheit=None,
    stapel=1,
    quelle=None,
    meldung=True
):
    definition = STATUS_EFFEKTE.get(
        status_id
    )

    if not definition:
        return False

    if dauer is None:
        dauer = definition.get(
            "standard_dauer"
        )

    if einheit is None:
        einheit = definition.get(
            "standard_einheit"
        )

    if (
        dauer is not None
        and (
            isinstance(dauer, bool)
            or not isinstance(
                dauer,
                (int, float)
            )
            or dauer <= 0
        )
    ):
        return False

    if (
        isinstance(stapel, bool)
        or not isinstance(stapel, int)
        or stapel <= 0
    ):
        return False

    aktive = status_effekte_aktiv()

    vorhanden = aktive.get(
        status_id
    )

    if vorhanden: