        basis_ordner(),
        f"void_save_{slot}.json"
    )

def alten_spielstand_importieren():
    if not os.path.exists(
        ALTE_SPEICHER_DATEI
    ):
        return None

    for slot in range(
        1,
        ANZAHL_SPEICHER_SLOTS + 1
    ):
        neue_datei = (
            speicherdatei_pfad(
                slot
            )
        )

        if os.path.exists(
            neue_datei
        ):
            continue

        try:
            os.replace(
                ALTE_SPEICHER_DATEI,
                neue_datei
            )

        except OSError:
            return None

        return slot

    return None

EINSTELLUNGS_DATEI = os.path.join(
    basis_ordner(),
    "void_settings.json"
)

SAVE_VERSION = 2
MIN_SAVE_VERSION = 1


def einstellungen_laden():
    if not os.path.exists(
        EINSTELLUNGS_DATEI
    ):
        return False

    try:
        with open(
            EINSTELLUNGS_DATEI,
            "r",
            encoding="utf-8"
        ) as datei:
            daten = json.load(
                datei
            )

        if not isinstance(
            daten,
            dict
        ):
            return False

    except (
        OSError,
        json.JSONDecodeError
    ):
        return False

    textgeschwindigkeit = daten.get(
        "textgeschwindigkeit"
    )

    if textgeschwindigkeit in TEXT_FAKTOREN:
        STANDARD_EINSTELLUNGEN[
            "textgeschwindigkeit"
        ] = textgeschwindigkeit

    menue_eingabe = daten.get(
        "menue_eingabe"
    )

    if menue_eingabe in (
        "enter",
        "direkt"
    ):
        STANDARD_EINSTELLUNGEN[
            "menue_eingabe"
        ] = menue_eingabe

    bildschirm_leeren = daten.get(
        "bildschirm_leeren"
    )

    if isinstance(
        bildschirm_leeren,
        bool
    ):
        STANDARD_EINSTELLUNGEN[
            "bildschirm_leeren"
        ] = bildschirm_leeren

    spieler_name_farbe = daten.get(
        "spieler_name_farbe"
    )

    if spieler_name_farbe in (
        "standard",
        "blau",
        "cyan",
        "gruen",
        "gelb",
        "lila",
        "rot",
        "schwarz"
    ):
        STANDARD_EINSTELLUNGEN[
            "spieler_name_farbe"
        ] = spieler_name_farbe

    return True


def einstellungen_speichern(
    einstellungen
):
    daten = {
        "textgeschwindigkeit": einstellungen.get(
            "textgeschwindigkeit",
            STANDARD_EINSTELLUNGEN[
                "textgeschwindigkeit"
            ]
        ),

        "menue_eingabe": einstellungen.get(
            "menue_eingabe",
            STANDARD_EINSTELLUNGEN[
                "menue_eingabe"
            ]
        ),

        "bildschirm_leeren": einstellungen.get(
            "bildschirm_leeren",
            STANDARD_EINSTELLUNGEN[
                "bildschirm_leeren"
            ]
        ),

        "spieler_name_farbe": einstellungen.get(
            "spieler_name_farbe",
            STANDARD_EINSTELLUNGEN[
                "spieler_name_farbe"
            ]
        )
    }

    temp_datei = (
        EINSTELLUNGS_DATEI + ".tmp"
    )

    try:
        with open(
            temp_datei,
            "w",
            encoding="utf-8"
        ) as datei:
            json.dump(
                daten,
                datei,
                ensure_ascii=False,
                indent=4
            )

        os.replace(
            temp_datei,
            EINSTELLUNGS_DATEI
        )

    except (
        OSError,
        TypeError,
        ValueError
    ):
        if os.path.exists(
            temp_datei
        ):
            try:
                os.remove(
                    temp_datei
                )
            except OSError:
                pass

        return False

    return True

