        reise_daten
    )

    for abzweigung in strecken_daten.get(
        "abzweigungen",
        []
    ):
        abzweigung_id = abzweigung.get(
            "id"
        )

        if not abzweigung_id:
            continue

        richtung = (
            f'{reise_daten["start"]}>'
            f'{reise_daten["ziel"]}'
        )

        abzweigung_schritt = abzweigung.get(
            "schritt"
        )

        richtungs_schritte = abzweigung.get(
            "schritte",
            {}
        )

        if richtung in richtungs_schritte:
            abzweigung_schritt = (
                richtungs_schritte[richtung]
            )

        if abzweigung_schritt != schritt:
            continue

        if abzweigung_id in angebotene:
            continue

        if not reise_bedingung_erfuellt(
            abzweigung.get("bedingung")
        ):
            continue

        weg_id = abzweigung.get(
            "weg_id"
        )

        weg_status_aktuell = (
            weg_status(weg_id)
            if weg_id
            else None
        )

        if (
            weg_id
            and weg_status_aktuell
            == "unbekannt"
            and not reise_bedingung_erfuellt(
                abzweigung.get(
                    "entdeckungs_bedingung"
                )
            )
        ):
            continue

        if (
            weg_id
            and weg_status_aktuell
            == "entdeckt"
            and not erkundung
        ):
            continue

        if (
            erkundung
            and (
                not weg_id
                or weg_status(weg_id)
                != "entdeckt"
            )
        ):
            continue


        verfuegbar.append(
            abzweigung
        )

    if not verfuegbar:
        return False

    for abzweigung in verfuegbar:
        angebotene.append(
            abzweigung["id"]
        )

        print()

        hinweis = abzweigung.get(
            "hinweis"
        )

        if (
            hinweis
            and reise_bedingung_erfuellt(
                hinweis.get("bedingung")
            )
        ):
            titel = hinweis.get(
                "titel"
            )

            if titel:
                design_text(
                    titel,
                    design="wissen",
                    art="menue"
                )

                print()

            zeilen = hinweis.get(
                "text",
                []
            )

        else:
            weg_id = abzweigung.get(
                "weg_id"
            )

            if (
                weg_id
                and weg_status(weg_id)
                == "entdeckt"
            ):
                zeilen = abzweigung.get(
                    "bekannt_text",
                    abzweigung.get(
                        "text",
                        []
                    )
                )

            else:
                zeilen = abzweigung.get(
                    "text",
                    []
                )

        for nummer, zeile in enumerate(
            zeilen
        ):
            text_ausgeben(
                zeile
            )

            if nummer < len(zeilen) - 1:
                print()

    print()

    for nummer, abzweigung in enumerate(
        verfuegbar,
        start=1
    ):
        weg_id = abzweigung.get(
            "weg_id"
        )

        if (
            weg_id
            and weg_status(weg_id)
            == "unbekannt"
        ):
            weg_bemerken(
                weg_id
            )

        if (
            weg_id
            and weg_status(weg_id)
            == "entdeckt"
        ):
            option_text = abzweigung.get(
                "option_bekannt",
                abzweigung.get(
                    "option",
                    "Abzweigung untersuchen"
                )
            )

        else:
            option_text = abzweigung.get(
                "option",
                "Abzweigung untersuchen"
            )

        rueckkehr_hinweis = abzweigung.get(
            "rueckkehr_hinweis"
        )

        if (
            rueckkehr_hinweis
            and rueckkehr_hinweis_offen(
                rueckkehr_hinweis
            )
        ):
            option_text += " [!]"

        print(
            f"{nummer}. {option_text}"
        )

    weiter_option = len(
        verfuegbar
    ) + 1

    print(
        f"{weiter_option}. Weiter Richtung {ziel}"
    )

    auswahl = eingabe_menu(
        1,
        weiter_option,
        sonder_tasten=()
    )

    if auswahl == weiter_option:
        return False

    abzweigung = verfuegbar[
        auswahl - 1
    ]

    aktion = abzweigung.get(
        "aktion"
    )

    if aktion == "alter_seitenpfad":

        if weg_status(
            "alter_seitenpfad"
        ) != "entdeckt":

            weg_entdecken(
                "alter_seitenpfad"
            )

        else:
            weg_als_gesehen_markieren(
                "alter_seitenpfad"
            )

        wald_seitenpfad_navigieren()

        ort_titel(
            f'Reise - {reise_daten.get(
                "name",
                reise_daten["gebiet"]
            )}'
        )

        print(
            f'{reise_daten["start"]} → '
            f'{reise_daten["ziel"]}'
        )

        menue_trenner()

        text_ausgeben(
            "Du kehrst auf den Hauptweg zurück.",
            art="menue"
        )

        return False

    spieler[
        "ort"
    ] = abzweigung["ziel"]

    ort_nachricht_setzen(
        *abzweigung.get(
            "ankunft_zeilen",
            []
        )
    )

    return True

def reise_ort_name(ort):
    sonder_namen = {
        "verlassenes_dorf": "Verlassenes Dorf"
    }

    if ort in sonder_namen:
        return sonder_namen[ort]

    return str(
        ort
    ).replace(
        "_",
        " "
    ).title()

def reise_aktiv():
    return isinstance(
        spieler.get(
            "reise"
        ),
        dict
    )


def reise_bildschirm_titel(
    zusatz=None
):
    reise_daten = spieler.get(
        "reise"
    )

    if not isinstance(
        reise_daten,
        dict
    ):
        name = "Reise"

    else:
        name = reise_daten.get(
            "name"
        )

        if not name:
            name = reise_daten.get(
                "gebiet",
                "Reise"
            )

    if zusatz:
        return (
            f"{name} - {zusatz}"
        )

    return name

def reise_umkehren():
    reise_daten = spieler.get(
        "reise"
    )

    if not isinstance(
        reise_daten,
        dict
    ):
        return False

    start = reise_daten[
        "start"
    ]

    ziel = reise_daten[
        "ziel"
    ]

    gesamt_schritte = reise_daten[
        "gesamt_schritte"
    ]

    aktueller_schritt = reise_daten[
        "aktueller_schritt"
    ]

    start_name = reise_ort_name(
        start
    )

    ziel_name = reise_ort_name(
        ziel
    )

    ort_titel(
        "Reise umkehren"
    )

    print(
        f"Aktuelles Ziel: {ziel_name}"
    )

    print(
        f"Zurück nach: {start_name}"
    )

    print(
        f"Position: "
        f"{aktueller_schritt}/"
        f"{gesamt_schritte}"
    )

    menue_trenner()

    print(
        "1. Umkehren"
    )

    print(
        f"2. Weiter Richtung "
        f"{ziel_name}"
    )

    auswahl = eingabe_menu(
        1,
        2,
        sonder_tasten=()
    )

    if auswahl == 2:
        return False

    ankunft_texte = (
        reise_daten.setdefault(
            "ankunft_texte",
            {}
        )
    )

    ankunft_texte.setdefault(
        ziel,
        list(
            reise_daten.get(
                "ankunft_zeilen",
                []
            )
        )
    )

    ankunft_texte.setdefault(
        start,
        [
            (
                f"Du erreichst wieder "
                f"{start_name}."
            )
        ]
    )

    # Noch keinen Schritt gegangen:
    # direkt zum Ausgangsort zurück.
    if aktueller_schritt <= 0:
        spieler[
            "reise"
        ] = None

        spieler[
            "ort"
        ] = start

        ort_nachricht_setzen(
            "Du entscheidest dich umzukehren.",
            (
                f"Du kehrst nach "
                f"{start_name} zurück."
            )
        )

        return True

    # Richtung wechseln.
    reise_daten[
        "start"
    ] = ziel

    reise_daten[
        "ziel"
    ] = start

    # Position auf derselben Strecke spiegeln.
    reise_daten[
        "aktueller_schritt"
    ] = (
        gesamt_schritte
        - aktueller_schritt
    )

    # Abzweigungen dürfen auf dem Rückweg
    # erneut angeboten werden.
    reise_daten[
        "angebotene_abzweigungen"
    ] = []

    reise_daten[
        "ankunft_zeilen"
    ] = list(
        ankunft_texte[
            start
        ]
    )

    ort_nachricht_setzen(
        "Du bleibst stehen und kehrst um.",
        (
            f"Du gehst nun zurück in "
            f"Richtung {start_name}."
        )
    )

    return True

def reise_kampfbegegnung_pruefen(
    reise_daten
):
    strecken_daten = (
        reise_strecken_daten(
            reise_daten
        )
    )

    kampf_daten = (
        strecken_daten.get(
            "kampfbegegnungen",
            {}
        )
    )

    if not isinstance(
        kampf_daten,
        dict
    ):
        return False

    if (
        spieler.get(
            "prolog_rueckweg_sicher",
            False
        )
        and reise_daten.get(
            "start"
        ) == "Köhlerei"
        and reise_daten.get(
            "ziel"
        ) == "Eichenruh"
    ):
        return False

    if not kampf_daten.get(
        "aktiv",
        False
    ):
        return False

    # Der ruhige Prolog bleibt kampffrei.
    if (
        kampf_daten.get(
            "erst_nach_prolog",
            False
        )
        and spieler.get(
            "prolog_status"
        ) != "prolog_abgeschlossen"
    ):
        return False

    # Ohne Waffe keine zufällige
    # Kampfbegegnung starten.
    if not spieler.get(
        "waffe"
    ):
        return False

    kampf_status = (
        spieler.setdefault(
            "reise_kampf_status",
            {}
        )
    )

    kampf_status.setdefault(
        "schritte_ohne_kampf",
        0
    )

    kampf_status.setdefault(
        "cooldown",
        0
    )

    # Nach einem Kampf einige Schritte Ruhe.
    if kampf_status[
        "cooldown"
    ] > 0:
        kampf_status[
            "cooldown"
        ] -= 1

        return False

    kampf_status[
        "schritte_ohne_kampf"
    ] += 1

    chance = kampf_daten.get(
        "chance",
        0
    )

    garantie_nach = kampf_daten.get(
        "garantie_nach",
        0
    )

    zufall_trifft = (
        isinstance(
            chance,
            (int, float)
        )
        and random.random() < chance
    )

    garantie_trifft = (
        isinstance(
            garantie_nach,
            int
        )
        and garantie_nach > 0
        and kampf_status[
            "schritte_ohne_kampf"
        ] >= garantie_nach
    )

    if not (
        zufall_trifft
        or garantie_trifft
    ):
        return False

    kampf_status[
        "schritte_ohne_kampf"
    ] = 0

    kampf_status[
        "cooldown"
    ] = max(
        0,
        int(
            kampf_daten.get(
                "cooldown",
                0
            )
        )
    )

    ort_titel(
        "Wald - Begegnung"
    )

    text_ausgeben(
        "Ein Geräusch abseits des Weges "
        "lässt dich stehen bleiben."
    )

    print()

    text_ausgeben(
        "Etwas bewegt sich zwischen "
        "den Bäumen."
    )

    print()

    kampf_ergebnis = kampf_starten(
        lebenspunkte=spieler[
            "lebenspunkte"
        ],
        heiltraenke=spieler[
            "heiltränke"
        ],
        waffe=spieler[
            "waffe"
        ]
    )

    spieler[
        "lebenspunkte"
    ] = kampf_ergebnis[
        "lebenspunkte"
    ]

    spieler[
        "heiltränke"
    ] = kampf_ergebnis[
        "heiltraenke"
    ]

    if kampf_ergebnis.get(
        "gewonnen",
        False
    ):
        spieler[
            "besiegte_gegner"
        ] += 1

        gefundenes_gold = random.randint(
            6,
            14
        )

        spieler[
            "gold"
        ] += gefundenes_gold

        print()
        print("-" * 34)

        design_text(
            "KAMPF GEWONNEN",
            design="positiv",
            art="ereignis"
        )

        print()

        text_ausgeben(
            "Die unmittelbare Gefahr ist vorüber. "
            "Du kommst langsam wieder zu Atem.",
            art="menue"
        )

        print()

        design_text(
            f"Belohnung: {gefundenes_gold} Gold",
            design="positiv",
            art="menue"
        )

        print(
            f"Lebenspunkte: "
            f"{spieler['lebenspunkte']}"
        )

        print(
            f"Besiegte Gegner: "
            f"{spieler['besiegte_gegner']}"
        )

        print("-" * 34)

        warte_auf_taste(
            "Weiterreisen"
        )

    elif kampf_ergebnis.get(
        "besiegt",
        False
    ):
        print()

        design_text(
            "Game Over",
            design="gefahr",
            art="menue"
        )

        spieler[
            "spiel_laeuft"
        ] = False

    return True

def reise_fortsetzen():
    global TEXT_SKIP_AKTIV
    reise_daten = spieler.get("reise")

    if not reise_daten:
        return

    start = reise_daten["start"]
    ziel = reise_daten["ziel"]
    gebiet = reise_daten["gebiet"]
    gesamt_schritte = reise_daten["gesamt_schritte"]

    zufallsereignisse = reise_daten.get(
        "zufallsereignisse",
        True
    )

    reise_name = reise_daten.get(
        "name",
        gebiet
    )

    erster_angezeigter_schritt = True

    for schritt in range(
        reise_daten["aktueller_schritt"] + 1,
        gesamt_schritte + 1
    ):
        reise_daten["aktueller_schritt"] = schritt

        TEXT_SKIP_AKTIV = False

        reise_titel = (
            reise_name
            if reise_daten.get(
                "weg_id"
            )
            else gebiet
        )

        ort_titel(
            reise_titel
        )

        if erster_angezeigter_schritt:
            ort_nachricht_anzeigen()
            erster_angezeigter_schritt = False

        print(f"{start} → {ziel}")
        print()

        design_text(
            f"Schritt {schritt}/{gesamt_schritte}",
            design="wissen",
            art="menue"
        )

        menue_trenner()

        richtung = f"{start}>{ziel}"

        strecke = frozenset((start, ziel))

        schritt_texte = REISE_STRECKEN.get(
            strecke,
            {}
        ).get(
            "schritt_texte",
            {}
        ).get(
            richtung,
            []
        )

        print()

        if schritt - 1 < len(schritt_texte):
            text_ausgeben(
                schritt_texte[schritt - 1],
                art="atmosphaere"
            )

        else:
            text_ausgeben(
                f"Du folgst dem Weg weiter in Richtung {ziel}.",
                art="atmosphaere"
            )

        if reise_bekannte_abzweigung_vorhanden(
            reise_daten,
            schritt
        ):
            menue_trenner()

            print("1. Weitergehen")
            print("2. Umgebung erkunden [!]")

            schritt_auswahl = eingabe_menu(
                1,
                2,
                sonder_tasten=()
            )

            if schritt_auswahl == 2:
                if reise_abzweigungen_pruefen(
                    reise_daten,
                    schritt,
                    ziel,
                    erkundung=True
                ):
                    status_schritte_abschliessen()
                    return

                print()

                warte_auf_taste(
                    "Weitergehen"
                )

        else:
            warte_auf_taste(
                "Weitergehen"
            )

        if gebiet in (
            "Wald",
            "Waldweg"
        ):
            ressourcen_vorkommen_regenerieren(
                "wald_holz"
            )

        festes_ereignis = (
            reise_ereignisse_pruefen(
                reise_daten,
                schritt
            )
        )

        kampfbegegnung = False

        if not festes_ereignis:
            kampfbegegnung = (
                reise_kampfbegegnung_pruefen(
                    reise_daten
                )
            )

        if not spieler[
            "spiel_laeuft"
        ]:
            return


        if (
            zufallsereignisse
            and not festes_ereignis
            and not kampfbegegnung
        ):
            spieler["gold"], spieler["heiltränke"], spieler["diamanten"], \
            spieler["lebenspunkte"], spieler["spiel_laeuft"], \
            spieler["besiegte_gegner"], spieler["ort"] = zufallsereignis(
                spieler["gold"],
                spieler["heiltränke"],
                spieler["diamanten"],
                spieler["lebenspunkte"],
                spieler["spiel_laeuft"],
                spieler["besiegte_gegner"],
                spieler["ort"]
            )

            if not spieler["spiel_laeuft"]:
                return

            if spieler["fackel_dauer"] > 0:
                spieler["fackel_dauer"] -= 1

                if spieler["fackel_dauer"] == 0:
                    print()
                    print(
                        "Deine Fackel flackert ein letztes Mal auf "
                        "und erlischt."
                    )
            warte_auf_taste("Weiterreisen")


        if reise_abzweigungen_pruefen(
            reise_daten,
            schritt,
            ziel
        ):
            status_schritte_abschliessen()
            return

        if not status_schritte_abschliessen():
            return

        if schritt < gesamt_schritte:
            return


    ankunft_zeilen = reise_daten["ankunft_zeilen"]

    spieler["reise"] = None
    spieler["ort"] = ziel

    if (
        spieler.get(
            "prolog_rueckweg_sicher",
            False
        )
        and start == "Köhlerei"
        and ziel == "Eichenruh"
    ):
        spieler[
            "prolog_rueckweg_sicher"
        ] = False

    akt1_reise_lernerfahrung(
        start,
        ziel
    )

    ort_nachricht_setzen(
        *ankunft_zeilen
    )


def prolog_ort_besucht(ort_name):

    if spieler.get("prolog_status") != "dorf_freigeschaltet":