
            text_ausgeben(
                "Nichts im Raum wirkt verlassen. "
                "Alles hat seinen Platz, auch die Dinge, die längst "
                "nicht mehr gebraucht werden."
            )

            warte_auf_taste(
                "Zurück"
            )

        elif auswahl == 4:
            return


def letzthafen_altes_leuchtfeuer():
    erstmals = letzthafen_bereich_betreten(
        "altes_leuchtfeuer"
    )

    wiegenlied = letzthafen_status()[
        "wiegenlied"
    ]

    while True:
        ort_titel(
            "Altes Leuchtfeuer"
        )

        if erstmals:
            text_ausgeben(
                "Das alte Leuchtfeuer steht auf einem vorspringenden Teil "
                "der Klippe. Sein Mauerwerk ist vom Salz rau geworden."
            )

            text_ausgeben(
                "Hier draußen trifft der Wind ungebremst auf die Küste. "
                "Möwen stehen beinahe reglos darin, bevor sie sich wieder "
                "über den Rand der Klippe tragen lassen."
            )

            print()

            text_ausgeben(
                "Unter dir schlägt das Meer gegen dunklen Fels. Die Geräusche "
                "des Hafens erreichen den Vorsprung nur noch in einzelnen "
                "Rufen und dem fernen Anschlagen von Tauwerk."
            )

            text_ausgeben(
                "Auch heute dient das alte Bauwerk den Booten draußen auf dem "
                "Wasser noch als vertrauter Orientierungspunkt."
            )

            erstmals = False

        else:
            text_ausgeben(
                "Wind streicht um das alte Mauerwerk des Leuchtfeuers.",
                art="menue"
            )

        hauptquest_fertig = (
            spieler.get(
                "quest_ein_name_fehlt"
            ) == "abgeschlossen"
        )

        if (
            hauptquest_fertig
            and not wiegenlied.get(
                "melodie_gehoert",
                False
            )
        ):
            print()

            text_ausgeben(
                "Zwischen zwei Windstößen hörst du ein paar leise Töne, "
                "die nicht vom Meer kommen."
            )

            print()

            text_ausgeben(
                "Die Melodie wird vom Klippenweg herübergetragen. "
                "Keine Worte - nur dieselben wenigen Töne, die sich "
                "langsam wiederholen."
            )

            text_ausgeben(
                "Als der Wind dreht, verschwinden sie wieder zwischen "
                "Brandung und Möwenrufen."
            )

            wiegenlied[
                "melodie_gehoert"
            ] = True

        menue_trenner()

        if (
            hauptquest_fertig
            and not wiegenlied.get(
                "edda_haus_bekannt",
                False
            )
        ):
            print("1. Der Melodie folgen")
            print("2. Über die Klippen sehen")
            print("3. Zurück zum Klippenweg")

            auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            if auswahl == 1:
                ort_titel(
                    "Klippenweg"
                )

                text_ausgeben(
                    "Du gehst langsam zurück zwischen die Häuser und bleibst "
                    "stehen, sobald der Wind die Melodie verschluckt."
                )

                text_ausgeben(
                    "Ein paar Schritte weiter tauchen die Töne wieder auf - "
                    "diesmal deutlich näher."
                )

                print()

                text_ausgeben(
                    "Sie kommen aus einem schmalen Haus mit einer "
                    "verwitterten blauen Tür."
                )

                wiegenlied[
                    "edda_haus_bekannt"
                ] = True

                if spieler.get(
                    "quest_wiegenlied",
                    "nicht_entdeckt"
                ) == "nicht_entdeckt":
                    spieler[
                        "quest_wiegenlied"
                    ] = "edda_suchen"

                    quest_meldung(
                        "neu",
                        "Das stumme Wiegenlied",
                        "Finde heraus, wer in dem Haus mit der "
                        "verwitterten blauen Tür die wortlose "
                        "Melodie summt."
                    )

                warte_auf_taste(
                    "Weiter"
                )

                return

            elif auswahl == 2:
                ort_titel(
                    "Altes Leuchtfeuer"
                )

                text_ausgeben(
                    "Weit unter dir ziehen schmale Boote durch "
                    "das graue Wasser."
                )

                text_ausgeben(
                    "Von hier oben wirkt Letzthafen kleiner, "
                    "als es zwischen den engen Gassen erscheint."
                )

                warte_auf_taste(
                    "Zurück"
                )

            elif auswahl == 3:
                return

        else:
            print("1. Über die Klippen sehen")
            print("2. Zurück zum Klippenweg")

            auswahl = eingabe_menu(
                1,
                2,
                sonder_tasten=()
            )

            if auswahl == 1:
                ort_titel(
                    "Altes Leuchtfeuer"
                )

                text_ausgeben(
                    "Weit unter dir ziehen schmale Boote durch "
                    "das graue Wasser."
                )

                text_ausgeben(
                    "Von hier oben wirkt Letzthafen kleiner, "
                    "als es zwischen den engen Gassen erscheint."
                )

                warte_auf_taste(
                    "Zurück"
                )

            elif auswahl == 2:
                return

def letzthafen_klippenweg():
    while True:
        erstmals = letzthafen_bereich_betreten(
            "klippenweg"
        )

        ort_titel(
            "Klippenweg"
        )

        if erstmals:
            text_ausgeben(
                "Der Klippenweg steigt oberhalb des Hafens zwischen "
                "schmalen Wohnhäusern an."
            )

            text_ausgeben(
                "Der Wind findet hier jede Gasse. Wäsche schlägt an Leinen, "
                "lose Fensterläden klappern gegen dunkle Fassaden."
            )

            print()

            text_ausgeben(
                "Vor einigen Türen stehen Fischkisten, Werkzeug oder kleine "
                "Bänke. Aus einem offenen Fenster riecht es nach Suppe und Rauch."
            )

            text_ausgeben(
                "Zwei Nachbarn reichen sich über eine niedrige Mauer einen "
                "Korb mit geflickten Netzen, ohne ihr Gespräch zu unterbrechen."
            )

            print()

            text_ausgeben(
                "Weiter draußen wird die Bebauung dünner. Dort steht das "
                "alte Leuchtfeuer gegen den grauen Himmel."
            )

        else:
            text_ausgeben(
                "Wind zieht durch die engen Häuserreihen des "
                "Klippenwegs und trägt den Geruch des Meeres herauf.",
                art="menue"
            )

        daten = letzthafen_status()

        spuren = daten[
            "spuren"
        ]

        wiegenlied = daten[
            "wiegenlied"
        ]

        optionen = [
            (
                "Den Klippenweg entlanggehen",
                "entlanggehen"
            )
        ]

        if spuren.get(
            "marek_adresse_bekannt",
            False
        ):
            optionen.append(
                (
                    "Oberer Steg - Haus 14",
                    "haus_14"
                )
            )

        if wiegenlied.get(
            "edda_haus_bekannt",
            False
        ):
            if wiegenlied.get(
                "edda_getroffen",
                False
            ):
                edda_text = "Edda Rehns Haus"

            else:
                edda_text = (
                    "Haus mit der verwitterten blauen Tür"
                )

            if spieler.get(
                "quest_wiegenlied"
            ) in (
                "edda_suchen",
                "truhe_geoeffnet"
            ):
                edda_text += " [!]"

            optionen.append(
                (
                    edda_text,
                    "edda_haus"
                )
            )

        optionen.append(
            (
                "Zum alten Leuchtfeuer gehen",
                "leuchtfeuer"
            )
        )

        optionen.append(
            (
                "Zurück nach Letzthafen",
                "zurueck"
            )
        )

        menue_trenner()

        for nummer, (
            text,
            _aktion
        ) in enumerate(
            optionen,
            start=1
        ):
            print(
                f"{nummer}. {text}"
            )

        auswahl = eingabe_menu(
            1,
            len(optionen),
            sonder_tasten=()
        )

        aktion = optionen[
            auswahl - 1
        ][1]

        if aktion == "entlanggehen":
            ort_titel(
                "Klippenweg"
            )

            text_ausgeben(
                "Du gehst an dicht stehenden Wohnhäusern vorbei. "
                "Viele tragen nur eine Nummer, manche nicht einmal das."
            )

            text_ausgeben(
                "Durch offene Türen hörst du Geschirr, Gespräche und das "
                "Schaben von Werkzeug über Holz."
            )

            print()

            text_ausgeben(
                "Auf einer schmalen Treppe sitzt ein Kind und entwirrt eine "
                "Schnur, während aus dem Haus jemand nach ihm ruft."
            )

            text_ausgeben(
                "Ein paar Türen weiter wird eine Bank vor die Wand gezogen, "
                "damit der Wind sie nicht wieder über den Weg schiebt."
            )

            warte_auf_taste(
                "Zurück"
            )

        elif aktion == "haus_14":
            letzthafen_haus_14()

        elif aktion == "edda_haus":
            letzthafen_edda_haus()

        elif aktion == "leuchtfeuer":
            letzthafen_altes_leuchtfeuer()

        elif aktion == "zurueck":
            return

def letzthafen():
    while True:
        daten = letzthafen_status()

        ort_titel(
            "Letzthafen"
        )

        ort_nachricht_anzeigen()

        # -------------------------
        # ERSTER BESUCH
        # -------------------------

        if not daten["angekommen"]:

            text_ausgeben(
                "Kalter Wind treibt Nebel durch die engen Gassen "
                "zwischen dunklen Steinhäusern."
            )

            text_ausgeben(
                "Salz liegt auf Fensterläden und Mauerkanten. "
                "Von irgendwo unterhalb der Häuser dringt das Knarren "
                "von Tauwerk herauf."
            )

            print()

            text_ausgeben(
                "Weiter oben ragt ein alter Signalturm zwischen den "
                "Dächern hervor. Über seinem Eingang schaukelt eine "
                "Laterne mit der Aufschrift 'Zum letzten Licht'."
            )

            text_ausgeben(
                "Auf der anderen Seite der Straße steht ein breites "
                "Steingebäude mit beschrifteten Tafeln vor der Tür."
            )

            text_ausgeben(
                "Zwischen beiden führt eine lange Steintreppe "
                "hinunter zum Wasser."
            )

            print()

            text_ausgeben(
                "Ein Träger stellt zwei Kisten am Straßenrand ab, "
                "während eine Frau in einem kleinen Buch nachschlägt."
            )

            text_ausgeben(
                "[Frau] Zwei Kisten Tauwerk?"
            )

            text_ausgeben(
                "[Träger] Zwei. Die dritte kommt mit der Abendflut."
            )

            text_ausgeben(
                "Die Frau streicht eine Zeile durch und steckt das Buch "
                "wieder in ihren Mantel."
            )

            print()

            text_ausgeben(
                "Erst jetzt fällt dir auf, wie viele Menschen hier "
                "kleine Bücher, Listen oder gefaltete Zettel bei sich tragen."
            )

            text_ausgeben(
                "Niemand scheint dieser Gewohnheit besondere "
                "Beachtung zu schenken."
            )

            daten[
                "angekommen"
            ] = True

            # Hauptquest beim Erreichen von Letzthafen
            if spieler.get(
                "quest_ein_name_fehlt"
            ) == "letzthafen_suchen":

                spieler[
                    "quest_ein_name_fehlt"
                ] = "marek_spur_suchen"

                quest_meldung(
                    "update",
                    "Ein Name fehlt",
                    "Suche in Letzthafen nach Hinweisen "
                    "auf den verschwundenen Händler."
                )

        # -------------------------
        # SPÄTERE BESUCHE
        # -------------------------

        else:
            text_ausgeben(
                "Nebel zieht zwischen den Häusern. "
                "Vom Gezeitensteg dringen Möwenrufe "
                "und das Knarren von Tauwerk herauf.",
                art="menue"
            )

        menue_trenner()

        letztes_licht_text = "1. Zum letzten Licht"
        haus_listen_text = "2. Haus der Listen"
        gezeitensteg_text = "3. Gezeitensteg"
        namenstein_text = "4. Namenstein"
        klippenweg_text = "5. Klippenweg und Leuchtfeuer"

        quest_status = spieler.get(
            "quest_ein_name_fehlt"
        )

        spuren = daten[
            "spuren"
        ]

        if (
            quest_status == "marek_spur_suchen"
            and spuren.get(
                "sera_marek",
                False
            )
        ):
            gezeitensteg_text += " [!]"

        elif quest_status == "marek_identitaet_pruefen":
            haus_listen_text += " [!]"

        elif quest_status in (
            "elian_suchen",
            "marek_zu_elian_bringen",
            "marek_abschluss_gespraech"
        ):
            gezeitensteg_text += " [!]"

        wiegenlied = daten[
            "wiegenlied"
        ]

        wiegenlied_status = spieler.get(
            "quest_wiegenlied",
            "nicht_entdeckt"
        )

        if quest_status == "abgeschlossen":
            if (
                wiegenlied_status == "nicht_entdeckt"
                and not wiegenlied.get(
                    "edda_haus_bekannt",
                    False
                )
            ):
                klippenweg_text += " [!]"

            elif wiegenlied_status == "edda_suchen":
                klippenweg_text += " [!]"

            elif wiegenlied_status == "lied_rekonstruieren":
                if not wiegenlied.get(
                    "sera_hinweis",
                    False
                ):
                    letztes_licht_text += " [!]"

                if not wiegenlied.get(
                    "register_hinweis",
                    False
                ):
                    haus_listen_text += " [!]"

                if (
                    not wiegenlied.get(
                        "namenstein_hinweis",
                        False
                    )
                    and not wiegenlied.get(
                        "truhe_spuren_hinweis",
                        False
                    )
                ):
                    namenstein_text += " [!]"

            elif wiegenlied_status == "truhe_geoeffnet":
                klippenweg_text += " [!]"

        print(letztes_licht_text)
        print(haus_listen_text)
        print(gezeitensteg_text)
        print(namenstein_text)
        print(klippenweg_text)
        print("6. Zurück nach Eichenruh")

        print()

        print("[S] Status")
        print("[I] Inventar")
        print("[J] Questlog/Erfolge")
        print("[Q] Speichern / Menü")

        auswahl = eingabe_menu(
            1,
            6,
            sonder_tasten=(
                "s",
                "i",
                "j",
                "q"
            )
        )

        # -------------------------
        # ZUM LETZTEN LICHT
        # -------------------------

        if auswahl == 1:
            letzthafen_letztes_licht()

        # -------------------------
        # HAUS DER LISTEN
        # -------------------------

        elif auswahl == 2:
            letzthafen_haus_der_listen()

        # -------------------------
        # GEZEITENSTEG
        # -------------------------

        elif auswahl == 3:
            letzthafen_gezeitensteg()

        # -------------------------
        # NAMENSTEIN
        # -------------------------

        elif auswahl == 4:
            letzthafen_namenstein()

        # -------------------------
        # KLIPPENWEG
        # -------------------------

        elif auswahl == 5:
            letzthafen_klippenweg()

        # -------------------------
        # ZURÜCK NACH EICHENRUH
        # -------------------------

        elif auswahl == 6:
            reise(
                "Eichenruh",
                "Die vertrauten Dächer Eichenruhs "
                "erscheinen wieder vor dir.",
                gebiet_modus=True
            )

            return

        # -------------------------
        # STANDARDMENÜS
        # -------------------------

        elif auswahl == "s":
            status()

        elif auswahl == "i":
            inventar()

        elif auswahl == "j":
            questlog()

        elif auswahl == "q":
            spielmenue()

def wald_erforschung_status():
    daten = spieler.setdefault(
        "wald_erforschung",
        {}
    )

    daten.setdefault(
        "aktueller_knoten",
        None
    )

    daten.setdefault(
        "besuchte_knoten",
        []
    )

    daten.setdefault(
        "abkuerzungen",
        []
    )

    daten.setdefault(
        "funde",
        {}
    )

    return daten


def wald_knoten_name(knoten_id):
    if knoten_id == "hauptweg":
        return "Hauptweg"

    knoten = WALD_SEITENPFAD_KNOTEN.get(
        knoten_id
    )

    if not knoten:
        return knoten_id

    return knoten["name"]


def wald_knoten_betreten(knoten_id):
    if knoten_id not in WALD_SEITENPFAD_KNOTEN:
        return False

    daten = wald_erforschung_status()

    daten[
        "aktueller_knoten"
    ] = knoten_id

    besuchte_knoten = daten[
        "besuchte_knoten"
    ]

    erstmals = (
        knoten_id not in besuchte_knoten
    )

    if erstmals:
        besuchte_knoten.append(
            knoten_id
        )

    return erstmals


def wald_knoten_besucht(knoten_id):
    daten = wald_erforschung_status()

    return knoten_id in daten[
        "besuchte_knoten"
    ]

def wald_gebietskarte_anzeigen():
    daten = wald_erforschung_status()

    aktueller_knoten = daten.get(
        "aktueller_knoten"
    )

    besuchte_knoten = set(
        daten.get(
            "besuchte_knoten",
            []
        )
    )

    # -------------------------
    # SICHTBARKEIT
    # -------------------------

    def knoten_sichtbar(knoten_id):
        if knoten_id in besuchte_knoten:
            return True

        for besucht_id in besuchte_knoten:
            if knoten_id in wald_verbindungen(
                besucht_id
            ):
                return True

        return False

    # -------------------------
    # KARTENFELD
    # -------------------------

    def feld(knoten_id):
        if not knoten_sichtbar(
            knoten_id
        ):
            return None

        if knoten_id not in besuchte_knoten:
            return "[?]"

        name = WALD_SEITENPFAD_KARTENNAMEN[
            knoten_id
        ]

        if knoten_id == aktueller_knoten:
            return f">{name}<"

        return f"[{name}]"

    # -------------------------
    # ZEICHENBEREICH
    # -------------------------

    breite = 60
    hoehe = 13

    karte = [
        [" "] * breite
        for _ in range(hoehe)
    ]

    # -------------------------
    # VERBINDUNGSLINIEN
    # -------------------------

    def mittelpunkt(knoten_id):
        text = feld(
            knoten_id
        )

        if text is None:
            return None

        zeile, spalte = (
            WALD_SEITENPFAD_KARTENPOSITIONEN[
                knoten_id
            ]
        )

        return (
            zeile,
            spalte + len(text) // 2
        )

    def linie_setzen(
        zeile,
        spalte,
        zeichen
    ):
        if not (
            0 <= zeile < hoehe
            and 0 <= spalte < breite
        ):
            return

        if karte[zeile][spalte] == " ":
            karte[zeile][spalte] = zeichen

    def verbindung_zeichnen(
        start_id,
        ziel_id
    ):
        start = mittelpunkt(
            start_id
        )

        ziel = mittelpunkt(
            ziel_id
        )

        if (
            start is None
            or ziel is None
        ):
            return

        start_zeile, start_spalte = start
        ziel_zeile, ziel_spalte = ziel

        # Gleiche Höhe
        if start_zeile == ziel_zeile:
            von = min(
                start_spalte,
                ziel_spalte
            )

            bis = max(
                start_spalte,
                ziel_spalte
            )

            for spalte in range(
                von + 1,
                bis
            ):
                linie_setzen(
                    start_zeile,
                    spalte,
                    "─"
                )

            return

        # Gleiche Spalte
        if start_spalte == ziel_spalte:
            von = min(
                start_zeile,
                ziel_zeile
            )

            bis = max(
                start_zeile,
                ziel_zeile
            )

            for zeile in range(
                von + 1,
                bis
            ):
                linie_setzen(
                    zeile,
                    start_spalte,
                    "│"
                )

            return

        # Unterschiedliche Höhe und Spalte:
        # zuerst waagerecht, dann senkrecht.
        schritt = (
            1
            if ziel_spalte > start_spalte
            else -1
        )

        for spalte in range(
            start_spalte + schritt,
            ziel_spalte,
            schritt
        ):
            linie_setzen(
                start_zeile,
                spalte,
                "─"
            )

        schritt = (
            1
            if ziel_zeile > start_zeile
            else -1
        )

        for zeile in range(
            start_zeile + schritt,
            ziel_zeile,
            schritt
        ):
            linie_setzen(
                zeile,
                ziel_spalte,
                "│"
            )

    # Nur Verbindungen anzeigen,
    # die der Spieler bereits erkennen kann.
    gezeichnete_verbindungen = set()

    for start_id in besuchte_knoten:
        for ziel_id in wald_verbindungen(
            start_id
        ):
            if (
                start_id
                not in WALD_SEITENPFAD_KARTENPOSITIONEN
                or ziel_id
                not in WALD_SEITENPFAD_KARTENPOSITIONEN
            ):
                continue

            if not knoten_sichtbar(
                ziel_id
            ):
                continue

            verbindung = frozenset(
                (
                    start_id,
                    ziel_id
                )
            )

            if verbindung in gezeichnete_verbindungen: