                            angriffs_schaden_faktor = 1.10
                            parade_mod_diese_runde = -5
                            krit_mod_diese_runde = 20

                            if messer_oeffnung_aktiv:
                                angriffs_treffer_mod += 15
                                krit_mod_diese_runde += 20

                            aktion = "angriff"
                            aktion_gewaehlt = True
