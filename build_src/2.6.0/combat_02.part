                        )

                        if rest == 0:
                            print("3. Abstand halten [bereit]")
                        else:
                            einheit = (
                                "Runde"
                                if rest == 1
                                else "Runden"
                            )

                            print(
                                f"3. Abstand halten "
                                f"[noch {rest} {einheit}]"
                            )

                        print("4. Zurück")

                        angriffs_auswahl = kampf_eingabe(
                            ("1", "2", "3", "4")
                        )

                        if angriffs_auswahl == "1":
                            angriffs_name = "Schneller Stoß"
