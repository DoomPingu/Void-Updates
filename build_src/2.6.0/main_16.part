            )

            warte_auf_taste()
            return

        # Erst jetzt darf der Spieler hinaus
        elif auswahl == 4:
            spieler["prolog_status"] = "dorf_freigeschaltet"
            spieler["ort"] = "Eichenruh"

            ort_nachricht_setzen(
                "Du ziehst dich an, öffnest die Haustür "
                "und trittst hinaus.",
                "Kühle Morgenluft streicht über dein Gesicht.",
                "Der Geruch von Holzrauch und frischem Brot "
                "liegt zwischen den Häusern.",
                "Auf der Straße grüßt dich jemand im Vorbeigehen, "
                "ohne seinen Schritt zu verlangsamen.",
                "Vom Marktplatz dringen Stimmen herüber, "
                "während Bjorns Hammer irgendwo zwischen "
                "den Häusern weiter seinen gleichmäßigen Takt schlägt.",
                "Vor dir liegt Eichenruh."
            )

            return

def spielerhaus():
    ort_titel("Dein Haus")

    ort_nachricht_anzeigen()

    if spieler.get("prolog_status") in [
        "aufgewacht",
        "haus_erkundet"
    ]:
        prolog_haus()
        return

    menue_trenner()

    buecherregal_text = "1. Bücherregal anschauen"

    if (
        spieler.get(
            "quest_ein_name_fehlt"
        ) == "fahrtenbuch_untersuchen"
        and item_besitzt(
            "fahrtenbuch_haendler"
        )
    ):
        buecherregal_text += " [!]"

    elif (
        spieler.get(
            "quest_wiegenlied"
        ) == "abgeschlossen"
        and spieler.get(
            "quest_schmied"
        ) == "nicht_entdeckt"
    ):
        buecherregal_text += " [!]"

    print(buecherregal_text)
    print("2. Kochen")
    print("3. Inventar öffnen")
    print("4. Lager öffnen")
    print("5. Schlafen")
    print("6. Spiel speichern")
    print("7. Optionen")
    print("8. Speichern & Hauptmenü")
    print("9. Haus verlassen")

    haus_auswahl = eingabe_menu(
        1,
        9,
        sonder_tasten=()
    )

    if haus_auswahl == 1:
        if prolog_laeuft():
            ort_titel("Dein Haus")

            text_ausgeben(
                "Du trittst vor das alte Bücherregal."
            )

            text_ausgeben(
                "Zwischen abgegriffenen Büchern stehen kleine Erinnerungsstücke und allerlei Krimskrams."
            )

            text_ausgeben(
                "Im Moment hast du allerdings wenig Lust, dich in eines der alten Bücher zu vertiefen."
            )

            warte_auf_taste()

        else:
            buecherregal()

    elif haus_auswahl == 2:
        kochen()

    elif haus_auswahl == 4:
        print("Noch nicht verfügbar")
        warte_auf_taste()

    elif haus_auswahl == 3:
        inventar()

    elif haus_auswahl == 5:
        if spieler["lebenspunkte"] < 100:
            print()
            print("Du legst dich in dein Bett und ruhst dich eine Weile aus.")
            print("Du fühlst dich wieder vollständig erholt.")

            spieler["lebenspunkte"] = 100

            print("Deine Lebenspunkte wurden vollständig wiederhergestellt.")
        else:
            print("Du fühlst dich bereits vollständig erholt.")
        warte_auf_taste()

    elif haus_auswahl == 6:
        spiel_speichern(spieler)
        warte_auf_taste()

    elif haus_auswahl == 7:
        optionen()

    elif haus_auswahl == 8:
        if spiel_speichern(spieler):
            print()
            print("Du kehrst zum Hauptmenü zurück.")

            warte_auf_taste("Zum Hauptmenü")

            zum_hauptmenue()
            return

        else:
            warte_auf_taste()

    elif haus_auswahl == 9:
        spieler["ort"] = "Eichenruh"

        ort_nachricht_setzen(
            "Du trittst hinaus.",
            "Eichenruh... ein ruhiges kleines Dorf."
    )

