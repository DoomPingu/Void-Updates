            text_ausgeben(
                "Dazwischen hörst du Bjorns Hammer aus der Schmiede."
            )

            text_ausgeben(
                "Zwei schnelle Schläge. Eine kurze Pause. Dann wieder von vorn."
            )

            print()

            text_ausgeben(
                "Du kennst diese Geräusche so gut, "
