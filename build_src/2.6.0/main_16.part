
        auswahl = eingabe_menu(
            1,
            zurueck_nummer,
            sonder_tasten=()
        )

        if auswahl == zurueck_nummer:
            return

        rezept_id = gelernte_rezepte[
            auswahl - 1
        ]

        rezept = REZEPTE[
            rezept_id
        ]

        ort_titel(
            rezept["name"]
        )

        ergebnis_id = rezept[
            "ergebnis"
        ]

        heilung = ITEMS[
            ergebnis_id
        ].get(
            "heilung",
            0
        )

        print(
            f"Heilung: {heilung} HP"
        )

        print()
        print("Benötigte Zutaten:")
        print()

        for item_id, anzahl in rezept[
            "zutaten"
        ].items():

            vorhanden = item_anzahl(
                item_id
            )

            if vorhanden >= anzahl:
                status = "OK"

            else:
                fehlt = (
                    anzahl - vorhanden
                )

                status = (
                    f"Fehlt: {fehlt}"
                )

            print(
                f"- {ITEMS[item_id]['name']} "
                f"x{anzahl} "
                f"(Du hast: {vorhanden}) "
                f"[{status}]"
            )

        print()

        if not rezept_kann_gekocht_werden(
            rezept
        ):
            print(
                "Dir fehlen Zutaten für "
                "dieses Rezept."
            )

            warte_auf_taste()
            continue

        print("1. Zubereiten")
        print("2. Zurück")

        koch_auswahl = eingabe_menu(
            1,
            2,
            sonder_tasten=()
        )

        if koch_auswahl == 2:
            continue

        for item_id, anzahl in rezept[
            "zutaten"
        ].items():

            item_entfernen(
                item_id,
                anzahl
            )

        item_hinzufuegen(
            rezept["ergebnis"],
            rezept.get(
                "anzahl",
                1
            )
        )

        print()

        design_text(
            f"{rezept['name']} zubereitet",
            design="positiv",
            art="menue"
        )

        warte_auf_taste()

def spielmenue():
    while True:
        ort_titel(
            "Menü"
        )

        print(
            "1. Weiterspielen"
        )

        print(
            "2. Textverlauf"
        )

        print(
            "3. Questlog/Erfolge"
        )

        print(
            "4. Spiel speichern"
        )

        print(
            "5. Optionen"
        )

        print(
            "6. Speichern & Hauptmenü"
        )

        menue_auswahl = eingabe_menu(
            1,
            6,
            sonder_tasten=()
        )

        if menue_auswahl == 1:
            return

        elif menue_auswahl == 2:
            textverlauf_anzeigen()

        elif menue_auswahl == 3:
            questlog()

        elif menue_auswahl == 4:
            spiel_speichern(
                spieler
            )

            warte_auf_taste()

        elif menue_auswahl == 5:
            optionen()

        elif menue_auswahl == 6:
            if spiel_speichern(
                spieler
            ):
                print()

                print(
                    "Du kehrst zum Hauptmenü zurück."
                )

                warte_auf_taste(
                    "Zum Hauptmenü"
                )

                zum_hauptmenue()
                return

            else:
                warte_auf_taste()

def prolog_haus():
    prolog_status = spieler.get(
        "prolog_status",
        "dorf_freigeschaltet"
    )

    # -------------------------
    # STUFE 1: AUFGEWACHT
    # -------------------------

    if prolog_status == "aufgewacht":
        menue_trenner()

        print("1. Dich im Zimmer umsehen")

        print()
        print("[S] Status")
        print("[I] Inventar")
        print("[J] Questlog/Erfolge")
        print("[Q] Speichern / Menü")

        auswahl = eingabe_menu(
            1,
            1,
            sonder_tasten=("s", "i", "j", "q")
        )

        if auswahl == "s":
            status()
            return

        elif auswahl == "i":
            inventar()
            return

        elif auswahl == "j":
            questlog()
            return

        elif auswahl == "q":
            spielmenue()
            return

        elif auswahl == 1:
            print()

            text_ausgeben(
                "Du richtest dich auf und lässt den Blick durch das kleine Zimmer wandern."
            )

            text_ausgeben(
                "Die Decke liegt halb über dem Bettrand. "
                "Die Dielen darunter sind vom jahrelangen Gebrauch glatt geworden."
            )

            print()

            text_ausgeben(
                "In einer Ecke steht die alte Holztruhe, "
                "an deren Deckel sich das Holz an einer Stelle dunkel verfärbt hat."
            )

            text_ausgeben(
                "Daneben lehnt das Bücherregal ein wenig schief an der Wand. "
                "Einige Buchrücken sind vom Anfassen heller als die übrigen."
            )

            print()

            text_ausgeben(
                "Vom Fenster her fällt ein schmaler Streifen Morgenlicht auf den Boden. "
                "Darin tanzt feiner Staub, sobald draußen ein Wagen vorbeifährt."
            )

            print()

            warte_auf_taste()

            spieler["prolog_status"] = "haus_erkundet"

            return

    # -------------------------
    # STUFE 2: HAUS ERKUNDET
    # -------------------------

    elif prolog_status == "haus_erkundet":
        menue_trenner()

        print("1. Bücherregal ansehen")
        print("2. Alte Truhe untersuchen")
        print("3. Aus dem Fenster schauen")
        print("4. Haus verlassen")

        print()
        print("[S] Status")
        print("[I] Inventar")
        print("[J] Questlog/Erfolge")
        print("[Q] Speichern / Menü")

        auswahl = eingabe_menu(
            1,
            4,
            sonder_tasten=("s", "i", "j", "q")
        )

        if auswahl == "s":
            status()
            return

        elif auswahl == "i":
            inventar()
            return

        elif auswahl == "j":
            questlog()
            return

        elif auswahl == "q":
            spielmenue()
            return

        # Bücherregal
        elif auswahl == 1:
            print()

            text_ausgeben(
                "Du trittst vor das alte Bücherregal."
            )

            text_ausgeben(
                "Die Bretter haben sich unter dem Gewicht der Jahre "
                "leicht durchgebogen."
            )

            text_ausgeben(
                "Zwischen abgegriffenen Büchern stehen ein stumpfer "
                "Kerzenhalter, zwei glattgeschliffene Kiesel und eine "
                "kleine Holzschachtel, deren Scharnier schon lange klemmt."
            )

            print()

            text_ausgeben(
                "Einige Titel kennst du so gut, dass du sie kaum noch liest. "
