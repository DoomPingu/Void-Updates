            )

            print()
            text_ausgeben(
                "Dort ist heute kein Weg mehr zu erkennen."
            )


        elif ereignis == 8:
            print()
            text_ausgeben(
                "Ohne Vorwarnung erhebt sich ein Schwarm "
                "schwarzer Vögel aus den Baumkronen."
            )

            text_ausgeben(
                "Dutzende Flügel schlagen gleichzeitig "
