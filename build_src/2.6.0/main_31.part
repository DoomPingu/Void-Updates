
        optionen = [
            (
                "holz",
                "Nach trockenem Holz suchen"
            )
        ]

        if alter_seitenpfad_hier_verfuegbar():
            seitenpfad_status = weg_status(
                "alter_seitenpfad"
            )

            if seitenpfad_status == "bemerkt":
                optionen.append(
                    (
                        "seitenpfad",
                        "Nach dem bemerkten Seitenpfad suchen"
                    )
                )

            elif seitenpfad_status == "entdeckt":
                optionen.append(
                    (
                        "seitenpfad",
                        "Dem Alten Seitenpfad folgen"
                    )
                )

        for nummer, (_, text) in enumerate(
            optionen,
            start=1
        ):
            print(
                f"{nummer}. {text}"
            )

        zurueck_nummer = len(optionen) + 1

        print(
            f"{zurueck_nummer}. Zurück"
        )

        auswahl = eingabe_menu(
            1,
            zurueck_nummer,
            sonder_tasten=()
        )

        if auswahl == zurueck_nummer:
            return

        aktion = optionen[
            auswahl - 1
        ][0]

        if aktion == "holz":
            holz_sammeln()

        elif aktion == "seitenpfad":
            if weg_status(
                "alter_seitenpfad"
            ) == "entdeckt":
                weg_als_gesehen_markieren(
                    "alter_seitenpfad"
                )

                wald_abzweigung(
                    direkt=True
                )

                return

            wald_abzweigung()


def reise_rasten():
    while True:
        ort_titel(
            reise_bildschirm_titel(
                "Rasten"
            )
        )

        print(
            f"Lebenspunkte: "
            f"{spieler['lebenspunkte']}/100"
        )

        print(
            f"Holz: "
            f"{item_anzahl('holz')}"
        )

        print()
        print("1. Lagerfeuer errichten")
        print("2. Zurück")

        auswahl = eingabe_menu(
            1,
            2,
            sonder_tasten=()
        )

        if auswahl == 1:
            lagerfeuer()

        elif auswahl == 2:
            return


def reise_uebersicht():
    aktive_reise = spieler.get(
        "reise"
    )

    if not isinstance(
        aktive_reise,
        dict
    ):
        return

    ort_titel(
        reise_bildschirm_titel(
            "Reiseübersicht"
        )
    )   

    design_text(
        aktive_reise.get(
            "name",
            "Aktive Reise"
        ),
        design="wissen",
        art="menue"
    )

    print()

    print(
        f"Start: {aktive_reise['start']}"
    )

    print(
        f"Ziel: {aktive_reise['ziel']}"
    )

    print(
        f"Fortschritt: "
        f"{aktive_reise['aktueller_schritt']}/"
        f"{aktive_reise['gesamt_schritte']}"
    )

    menue_trenner()

    print("1. Zurück")

    eingabe_menu(
        1,
        1,
        sonder_tasten=()
    )

def hilda_karren_ereignis():
    if spieler.get(
        "quest_hilda"
    ) != "aktiv":
        return False

    ort_titel(
        "Wald - Verlassener Karren"
    )

    text_ausgeben(
        "Zwischen den vielen Fahrspuren fällt dir eine Rille auf, "
        "die in flachem Winkel vom Waldweg abweicht."
    )

    text_ausgeben(
        "Sie führt nur wenige Schritte zwischen die Bäume."
    )

    print()

    text_ausgeben(
        "Dort steht ein Handelskarren schief im weichen Boden."
    )

    text_ausgeben(
        "Die Zugtiere sind verschwunden, doch mehrere Kisten "
        "stehen noch immer auf der Ladefläche."
    )

    print()

    text_ausgeben(
        "Nichts daran sieht nach einem hastigen Überfall aus."
    )

    menue_trenner()

    print("1. Den Karren genauer untersuchen")
    print("2. Nach Spuren des Händlers suchen")

