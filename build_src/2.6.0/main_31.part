    ort_nachricht_setzen(
        "Du kehrst auf den Waldweg zurück.",
        "Der verlassene Karren bleibt zwischen den Bäumen zurück."
    )

    warte_auf_taste(
        "Zurück zum Waldweg"
    )

    return True

def zufallsereignis(gold, heiltränke, diamanten, lebenspunkte, spiel_laeuft, besiegte_gegner, ort):
    if spiel_laeuft:
        ereignis = random.randint(1, 8)
        if ereignis == 1:
            print()
            text_ausgeben(
                "Ein umgestürzter Baum versperrt den Waldweg."
            )

            text_ausgeben(
                "Die Wurzeln haben einen großen Teil der "
                "feuchten Erde mitgerissen."
            )

            print()
            print("1. Über den Stamm klettern")
            print("2. Einen Weg darum herum suchen")

            hindernis_auswahl = eingabe_menu(
                1,
                2,
                sonder_tasten=()
            )

            if hindernis_auswahl == 1:
                print()
                text_ausgeben(
                    "Du ziehst dich am rauen Stamm hinauf "
                    "und kletterst vorsichtig auf die andere Seite."
                )

                text_ausgeben(
                    "Ein paar lose Äste brechen unter deinen "
                    "Stiefeln, doch du kommst sicher hinüber."
                )

            elif hindernis_auswahl == 2:
                print()
                text_ausgeben(
                    "Du verlässt den Weg für einige Minuten "
                    "und suchst zwischen den Bäumen nach einer "
                    "passierbaren Stelle."
                )

                text_ausgeben(
                    "Nach einem kleinen Umweg erreichst du "
                    "den Waldweg wieder."
                )
        elif ereignis == 2:
            print()
            text_ausgeben(
                "Zwischen Farnen hörst du leise Wasser über "
                "Steine laufen."
            )

            text_ausgeben(
                "Wenige Schritte neben dem Weg tritt eine "
                "kleine Quelle zwischen den Wurzeln hervor."
            )

            if lebenspunkte < 100:
                print()
                text_ausgeben(
                    "Du wäschst dir Gesicht und Hände und "
                    "ruhst dich einen Moment am kühlen Wasser aus."
                )

                heilung = min(
                    random.randint(5, 10),
                    100 - lebenspunkte
                )

                lebenspunkte += heilung

                print()
                design_text(
                    f"Du regenerierst {heilung} Lebenspunkte.",
                    design="positiv",
                    art="menue"
                )

                print(
                    f"Lebenspunkte: {lebenspunkte}/100"
                )

            else:
                print()
                text_ausgeben(
                    "Du trinkst etwas von dem kalten Wasser "
                    "und setzt deinen Weg erfrischt fort."
                )

        elif ereignis == 3:
            print()
            print("Ein Gegner taucht auf!")

            kampf_ergebnis = kampf_starten(
                lebenspunkte=lebenspunkte,
                heiltraenke=heiltränke,
                waffe=spieler["waffe"]
            )

            lebenspunkte = kampf_ergebnis["lebenspunkte"]
            heiltränke = kampf_ergebnis["heiltraenke"]

            if kampf_ergebnis["gewonnen"]:
                gefundenes_gold = random.randint(10, 30)
                gold += gefundenes_gold
                besiegte_gegner += 1

                print()
                print(f"Du findest {gefundenes_gold} Gold.")

                if besiegte_gegner == 4:
                    print()
                    print("Du spürst eine mächtige Präsenz im Wald...")

            elif kampf_ergebnis["besiegt"]:
                print()
                print("Game Over")
                spiel_laeuft = False

        elif ereignis == 4:
            print()
            text_ausgeben(
                "Etwas abseits des Weges entdeckst du "
                "eine alte Raststelle."
            )

            text_ausgeben(
                "Zwischen zwei Bäumen liegt ein Kreis aus "
                "verrußten Steinen."
            )

            text_ausgeben(
                "Die Asche darin ist längst kalt."
            )

            print()
            print("1. Die Raststelle untersuchen")
            print("2. Weitergehen")

            rastplatz_auswahl = eingabe_menu(
                1,
                2,
                sonder_tasten=()
            )

            if rastplatz_auswahl == 1:
                rastplatz_fund = random.randint(
                    1,
                    3
                )

                if rastplatz_fund == 1:
                    gefundene_menge = random.randint(
                        1,
                        2
                    )

                    print()
                    text_ausgeben(
                        "Unter einer halb verrotteten Plane "
                        "findest du etwas trockenes Brennholz."
                    )

                    item_hinzufuegen(
                        "holz",
                        gefundene_menge
                    )

                    print()

                    design_text(
                        f"{gefundene_menge}x Holz gefunden",
                        design="positiv",
                        art="menue"
                    )

                elif rastplatz_fund == 2:
                    gefundenes_gold = random.randint(
                        3,
                        8
                    )

                    print()
                    text_ausgeben(
                        "Zwischen Laub und alten Stoffresten "
                        "entdeckst du einen kleinen Lederbeutel."
                    )

                    gold += gefundenes_gold

                    print()

                    design_text(
                        f"{gefundenes_gold} Gold gefunden",
                        design="positiv",
                        art="menue"
                    )

                elif rastplatz_fund == 3:
                    print()
                    text_ausgeben(
                        "Du findest einige alte Fußspuren, "
                        "verkohlte Zweige und einen zerbrochenen "
                        "Holzlöffel."
                    )

                    text_ausgeben(
                        "Wer hier gerastet hat, ist offenbar "
                        "schon vor längerer Zeit weitergezogen."
                    )

            elif rastplatz_auswahl == 2:
                print()
                text_ausgeben(
                    "Du lässt die verlassene Raststelle "
                    "hinter dir und bleibst auf dem Weg."
                )

        elif ereignis == 5:



            # -------------------------
            # VERLETZTER REISENDER
            # -------------------------

            if (
                spieler["reisender_status"]
                == "nicht_getroffen"
            ):
                print()
                text_ausgeben(
                    "Am Rand des Weges sitzt ein Mann "
                    "mit dem Rücken gegen einen Baum."
                )

                text_ausgeben(
                    "Sein Mantel ist an mehreren Stellen "
                    "zerrissen und eine Hand liegt fest "
                    "auf seiner Seite."
                )

                print()
                text_ausgeben(
                    "Als er deine Schritte hört, "
                    "hebt er langsam den Kopf."
                )

                print()
                print(
                    "1. Nachsehen, ob du helfen kannst"
                )

                print(
                    "2. Abstand halten und weitergehen"
                )

                reisender_auswahl = eingabe_menu(
                    1,
                    2,
                    sonder_tasten=()
                )

                if reisender_auswahl == 1:
                    ort_titel(
                        "Wald - Verletzter Reisender"
                    )

                    text_ausgeben(
                        "Du gehst vorsichtig zu ihm "
                        "und kniest dich neben den Baum."
                    )

                    text_ausgeben(
                        "Die Verletzung sieht schmerzhaft aus, "
                        "aber nicht lebensbedrohlich."
                    )

                    text_ausgeben(
                        "Du hilfst ihm vorsichtig auf die Beine."
                    )

                    warte_auf_taste(
                        "Weiter"
                    )

                    dialog_titel("???")

                    text_ausgeben(
                        "[???] Danke..."
                    )

                    text_ausgeben(
                        "[???] Ich dachte schon, hier kommt "
                        "niemand mehr vorbei."
                    )

                    warte_auf_taste(
                        "Weiter"
                    )

                    text_ausgeben(
                        "Er blickt den Waldweg hinunter."
                    )

                    print()

                    text_ausgeben(
                        "[???] Seltsam."
                    )

                    text_ausgeben(
                        "[???] Ich war sicher, dass ich diesen "
                        "Abschnitt schon hinter mir hatte."
                    )

                    print()

                    text_ausgeben(
                        "Für einen Moment wirkt er, als wolle "
                        "er noch etwas sagen."
                    )

                    text_ausgeben(
                        "Dann schüttelt er nur den Kopf."
                    )

                    spieler[
                        "reisender_status"
                    ] = "geholfen"

                elif reisender_auswahl == 2:
                    print()
                    text_ausgeben(
                        "Du bleibst auf Abstand."
                    )

                    text_ausgeben(
                        "Der Mann beobachtet dich, sagt aber nichts."
                    )

                    print()
                    text_ausgeben(
                        "Nach einigen Schritten verschwindet "
                        "er hinter den Bäumen."
                    )

                    spieler["reisender_status"] = "ignoriert"

            # -------------------------
