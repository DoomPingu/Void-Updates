            "und ordentlich gelöst an der Vorderseite."
        )

        print()

        text_ausgeben(
            "Jemand hat die Tiere ausgespannt."
        )

        print()
        text_ausgeben(
            "Danach siehst du dir den Boden rund um den Wagen an."
        )

        text_ausgeben(
            "Keine Blutspuren. Keine Kampfspuren. "
            "Keine Schleifspuren."
        )

        text_ausgeben(
            "Nur ein einzelner Satz Fußspuren führt vom Karren weg "
            "und verliert sich bald auf dem festen Waldboden."
        )

    elif auswahl == 2:
        text_ausgeben(
            "Du suchst den Boden rund um den Wagen ab."
        )

        print()

        text_ausgeben(
            "Keine Blutspuren. Keine Kampfspuren. "
            "Keine Schleifspuren."
        )

        text_ausgeben(
            "Ein einzelner Satz Fußspuren führt vom Karren weg "
            "und verliert sich bald auf dem festen Waldboden."
        )

        print()

        text_ausgeben(
            "Am Wagen selbst findest du ebenfalls nichts, "
            "was auf Gewalt hindeutet."
        )

        text_ausgeben(
            "Deichsel und Räder sind unbeschädigt. "
            "Die Lederriemen für die Zugtiere wurden sauber geöffnet."
        )

        text_ausgeben(
            "Jemand hat die Tiere ausgespannt, bevor er den Karren verließ."
        )

    print()

    text_ausgeben(
        "Auf einer der Kisten erkennst du das Zeichen "
        "von Hildas Marktstand."
    )

    text_ausgeben(
        "Der Wagen gehört zu der Lieferung, nach der sie sucht."
    )

    seite_wechseln(
        "Wald - Verlassener Karren"
    )

    text_ausgeben(
        "Unter dem Sitz des Kutschers steckt eine schmale Ledermappe."
    )

    text_ausgeben(
        "Darin liegt ein abgegriffenes Fahrtenbuch voller Lieferlisten, "
        "Entfernungen und kurzer Notizen."
    )

    print()

    text_ausgeben(
        "Die letzten Einträge unterscheiden sich deutlich vom Rest."
    )

    print()

    design_text(
        "Letzte Einträge",
        design="wissen",
        art="menue"
    )

    print()
    print(
        "12. des Monats"
    )

    print(
        "Eichenruh morgen vor Mittag. "
        "Hilda wartet auf die Stoffe."
    )

    print()
    print(
        "13. des Monats"
    )

    print(
        "Bin später losgekommen. "
        "Der Weg kommt mir heute länger vor."
    )

    print()
    print(
        "..."
    )

    print(
        "Habe dieselbe Wegmarkierung zweimal passiert."
    )

    print(
        "Das ergibt keinen Sinn."
    )

    print()
    print(
        "Die Klippen..."
    )

    print(
        "Ich muss zum Hafen."
    )

    print()
    print(
        "Wie hieß der Hafen?"
    )

    print()

    text_ausgeben(
        "Bei den letzten Zeilen wird die Schrift unruhiger. "
        "Einige Buchstaben sind mehrfach angesetzt."
    )

    text_ausgeben(
        "Danach bleiben die Seiten leer."
    )

    seite_wechseln(
        "Wald - Verlassener Karren"
    )

    if not item_besitzt(
        "fahrtenbuch_haendler"
    ):
        item_hinzufuegen(
