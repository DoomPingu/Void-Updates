                )

                print()
                text_ausgeben(
                    "Der Platz unter dem Baum ist leer."
                )

                text_ausgeben(
                    "Nur einige niedergedrückte Blätter "
                    "zeigen noch, dass hier jemand gesessen hat."
                )             

        elif ereignis == 7:
            print()
            text_ausgeben(
                "Zwischen den Bäumen öffnet sich eine "
                "kleine Lichtung."
            )

            text_ausgeben(
                "Mehrere niedrige Steine ragen dort "
                "aus Moos und Farnen."
            )

            print()
            text_ausgeben(
                "Auf den ersten Blick wirken sie wie "
                "gewöhnliche Felsen."
            )

            text_ausgeben(
                "Als du näher trittst, erkennst du jedoch "
                "verwitterte Einkerbungen."
            )

            print()
            text_ausgeben(
                "Einer der Steine trägt noch den Rest "
