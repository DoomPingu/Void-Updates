        ):
            print(
                "Ziel: Die Register nennen den Fuhrmann Marek Voss. "
                "Finde ihn in Letzthafen."
            )

        elif letzthafen_spuren.get(
            "sera_marek",
            False
        ):
            print(
                "Ziel: Sera sah Marek zuletzt am "
                "Gezeitensteg. Suche dort nach ihm."
            )

        else:
            print(
                "Ziel: Suche in Letzthafen nach Hinweisen "
                "auf den verschwundenen Händler."
            )

    elif quest_name_fehlt == "marek_identitaet_pruefen":
        print(
            "Ziel: Prüfe Letzthafens Aufzeichnungen "
            "auf Hinweise zu Marek Voss."
        )

    elif quest_name_fehlt == "marek_wohnung_untersuchen":
        print(
