            "in der Bootswerkstatt."
        )

    elif quest_name_fehlt == "marek_abschluss_gespraech":
        print(
            "Ziel: Sprich mit Marek über das, was ihr "
            "über sein früheres Leben herausgefunden habt."
        )

    elif quest_name_fehlt == "abgeschlossen":
        design_text(
            "[ABGESCHLOSSEN]",
            design="quest_abgeschlossen",
            art="menue"
        )

        print(
            "Marek hat seine Erinnerungen nicht zurückgewonnen, "
            "aber Spuren seines früheren Lebens gefunden."
        )

    # --------------------
