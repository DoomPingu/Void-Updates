        sonder_tasten=()
    )

def hinweise():
    ort_titel(
        "Questlog/Erfolge - Hinweise"
    )

    bekannte_hinweise = []

    for hinweis_id, status in spieler.get(
        "rueckkehr_hinweise",
        {}
    ).items():

        if status not in (
            "neu",
            "offen",
            "erledigt"
        ):
            continue

        daten = RUECKKEHR_HINWEISE.get(
            hinweis_id
        )

        if daten:
            bekannte_hinweise.append(
                (daten, status)
            )

    if not bekannte_hinweise:
        print(
            "Du hast noch keine Hinweise erhalten."
        )

    else:
        for daten, status in bekannte_hinweise:

            if status == "erledigt":
                design_text(
                    f'{daten["name"]} [Abgeschlossen]',
                    design="positiv",
                    art="menue"
                )

            else:
                design_text(
                    f'{daten["name"]} [Offen]',
                    design="wissen",
                    art="menue"
                )

            print(
                daten["text"]
            )

            print()

    menue_trenner()

    print("1. Zurück")

    eingabe_menu(
        1,
        1,
        sonder_tasten=()
    )

def questlog():
    while True:
        ort_titel(
            "Questlog/Erfolge"
        )

        hinweis_text = "Hinweise"

        if rueckkehr_hinweise_offen_vorhanden():
            hinweis_text += " [!]"

        print("1. Quests")
        print("2. Erfolge")

        print(
            f"3. {hinweis_text}"
        )

        print("4. Zurück")

        questlog_auswahl = eingabe_menu(
            1,
            4,
            sonder_tasten=()
        )

        if questlog_auswahl == 1:
            quests()

        elif questlog_auswahl == 2:
            erfolge()

        elif questlog_auswahl == 3:
            hinweise()

        elif questlog_auswahl == 4:
            return

def rezept_ist_gelernt(rezept_id):
    return rezept_id in spieler.get(
        "rezepte_gelernt",
        []
    )


def rezept_lernen(rezept_id):
    if rezept_id not in REZEPTE:
        return False

    gelernte_rezepte = spieler.setdefault(
        "rezepte_gelernt",
        []
    )

    if rezept_id in gelernte_rezepte:
        return False

    gelernte_rezepte.append(
        rezept_id
    )

    print()
    print("-" * 34)

    design_text(
        "NEUES REZEPT GELERNT",
        design="wissen",
        art="menue"
    )

    print(
        REZEPTE[
            rezept_id
        ]["name"]
    )

    print("-" * 34)
    print()

    return True

