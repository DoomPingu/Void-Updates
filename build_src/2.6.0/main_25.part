def wegstation_raum_aktionen(
    raum_id
):
    status = wegstation_status()
    funde = status[
        "funde"
    ]

    aktionen = []

    if (
        raum_id == "wachraum"
        and not funde.get(
            "wachraum_untersucht",
            False
        )
    ):
        aktionen.append(
            (
                "wachraum_untersuchen",
                "Den Wachraum durchsuchen"
            )
        )

    if (
        raum_id == "schreibstube"
        and not funde.get(
            "stationsregister_gelesen",
            False
        )
    ):
        aktionen.append(
            (
                "schreibstube_untersuchen",
                "Die alten Unterlagen untersuchen"
            )
        )

    if (
        raum_id == "keller"
        and not funde.get(
            "keller_untersucht",
            False
        )
    ):
        aktionen.append(
            (
                "keller_untersuchen",
                "Den hinteren Keller untersuchen"
            )
        )

    elif (
        raum_id == "keller"
        and "keller_vorhof"
        not in status["abkuerzungen"]
    ):
        aktionen.append(
            (
                "keller_abkuerzung",
                "Die alte Seitentür untersuchen"
            )
        )

    if (
        raum_id == "archivkammer"
        and not funde.get(
            "archiv_untersucht",
            False
        )
    ):
        aktionen.append(
            (
                "archiv_untersuchen",
                "Die alten Karten und Register untersuchen"
            )
        )

    elif (
        raum_id == "archivkammer"
        and not funde.get(
            "geheimraum_hinweis",
            False
        )
        and not status.get(
            "geheimgang_offen",
            False
        )
        and (
            item_besitzt(
                "altes_kartenstueck"
            )
            or besonderer_fund_status(
                "altes_kartenstueck"
            ) in (
                "erhalten",
                "zugeordnet"
            )
        )
    ):
        aktionen.append(
            (
                "kartenstueck_archiv",
                "Das alte Kartenstück mit dem Archiv vergleichen [!]"
            )
        )

    elif (
        raum_id == "archivkammer"
        and funde.get(
            "geheimraum_hinweis",
            False
        )
        and not status.get(
            "geheimgang_offen",
            False
        )
    ):
        aktionen.append(
            (
                "geheimraum_oeffnen",
                "Die Maße des Archivs genauer prüfen"
            )
        )

    if (
        raum_id == "versiegelte_kammer"
        and not funde.get(
            "versiegeltes_register_geborgen",
            False
        )
    ):
        aktionen.append(
            (
                "versiegeltes_register",
                "Den steinernen Sockel untersuchen"
            )
        )

    return aktionen

def wegstation_verbindungen(raum_id):
    raum = WEGSTATION_RAEUME.get(
        raum_id
    )

    if not raum:
        return []

    verbindungen = list(
        raum.get(
            "wege",
            []
        )
    )

    status = wegstation_status()

    if (
        raum_id == "keller"
        and not status["funde"].get(
            "keller_untersucht",
            False
        )
        and "archivkammer" in verbindungen
    ):
        verbindungen.remove(
            "archivkammer"
        )

    # Spätere Abkürzung:
    # Keller <-> Vorhof
    if (
        "keller_vorhof"
        in status["abkuerzungen"]
    ):
        if (
            raum_id == "keller"
            and "vorhof" not in verbindungen
        ):
            verbindungen.append(
                "vorhof"
            )

        elif (
            raum_id == "vorhof"
            and "keller" not in verbindungen
        ):
            verbindungen.append(
                "keller"
            )

    # Späterer Geheimgang
    if status.get(
        "geheimgang_offen",
        False
    ):
        if (
            raum_id == "archivkammer"
            and "versiegelte_kammer"
            not in verbindungen
        ):
            verbindungen.append(
                "versiegelte_kammer"
            )

    return verbindungen


def wegstation_gebietskarte_anzeigen():
    daten = wegstation_status()

    aktueller_raum = daten.get(
        "aktueller_raum",
        "vorhof"
    )

    besuchte_raeume = set(
        daten.get(
            "besuchte_raeume",
            []
        )
    )

    # -------------------------
    # SICHTBARKEIT
    # -------------------------

    def raum_sichtbar(raum_id):
        if raum_id in besuchte_raeume:
            return True

        for besucht_id in besuchte_raeume:
            if raum_id in wegstation_verbindungen(
                besucht_id
            ):
                return True

        return False

    # -------------------------
    # KARTENFELD
    # -------------------------

    def feld(raum_id):
        if not raum_sichtbar(
            raum_id
        ):
            return None

        if raum_id not in besuchte_raeume:
            return "[?]"

        name = WEGSTATION_KARTENNAMEN[
            raum_id
        ]

        if raum_id == aktueller_raum:
            return f">{name}<"

        return f"[{name}]"

    # -------------------------
    # ZEICHENBEREICH
    # -------------------------

    breite = 56
    hoehe = 9

    karte = [
        [" "] * breite
        for _ in range(hoehe)
    ]

    # -------------------------
    # VERBINDUNGSLINIEN
    # -------------------------

    def mittelpunkt(raum_id):
        text = feld(
            raum_id
        )

        if text is None:
            return None

        zeile, spalte = (
            WEGSTATION_KARTENPOSITIONEN[
                raum_id
            ]
        )

        return (
            zeile,
            spalte + len(text) // 2
        )

    def linie_setzen(
        zeile,
        spalte,
        zeichen
    ):
        if not (
            0 <= zeile < hoehe
            and 0 <= spalte < breite
        ):
            return

        if karte[zeile][spalte] == " ":
            karte[zeile][spalte] = zeichen

    def verbindung_zeichnen(
        start_id,
        ziel_id
    ):
        start = mittelpunkt(
            start_id
        )

        ziel = mittelpunkt(
            ziel_id
        )

        if (
            start is None
            or ziel is None
        ):
            return

        start_zeile, start_spalte = start
        ziel_zeile, ziel_spalte = ziel

        # Gleiche Höhe
        if start_zeile == ziel_zeile:
            von = min(
                start_spalte,
                ziel_spalte
            )

            bis = max(
                start_spalte,
                ziel_spalte
            )

            for spalte in range(
                von + 1,
                bis
            ):
                linie_setzen(
                    start_zeile,
                    spalte,
                    "─"
                )

            return

        # Gleiche Spalte
        if start_spalte == ziel_spalte:
            von = min(
                start_zeile,
                ziel_zeile
            )

            bis = max(
                start_zeile,
                ziel_zeile
            )

            for zeile in range(
                von + 1,
                bis
            ):
                linie_setzen(
                    zeile,
                    start_spalte,
                    "│"
                )

            return

        # Unterschiedliche Höhe und Spalte
        schritt = (
            1
            if ziel_spalte > start_spalte
            else -1
        )

        for spalte in range(
            start_spalte + schritt,
            ziel_spalte,
            schritt
        ):
            linie_setzen(
                start_zeile,
                spalte,
                "─"
            )

        schritt = (
            1
            if ziel_zeile > start_zeile
            else -1
        )

        for zeile in range(
            start_zeile + schritt,
            ziel_zeile,
            schritt
        ):
            linie_setzen(
                zeile,
                ziel_spalte,
                "│"
            )

    # -------------------------