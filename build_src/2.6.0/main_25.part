        "dem du bis hierher gefolgt bist."
    )

    print()

    text_ausgeben(
        "Am Rand der Karte befindet sich ein verblasster "
        "Verwaltungsvermerk."
    )

    print()

    design_text(
        '"Abschrift nach Oros."',
        design="wissen",
        art="menue"
    )

    print()

    text_ausgeben(
        "Mehr verrät der beschädigte Vermerk nicht."
    )

    funde[
        "archiv_untersucht"
    ] = True

    akt1_lernerfahrung(
        "wegstation_archiv"
    )

    besonderen_fund_dokumentieren(
        "strassenkarte_wegstation",
        "gelesen"
    )

    print()
    print("-" * 34)

    design_text(
        "BESONDERER FUND",
        design="wissen",
        art="ereignis"
    )

    print()
    print("Straßenkarte der Wegstation")
