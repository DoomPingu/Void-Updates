
        text_ausgeben(
            "Das Tier muss von draußen in die Ruine gelangt sein."
        )

        print()
        print("1. Dich dem Wolf stellen")
        print("2. Langsam zur Treppe zurückweichen")

        auswahl = eingabe_menu(
            1,
            2,
            sonder_tasten=()
        )

        if auswahl == 2:
            return

        print()

        kampf_ergebnis = kampf_starten(
            lebenspunkte=spieler["lebenspunkte"],
            heiltraenke=spieler["heiltränke"],
            waffe=spieler["waffe"],
            gegner_typ="Wolf"
        )

        spieler["lebenspunkte"] = (
            kampf_ergebnis["lebenspunkte"]
        )

        spieler["heiltränke"] = (
            kampf_ergebnis["heiltraenke"]
        )

        if kampf_ergebnis["gewonnen"]:
            spieler[
                "besiegte_gegner"
            ] += 1

            funde[
                "keller_gefahr_aufgeloest"
            ] = True

        elif kampf_ergebnis["besiegt"]:
            print()
            print("Game Over")

            spieler[
                "spiel_laeuft"
            ] = False

            return

        else:
            return

    # -------------------------
    # VARIANTE: MORSCHE TREPPE
    # -------------------------

    elif variante == "morsche_treppe":
        text_ausgeben(
            "Als du dich tiefer in den Keller vortastest, "
            "gibt hinter dir plötzlich eine der alten Stufen nach."
        )

        print()

        text_ausgeben(
            "Stein splittert über den Boden. Du kannst dich noch "
            "rechtzeitig an der Wand abfangen."
        )

        print()

        text_ausgeben(
            "Der Weg bleibt passierbar, aber die Treppe ist deutlich "
            "instabiler, als sie von oben wirkte."
        )

        funde[
            "morsche_kellertreppe"
        ] = True

    # -------------------------
    # VARIANTE: FRISCHE SPUREN
    # -------------------------

    elif variante == "frische_spuren":
        text_ausgeben(
            "Im Staub zwischen den Regalen erkennst du frische "
            "Stiefelabdrücke."
        )

        print()

        text_ausgeben(
            "Sie führen von einer vermauert wirkenden Seitentür "
            "quer durch den Keller."
        )

        text_ausgeben(
            "An einer scharfen Steinkante hängt ein schmaler "
            "Streifen dunklen Stoffes."
        )

        print()

        design_text(
            "Jemand hat die Wegstation vor nicht allzu langer Zeit benutzt.",
            design="warnung",
            art="menue"
        )

        funde[
            "frische_spuren_keller"
        ] = True

    # -------------------------
    # KELLER ABGESCHLOSSEN
    # -------------------------

    funde[
        "keller_untersucht"
    ] = True

    print()

    text_ausgeben(
        "Hinter den letzten Regalen führt der Keller zu einer "
        "schweren Tür aus dunklem Holz und Eisen."
    )

    text_ausgeben(
        "Eine verblasste Plakette daneben trägt nur noch "
        "ein lesbares Wort: Archiv."
    )

    warte_auf_taste(
        "Weiter"
    )


