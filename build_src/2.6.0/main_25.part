        text_ausgeben(
            "Als du die Karte wieder zusammenrollst, "
            "fällt dein Blick auf Tomas' altes Kartenstück."
        )

        print()

        text_ausgeben(
            "Der kleine Grundriss darauf zeigt an der Rückseite "
            "des Archivs einen schmalen Mauervorsprung."
        )

        text_ausgeben(
            "Im Raum selbst gibt es dort jedoch weder eine Tür "
            "noch eine erkennbare Nische."
        )

        funde[
            "geheimraum_hinweis"
        ] = True

        print()

        design_text(
            "Irgendetwas an den Maßen des Raumes stimmt nicht.",
            design="warnung",
            art="menue"
        )

    warte_auf_taste(
        "Weiter"
    )

