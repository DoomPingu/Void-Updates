        return

    besuchte_orte = spieler.get("prolog_besuchte_orte", {})

    if ort_name not in besuchte_orte:
        return

    if besuchte_orte[ort_name]:
        return

    besuchte_orte[ort_name] = True

    anzahl_besucht = sum(besuchte_orte.values())

    if anzahl_besucht == 3:
        spieler["prolog_status"] = "dorf_kennengelernt"

def prolog_laeuft():
    return spieler.get("prolog_status") != "prolog_abgeschlossen"

def prolog_joris_hinweis(quelle):
    hinweise = spieler.setdefault(
        "prolog_joris_hinweise",
        {
            "mara": False,
            "tomas": False
        }
    )

    if quelle not in hinweise:
        return

    if hinweise[quelle]:
        return

    hinweise[quelle] = True

    if all(hinweise.values()):
        spieler["prolog_status"] = "joris_hinweise_komplett"

        quest_meldung(
            "update",
            "Der verlorene Lehrling",
            "Berichte Bjorn, was du über Joris herausgefunden hast."
        )

def quest_meldung(
    status,
    name,
    ziel=None,
    belohnungen=None
):
    print()
    print("=" * 34)

    if status == "neu":
        design_text(
            "NEUE QUEST",
            design="quest_neu",
            art="ereignis"
        )

    elif status == "update":
        design_text(
            "QUEST AKTUALISIERT",
            design="quest_update",
            art="ereignis"
        )

    elif status == "abgeschlossen":
        design_text(
            "QUEST ABGESCHLOSSEN",
            design="quest_abgeschlossen",
            art="ereignis"
        )

    design_text(
        name,
        design="wichtig",
        art="menue"
    )

    # -------------------------
    # QUESTZIEL
    # -------------------------

    if ziel:
        print()

        design_text(
            "Ziel:",
            design="wissen",
            art="menue"
        )

        print(
            ziel
        )

    # -------------------------
    # BELOHNUNGEN
    # -------------------------

    if (
        status == "abgeschlossen"
        and belohnungen
    ):
        if isinstance(
            belohnungen,
            str
        ):
            belohnungen = [
                belohnungen
            ]

        print()

        design_text(
            "Belohnungen:",
            design="wissen",
            art="menue"
        )

        for belohnung in belohnungen:
            print(
                f"- {belohnung}"
            )

    print("=" * 34)
    print()

def dialog_thema_bekannt(npc, thema):
    return spieler.get(
        "dialog_themen",
        {}
    ).get(
        npc,
        {}
    ).get(
        thema,
        False
    )


def dialog_option(npc, thema, text):
    if dialog_thema_bekannt(npc, thema):
        return f"{text} [Wiederholen]"

    return text


def dialog_thema_markieren(npc, thema):
    dialog_themen = spieler.setdefault(
        "dialog_themen",
        {}
    )

    npc_themen = dialog_themen.setdefault(
        npc,
        {}
    )

    npc_themen[thema] = True

def npc_status(npc):
    alle_npcs = spieler.setdefault(
        "npc_status",
        {}
    )

    daten = alle_npcs.setdefault(
        npc,
        {
            "besuche": 0,
            "reaktionen": [],
            "themen": []
        }
    )

    return daten


def npc_besuch_starten(npc):
    daten = npc_status(npc)

    daten["besuche"] += 1

    return daten["besuche"]


def npc_thema_bekannt(npc, thema):
    return thema in npc_status(
        npc
    )["themen"]


def npc_thema_markieren(npc, thema):
    daten = npc_status(npc)

    if thema not in daten["themen"]:
        daten["themen"].append(
            thema
        )


def npc_reaktion_gezeigt(npc, reaktion):
    return reaktion in npc_status(
        npc
    )["reaktionen"]


def npc_reaktion_markieren(npc, reaktion):

    daten = npc_status(npc)

    if reaktion not in daten["reaktionen"]:
        daten["reaktionen"].append(
            reaktion
        )

def npc_variante_waehlen(
    npc,
    schluessel,
    varianten
):
    daten = npc_status(
        npc
    )

    letzte_variante = daten.get(
        schluessel
    )

    moegliche_varianten = [
        variante
        for variante in varianten
        if variante != letzte_variante
    ]

    if not moegliche_varianten:
        moegliche_varianten = varianten

    variante = random.choice(
        moegliche_varianten
    )

    daten[
        schluessel
    ] = variante

    return variante

def npc_begruessung_waehlen(
    npc,
    begruessungen
):
    daten = npc_status(
        npc
    )

    letzte_begruessung = daten.get(
        "letzte_begruessung"
    )

    moegliche_begruessungen = [
        begruessung
        for begruessung in begruessungen
        if begruessung != letzte_begruessung
    ]

    if not moegliche_begruessungen:
        moegliche_begruessungen = begruessungen

    begruessung = random.choice(
        moegliche_begruessungen
    )

    daten[
        "letzte_begruessung"
    ] = begruessung

    return begruessung

def weg_status(weg_id):
    
    return spieler.get(
        "wege_status",
        {}
    ).get(
        weg_id,
        "unbekannt"
    )


def weg_bemerken(weg_id):
    wege_status = spieler.setdefault(
        "wege_status",
        {}
    )

    if wege_status.get(
        weg_id,
        "unbekannt"
    ) == "unbekannt":
        wege_status[weg_id] = "bemerkt"


def weg_entdecken(weg_id):
    if weg_id not in WEGE:
        return False

    wege_status = spieler.setdefault(
        "wege_status",
        {}
    )

    war_bereits_entdeckt = (
        wege_status.get(weg_id)
        == "entdeckt"
    )

    wege_status[weg_id] = "entdeckt"

    if not war_bereits_entdeckt:
        neue_wege = spieler.setdefault(
            "neue_wege",
            []
        )

        if weg_id not in neue_wege:
            neue_wege.append(
                weg_id
            )

        print()
        print("-" * 34)

        design_text(
            "NEUER WEG ENTDECKT",
            design="wissen",
            art="menue"
        )

        print(
            WEGE[weg_id]["name"]
        )

        print("-" * 34)
        print()

    return True


def weg_ist_neu(weg_id):
    return weg_id in spieler.get(
        "neue_wege",
        []
    )


def weg_als_gesehen_markieren(weg_id):
    neue_wege = spieler.setdefault(
        "neue_wege",
        []
    )

    if weg_id in neue_wege:
        neue_wege.remove(
            weg_id
        )

def routenkenntnis_bekannt(weg_id):
    return weg_id in spieler.get(
        "routenkenntnis",
        []
    )


def routenkenntnis_lernen(weg_id):
    if weg_id not in WEGE:
        return False

    bekannte_routen = spieler.setdefault(
        "routenkenntnis",
        []
    )

    if weg_id in bekannte_routen:
        return False

    bekannte_routen.append(
        weg_id
    )

    print()
    print("-" * 34)

    design_text(
        "ROUTE VERTRAUT",
        design="wissen",
        art="menue"
    )

    print(
        WEGE[weg_id]["name"]
    )

    print()
    print(
        "Du kennst diese Strecke jetzt gut genug, "
        "um sie auf Wunsch zügig zurückzulegen."
    )

    print("-" * 34)
    print()

    return True

