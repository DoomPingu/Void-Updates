    )

    wiegenlied.setdefault(
        "truhe_geoeffnet",
        False
    )

    wiegenlied.setdefault(
        "truhe_inhalt_untersucht",
        False
    )

    return daten


def letzthafen_bereich_betreten(bereich_id):
    daten = letzthafen_status()

    besuchte_bereiche = daten[
        "besuchte_bereiche"
    ]

    erstmals = (
        bereich_id not in besuchte_bereiche
    )

    if erstmals:
        besuchte_bereiche.append(
            bereich_id
        )

    return erstmals


def letzthafen_bereich_anzeigen(
    bereich_id,
    titel,
    *zeilen
):
    erstmals = letzthafen_bereich_betreten(
        bereich_id
    )

    ort_titel(
        titel
    )

    text_art = (
        "atmosphaere"
        if erstmals
        else "menue"
    )

    for zeile in zeilen:
        text_ausgeben(
            zeile,
            art=text_art
        )

        print()

    warte_auf_taste(
        "Zurück nach Letzthafen"
    )

def dialog_sera():
    sera_besuch = npc_besuch_starten(
        "sera"
    )

    erste_runde = True
    themen_dieses_gespraech = set()

    while True:
        ort_titel(
            "Zum letzten Licht"
        )

        dialog_titel(
            "Sera"
        )

        daten = letzthafen_status()
        spuren = daten[
            "spuren"
        ]

        quest_status = spieler.get(
            "quest_ein_name_fehlt"
        )

        marek_name_bekannt = (
            spuren.get(
                "sera_marek",
                False
            )
            or spuren.get(
                "register_marek",
                False
            )
            or besonderer_fund_status(
                "stationsregister"
            ) == "gelesen"
        )

        if erste_runde:
            if sera_besuch == 1:
                text_ausgeben(
                    "Die Wirtin klappt das schmale Buch neben der Kasse zu "
                    "und schiebt einen Becher unter den Tresen."
                )

                text_ausgeben(
                    "Dann sieht sie zu dir auf."
                )

                print()

                text_ausgeben(
                    "[Sera] Neu in Letzthafen?"
                )

                text_ausgeben(
                    "[Sera] Dann gewöhn dich besser an Wind, Salz "
                    "und Leute, die alles aufschreiben."
                )

            else:
                begruessung = npc_begruessung_waehlen(
                    "sera",
                    [
                        "[Sera] Wieder da? Was darf es sein?",
                        "[Sera] Na? Was hast du diesmal herausgefunden?",
                        "[Sera] Ich höre.",
                        "[Sera] Setz dich, wenn du bleiben willst.",
                        (
                            "[Sera] Du kennst den Weg inzwischen. "
                            "Was gibt es?"
                        )
                    ]
                )

                text_ausgeben(
                    begruessung
                )

        else:
            text_ausgeben(
                "[Sera] Noch etwas?"
            )

        print()

        # -------------------------
        # MAREK WIRD GESUCHT
        # -------------------------

        if quest_status == "marek_spur_suchen":

            if marek_name_bekannt:
                marek_text = (
                    "Ich suche Marek Voss."
                )

            else:
                marek_text = (
                    "Ich suche einen Fuhrmann aus Letzthafen."
                )

            optionen = []

            if "marek_voss" not in themen_dieses_gespraech:
                optionen.append(
                    (
                        "marek_voss",
                        dialog_option(
                            "sera",
                            "marek_voss",
                            marek_text
                        )
                    )
                )

            if "notizbuecher" not in themen_dieses_gespraech:
                optionen.append(
                    (
                        "notizbuecher",
                        dialog_option(
                            "sera",
                            "notizbuecher",
                            "Warum tragen hier so viele Leute Notizbücher?"
                        )
                    )
                )

            optionen.append(
                (
                    "ende",
                    "Gespräch beenden"
                )
            )

            for nummer, (_, text) in enumerate(
                optionen,
                start=1
            ):
                print(
                    f"{nummer}. {text}"
                )

            sera_auswahl = eingabe_menu(
                1,
                len(optionen),
                sonder_tasten=()
            )

            aktion = optionen[
                sera_auswahl - 1
            ][0]

            erste_runde = False

            if aktion != "ende":
                themen_dieses_gespraech.add(
                    aktion
                )

            print()

            # -------------------------
            # MAREK
            # -------------------------

            if aktion == "marek_voss":
                dialog_thema_markieren(
                    "sera",
                    "marek_voss"
                )

                if not spuren.get(
                    "sera_marek",
                    False
                ):

                    if marek_name_bekannt:
                        text_ausgeben(
                            f'[{spieler["name"]}] '
                            "Ich suche Marek Voss."
                        )

                    else:
                        text_ausgeben(
                            f'[{spieler["name"]}] '
                            "Ich suche einen Fuhrmann aus Letzthafen."
                        )

                        print()

                        text_ausgeben(
                            "Du erzählst von Hildas Lieferung, "
                            "dem verlassenen Karren und der Spur "
                            "zurück nach Letzthafen."
                        )

                        print()

                        text_ausgeben(
                            "[Sera] Dann suchst du Marek Voss."
                        )

                    print()

                    text_ausgeben(
                        "[Sera] Marek? Ja. "
                        "Der kommt regelmäßig hier vorbei."
                    )

                    text_ausgeben(
                        "[Sera] Normalerweise sitzt er genau da drüben "
                        "und beschwert sich darüber, dass mein Eintopf "
                        "zu viel Salz hat."
                    )

                    print()

                    text_ausgeben(
                        "Sera deutet auf einen kleinen Tisch am Fenster. "
                        "Auf der Platte steht noch ein leerer Becher."
                    )

                    print()

                    text_ausgeben(
                        "[Sera] Als er zuletzt hier auftauchte, "
                        "fragte er mich, ob wir uns schon einmal "
                        "begegnet wären."
                    )

                    text_ausgeben(
                        "Sera zieht das Tuch in ihrer Hand einmal "
                        "über dieselbe Stelle des Tresens."
                    )

                    print()

                    text_ausgeben(
                        "[Sera] Dann legte er genau den Betrag "
                        "für sein übliches Zimmer hin."
                    )

                    text_ausgeben(
                        "[Sera] Ohne nach dem Preis zu fragen."
                    )

                    print()

                    text_ausgeben(
                        '[Sera] Ich sagte: '
                        '"Wie immer, oben links."'
                    )

                    text_ausgeben(
                        '[Sera] Er sah mich an und fragte nur: '
                        '"Wie immer?"'
                    )

                    print()

                    text_ausgeben(
                        "Sera schaut zu dem leeren Tisch am Fenster."
                    )

                    print()

                    text_ausgeben(
                        "[Sera] Heute Morgen habe ich ihn unten "
                        "am Gezeitensteg gesehen."
                    )

                    text_ausgeben(
                        "[Sera] Er half den Fischern beim Tauwerk, "
                        "als wäre nichts gewesen."
                    )

                    if (
                        not spuren.get(
                            "marek_widerspruch",
                            False
                        )
                        and spieler_pruefung(
                            "wahrnehmung",
                            2
                        )
                    ):
                        print()

                        print(
                            "1. [Wahrnehmung] Er kannte Preis und Zimmer, "
                            "aber nicht dich?"
                        )
                        print(
                            "2. Den Gedanken für dich behalten"
                        )

                        widerspruch_auswahl = eingabe_menu(
                            1,
                            2,
                            sonder_tasten=()
                        )

                        print()

                        if widerspruch_auswahl == 1:
                            text_ausgeben(
                                f'[{spieler["name"]}] '
                                "Er wusste genau, was das Zimmer kostet "
                                "und wo es liegt."
                            )

                            text_ausgeben(
                                f'[{spieler["name"]}] '
                                "Aber dich hat er nicht erkannt?"
                            )

                            print()

                            text_ausgeben(
                                "Sera hält einen Moment inne."
                            )

                            print()

                            text_ausgeben(
                                "[Sera] Stimmt."
                            )

                            text_ausgeben(
                                "[Sera] Darüber habe ich noch gar nicht "
                                "richtig nachgedacht."
                            )

                            print()

                            text_ausgeben(
                                "[Sera] Die Gewohnheit war noch da."
                            )

                            text_ausgeben(
                                "[Sera] Nur der Mensch darin offenbar nicht."
                            )

                            spuren[
                                "marek_widerspruch"
                            ] = True

                            dialog_thema_markieren(
                                "sera",
                                "marek_widerspruch"
                            )

                            akt1_lernerfahrung(
                                "sera_marek_widerspruch"
                            )

                    spuren[
                        "sera_marek"
                    ] = True

                    quest_meldung(
                        "update",
                        "Ein Name fehlt",