def start_veranlagung_waehlen():
    attribut_system_sicherstellen()

    optionen = [
        (
            "staerke",
            "Stärke",
            "Kraft einsetzen und körperliche Hindernisse überwinden."
        ),
        (
            "ausdauer",
            "Ausdauer",
            "Belastung, Erschöpfung und körperliche Grenzen einschätzen."
        ),
        (
            "geschick",
            "Geschick",
            "Präzision, Balance und schnelle Handgriffe."
        ),
        (
            "zaehigkeit",
            "Zähigkeit",
            "Schmerz, Widerstand und körperlichen Druck aushalten."
        ),
        (
            "wissen",
            "Wissen",
            "Gelerntes einordnen und Zusammenhänge verstehen."
        ),
        (
            "wahrnehmung",
            "Wahrnehmung",
            "Spuren, Details und Widersprüche bemerken."
        ),
        (
            "willenskraft",
            "Willenskraft",
            "Angst, Druck und mentale Belastung aushalten."
        ),
        (
            "empathie",
            "Empathie",
            "Gefühle, Motive und Zwischentöne verstehen."
        )
    ]

    while True:
        ort_titel(
            "Deine Veranlagung"
        )

        text_ausgeben(
            "Noch bevor dein Weg beginnt, gibt es Dinge, "
            "die dir etwas leichter fallen als andere.",
            art="menue"
        )

        print()

        text_ausgeben(
            "Das ist keine Klasse und keine endgültige Entscheidung. "
            "Deine Fähigkeiten entwickeln sich später durch das, "
            "was du tatsächlich tust und lernst.",
            art="menue"
        )

        print()

        design_text(
            "Wähle deine stärkste Veranlagung.",
            design="wissen",
            art="menue"
        )

        print()

        for nummer, (_, name, beschreibung) in enumerate(
            optionen,
            start=1
        ):
            print(
                f"{nummer}. {name} - {beschreibung}"
            )

        empfehlungen_nummer = (
            len(optionen) + 1
        )

        print()

        print(
            f"{empfehlungen_nummer}. "
            "Build-Empfehlungen ansehen"
        )

        haupt_auswahl = eingabe_menu(
            1,
            empfehlungen_nummer,
            sonder_tasten=()
        )

        if (
            haupt_auswahl
            == empfehlungen_nummer
        ):
            start_build_empfehlungen_anzeigen()
            continue

        break

    haupt_id = optionen[
        haupt_auswahl - 1
    ][0]

    spieler[
        "verfassungs_praegung"
    ][
        haupt_id
    ] = 4

    verfassung_neuberechnen(
        haupt_id,
        meldung=False
    )

    zweite_optionen = [
        eintrag
        for eintrag in optionen
        if eintrag[0] != haupt_id
    ]

    ort_titel(
        "Deine Veranlagung"
    )

    design_text(
        f"Stärkste Veranlagung: "
        f"{VERFASSUNG_DEFINITIONEN[haupt_id]['name']} +1",
        design="positiv",
        art="menue"
    )

    print()

    text_ausgeben(
        "Wähle nun eine zweite Neigung. Sie gibt noch keinen "
        "direkten Bonus, ist aber bereits teilweise ausgeprägt "
        "und kann sich dadurch schneller entwickeln.",
        art="menue"
    )

    print()

    for nummer, (_, name, beschreibung) in enumerate(
        zweite_optionen,
        start=1
    ):
        print(
            f"{nummer}. {name} - {beschreibung}"
        )

    zweite_auswahl = eingabe_menu(
        1,
        len(zweite_optionen),
        sonder_tasten=()
    )

    zweite_id = zweite_optionen[
        zweite_auswahl - 1
    ][0]

    spieler[
        "verfassungs_praegung"
    ][
        zweite_id
    ] = 2

    verfassung_neuberechnen(
        zweite_id,
        meldung=False
    )

    spieler[
        "start_veranlagung"
    ] = {
        "haupt": haupt_id,
        "neigung": zweite_id
    }

    ort_titel(
        "Deine Veranlagung"
    )

    design_text(
        "Deine Ausgangslage",
        design="wissen",
        art="menue"
    )

    print()

    print(
        f"Stärkste Veranlagung: "
        f"{VERFASSUNG_DEFINITIONEN[haupt_id]['name']} +1"
    )

    print(
        f"Zweite Neigung: "
        f"{VERFASSUNG_DEFINITIONEN[zweite_id]['name']} (2/4 Prägung)"
    )

    print()

    design_text(
        "Übersinnliches: ???",
        design="wissen",
        art="menue"
    )

    warte_auf_taste(
        "Weiter"
    )

