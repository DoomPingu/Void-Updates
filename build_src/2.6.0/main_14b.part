            return zahl

        fehler = True

def heiltrank_benutzen(lebenspunkte, heiltränke):
    blutung_aktiv = status_aktiv(
        "bluten"
    )

    if (
        heiltränke > 0
        and (
            lebenspunkte < 100
            or blutung_aktiv
        )
    ):
        lebenspunkte = min(
            100,
            lebenspunkte + 30
        )

        heiltränke -= 1

        print()
        print("Du benutzt einen Heiltrank")
        print(
            f"Du hast jetzt {lebenspunkte} HP"
        )

        if blutung_aktiv:
            status_entfernen(
                "bluten",
                meldung=False
            )

            design_text(
                "Die Blutung kommt zum Stillstand.",
                design="positiv",
                art="menue"
            )

    elif heiltränke == 0:
        print("Du hast keine Heiltränke!")

    elif lebenspunkte == 100:
        print(
            "Du hast schon volle Lebenspunkte!"
        )

    return lebenspunkte, heiltränke  

