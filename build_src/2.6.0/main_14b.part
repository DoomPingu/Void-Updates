def optionen():
    if isinstance(spieler, dict):
        einstellungen = spieler
    else:
        einstellungen = STANDARD_EINSTELLUNGEN
    while True:
        ort_titel("Optionen")

        if einstellungen["menue_eingabe"] == "direkt":
            eingabe_text = "Direkte Tasteneingabe"
        else:
            eingabe_text = "Mit Enter bestätigen"

        if einstellungen["bildschirm_leeren"]:
            bildschirm_text = "An"
        else:
            bildschirm_text = "Aus"

        print(
            f"Textgeschwindigkeit: "
            f"{einstellungen['textgeschwindigkeit'].capitalize()}"
        )
        print(f"Menü-Eingabe: {eingabe_text}")
        print(f"Bildschirm leeren: {bildschirm_text}")
        print(
            f"Spielername-Farbe: "
            f"{einstellungen.get('spieler_name_farbe', 'standard').capitalize()}"
        )

        print()
        print("1. Textgeschwindigkeit")
        print("2. Menü-Eingabe")
        print("3. Bildschirm leeren")
        print("4. Spielername-Farbe")
        print("5. Zurück")

        optionen_auswahl = eingabe_menu(
            1,
            5,
            sonder_tasten=()
        )

        # -------------------------
        # TEXTGESCHWINDIGKEIT
        # -------------------------

        if optionen_auswahl == 1:
            ort_titel("Textgeschwindigkeit")

            print("1. Sofort")
            print("2. Schnell")
            print("3. Normal")
            print("4. Langsam")
            print("5. Zurück")

            tempo_auswahl = eingabe_menu(
                1,
                5,
                sonder_tasten=()
            )

            if tempo_auswahl == 1:
                einstellungen['textgeschwindigkeit'] = "sofort"

            elif tempo_auswahl == 2:
                einstellungen['textgeschwindigkeit'] = "schnell"

            elif tempo_auswahl == 3:
                einstellungen['textgeschwindigkeit'] = "normal"

            elif tempo_auswahl == 4:
                einstellungen['textgeschwindigkeit'] = "langsam"

            elif tempo_auswahl == 5:
                continue

            einstellungen_speichern(
                einstellungen
            )

            print()
            print(
                f"Textgeschwindigkeit wurde auf "
                f"{einstellungen['textgeschwindigkeit'].capitalize()} gesetzt."
            )

            print()
            text_ausgeben(
                "Der Wind bewegt leise die Blätter über dir.",
                art="atmosphaere"
            )

            warte_auf_taste()

        # -------------------------
        # MENÜ-EINGABE
        # -------------------------

        elif optionen_auswahl == 2:
            ort_titel("Menü-Eingabe")

            print("1. Mit Enter bestätigen")
            print("2. Direkte Tasteneingabe")
            print("3. Zurück")

            eingabe_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            if eingabe_auswahl == 1:
                einstellungen["menue_eingabe"] = "enter"

                einstellungen_speichern(
                    einstellungen
                )

                print()
                print("Menüs werden jetzt mit Enter bestätigt.")

                warte_auf_taste()

            elif eingabe_auswahl == 2:
                einstellungen["menue_eingabe"] = "direkt"

                einstellungen_speichern(
                    einstellungen
                )

                print()
                print("Menüs reagieren jetzt direkt auf Tastendruck.")

                warte_auf_taste()

            elif eingabe_auswahl == 3:
                continue

        elif optionen_auswahl == 3:
            ort_titel("Bildschirm leeren")

            print("1. An")
            print("2. Aus")
            print("3. Zurück")

            bildschirm_auswahl = eingabe_menu(
                1,
                3,
                sonder_tasten=()
            )

            if bildschirm_auswahl == 1:
                einstellungen["bildschirm_leeren"] = True

                einstellungen_speichern(
                    einstellungen
                )

                print()
                print("Neue Ansichten löschen jetzt den vorherigen Bildschirm.")

                warte_auf_taste()

            elif bildschirm_auswahl == 2:
                einstellungen["bildschirm_leeren"] = False

                einstellungen_speichern(
                    einstellungen
                )

                print()
                print("Das Spiel läuft jetzt fortlaufend nach unten weiter.")

                warte_auf_taste()

            elif bildschirm_auswahl == 3:
                continue

        elif optionen_auswahl == 4:
            ort_titel("Spielername-Farbe")

            print("1. Standard")
            print("2. Blau")
            print("3. Cyan")
            print("4. Grün")
            print("5. Gelb")
            print("6. Lila")
            print("7. Rot")
            print("8. Zurück")

            farbe_auswahl = eingabe_menu(
                1,
                9,
                sonder_tasten=()
            )

            if farbe_auswahl == 8:
                continue

            farben = {
                1: "standard",
                2: "blau",
                3: "cyan",
                4: "gruen",
                5: "gelb",
                6: "lila",
                7: "rot",
                9: "schwarz"
            }

            einstellungen[
                "spieler_name_farbe"
            ] = farben[farbe_auswahl]

            einstellungen_speichern(
                einstellungen
            )

            print()
            print(
                "Die Spielername-Farbe wurde geändert."
            )

            warte_auf_taste()

        elif optionen_auswahl == 5:
            return

def spiel_intro():
    ort_titel("Void")

    text_ausgeben(
        "Manche Orte werden durch Mauern und Tore "
        "zusammengehalten."
    )

    print()

    text_ausgeben(
        "Andere durch Namen, Gewohnheiten und Geschichten, "
        "die niemand mehr bewusst erzählen muss."
    )

    print()

    text_ausgeben(
        "Eichenruh gehört zu den letzteren."
    )

    print()

    text_ausgeben(
        "Hier weiß man, welches Dach bei starkem Regen tropft, "
        "wer morgens zuerst den Ofen anheizt und welcher Weg "
        "nach einem Gewitter voller Schlamm steht."
    )

    print()

    text_ausgeben(
        "Man grüßt dieselben Gesichter, hört dieselben alten "
        "Geschichten und streitet über Gerüchte, deren Anfang "
        "längst niemand mehr kennt."
    )

    print()

    text_ausgeben(
        "Niemand nennt das Erinnerung."
    )

    text_ausgeben(
        "Es ist einfach das Leben hier."
    )

    print()

    text_ausgeben(
        "Und solange etwas selbstverständlich ist, "
        "fragt kaum jemand, was davon bleibt, "
        "wenn es eines Tages fehlt."
    )

    warte_auf_taste(
        "Weiter"
    )

    ort_titel("Prolog")

    design_text(
        "EICHENRUH",
        design="wichtig",
        art="ereignis"
    )

    print()

    warte_auf_taste(
        "Beginnen"
    )

