def speicherplatz_auswahl_laden():
    while True:
        ort_titel(
            "Spiel laden"
        )

        for slot in range(
            1,
            ANZAHL_SPEICHER_SLOTS + 1
        ):
            print(
                speicherplatz_text(
                    slot
                )
            )

        zurueck_option = (
            ANZAHL_SPEICHER_SLOTS + 1
        )

        print(
            f"{zurueck_option}. Zurück"
        )

        auswahl = eingabe_menu(
            1,
            zurueck_option,
            sonder_tasten=()
        )

        if auswahl == zurueck_option:
            return None

        if not os.path.exists(
            speicherdatei_pfad(
                auswahl
            )
        ):
            print()
            print(
                "Dieser Speicherplatz ist leer."
            )

            warte_auf_taste(
                "Zurück"
            )

            continue

        return auswahl

def speicherplatz_auswahl_neues_spiel():
    while True:
        ort_titel(
            "Neues Spiel - Speicherplatz"
        )

        for slot in range(
            1,
            ANZAHL_SPEICHER_SLOTS + 1
        ):
            print(
                speicherplatz_text(
                    slot
                )
            )

        zurueck_option = (
            ANZAHL_SPEICHER_SLOTS + 1
        )

        print(
            f"{zurueck_option}. Zurück"
        )

        auswahl = eingabe_menu(
            1,
            zurueck_option,
            sonder_tasten=()
        )

        if auswahl == zurueck_option:
            return None

        speicher_datei = (
            speicherdatei_pfad(
                auswahl
            )
        )

        if not os.path.exists(
            speicher_datei
        ):
            return auswahl

        print()

        design_text(
            "SPIELSTAND VORHANDEN",
            design="warnung",
            art="menue"
        )

        print()
        print(
            "Dieser Speicherplatz enthält "
            "bereits einen Spielstand."
        )

        print()
        print(