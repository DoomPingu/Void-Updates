                    print()
                    text_ausgeben(
                        "Die Spur stammt vermutlich von jemandem, "
                        "der zwischen Wald und Köhlerei unterwegs war."
                    )

                    text_ausgeben(
                        "Nach einigen Metern verlierst du sie "
                        "zwischen trockenem Laub."
                    )

            elif spuren_auswahl == 2:
                print()
                text_ausgeben(
                    "Du lässt die Spuren hinter dir und bleibst "
                    "auf dem bekannten Waldweg."
                )
    
    return gold, heiltränke, diamanten, lebenspunkte, spiel_laeuft, besiegte_gegner, ort
    

if spieler.get("prolog_skip_startwaffe"):
    startwaffe_waehlen()

